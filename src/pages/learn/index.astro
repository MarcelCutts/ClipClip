---
/**
 * Optional learning, with the original experiments and their evidence together. Practical
 * instructions live on Playing; stable learning anchors remain here for shared references.
 */
import Contents, { type ContentsEntry } from '../../components/Contents.astro';
import Myths from '../../components/Myths.astro';
import PageHeader from '../../components/PageHeader.astro';
import Part from '../../components/Part.astro';
import Tabs from '../../components/Tabs.astro';
import Term from '../../components/Term.astro';
import BlendLab from '../../islands/BlendLab.svelte';
import HearIt from '../../islands/HearIt.svelte';
import MeterCheck from '../../islands/MeterCheck.svelte';
import SignalPath from '../../islands/SignalPath.svelte';
import TwoCeilings from '../../islands/TwoCeilings.svelte';
import Base from '../../layouts/Base.astro';
import { formatDb } from '../../lib/dsp/db';
import { GLOSSARY } from '../../lib/glossary';
import { HOWLER_BELOW_RED_DB, MIXER_CEILING_DB, TARGET } from '../../lib/model';
import { MYTHS } from '../../lib/myths';
import { LEARNING, LEARNING_TABS, section } from '../../lib/sections';
import { SOURCES } from '../../lib/sources';
import { href } from '../../lib/url';
import { litCount } from '../../lib/xdj';

const XDJ_MANUAL =
  'https://downloads.support.alphatheta.com/manuals/all-in-one-dj-systems/XDJ-RX2/XDJ-RX2_DRI1479A_manual.pdf';
const XDJ_QUICK_START =
  'https://downloads.support.alphatheta.com/manuals/all-in-one-dj-systems/XDJ-RX2/XDJ-RX2_DRH1447A_quickstart_manual.pdf';
// An official reply from Pioneer DJ's support team. The thread is about the unit's own USB
// recorder; the sentence quoted from it, on how two tracks sum, holds for any output.
const PIONEER_COMMUNITY_LEVELS =
  'https://community.pioneerdj.com/hc/en-us/community/posts/22976408344345-XDJ-RX2-Recording-levels';
const VIRTUALDJ_LAYOUT = 'https://virtualdj.com/manuals/hardware/pioneer/xdjrx2/layout/mixer.html';
const XDJ_RX3_MANUAL =
  'https://downloads.support.alphatheta.com/manuals/all-in-one-dj-systems/XDJ-RX3/XDJ-RX3_DRI1702C_manual.pdf';
// AlphaTheta's XDJ-RX2 help article on the unit's own USB recorder, which MASTER LEVEL does not set.
const XDJ_USB_RECORDING = 'https://support.alphatheta.com/en-US/articles/4408616649497';

/** A section's heading: its number and title, from the one list. */
const h = (id: string) => `${section(id).number} ${section(id).title}`;

// How far below the mixer's red we assume the Howler overloads (model.ts), in dB and in lights on
// the meter, so the sentence that states it follows the model.
const howlerMargin = formatDb(HOWLER_BELOW_RED_DB, { signed: false });
const howlerLightCount = litCount(MIXER_CEILING_DB) - litCount(MIXER_CEILING_DB - HOWLER_BELOW_RED_DB);
const howlerLights = `${['no', 'one', 'two', 'three', 'four'][howlerLightCount] ?? howlerLightCount} light${howlerLightCount === 1 ? '' : 's'}`;
// Where a loud track should peak in the file (model.ts), as the scale prints it: "−12".
const normalPeak = formatDb(TARGET.normal, { unit: '' });

const contents: ContentsEntry[] = [
  ...LEARNING.map((p) => ({
    id: p.id,
    number: Number(p.number),
    label: p.title,
    ...(p.minutes ? { minutes: p.minutes } : {}),
    subs: p.sections.map((s) => ({ id: s.id, label: `${s.number} ${s.short ?? s.title}` })),
  })),
  {
    id: 'reference',
    label: 'Words and sources',
    subs: [
      { id: 'glossary', label: 'Words' },
      { id: 'sources', label: 'Sources' },
    ],
  },
];
---

<Base
  title="Learn why and practise"
  description="Optional listening exercises, blend practice and the evidence behind keeping DJ set recordings clean."
>
  <PageHeader title="Learn why and practise" lede="Hear clipping, try a blend and see why turning a recording down cannot repair the mixer’s crunch.">
    <p>For the controls to use during a set, go to <a href={href('/')}>Playing</a>. These exercises are optional. Their conclusions are also written out.</p>
  </PageHeader>
  <Tabs label="Parts" tabs={LEARNING_TABS} rail data-tabs />

  <div class="guide flow">
    <Contents entries={contents} rows={contents.length + 1} />

    <Part id="why" number={1} title="Why it matters">
      <p>
        The <Term of="howler">Howler</Term> records exactly what the mixer sends it. When a sound goes into the red, the
        mixer can slice the tops of its waves flat. That is <Term of="clipping" then=",">clipping</Term> and it sounds
        like a harsh crunch. If you turn the recording down, the crunch gets quieter. It does not go away.
      </p>
      <p>
        On the night, big speakers, a loud room and tired ears often cover the crunch. On headphones the next day, none
        of that covers it. Late in the night, trust the meters over your ears.
      </p>

      <h3 id="hear">{h('hear')}</h3>
      <p>If you can, use headphones.</p>
      <div class="wide lab"><HearIt client:visible /></div>
    </Part>

    <Part id="practice" number={2} title="Practise a blend">
      <p>Start with <a href={href('/#trim')}>Set TRIM</a> and <a href={href('/#blends')}>the blend fix</a>. Then try the controls below.</p>
      <h3 id="blends">{h('blends')}</h3>
      <p>
        Two tracks that each peak on orange can reach red together. When both peak at the same moment, the peaks add.
        Two equal peaks that land together can reach twice the height: up to 6&nbsp;dB more, two lights up the meter.
        Peaks land together within seconds of a blend starting, whether the kicks line up or not. We tested 10 released
        tracks, blended in pairs for a minute: most blends peaked 4 to 5.5 dB above the louder track. Pioneer’s support
        team says audio “will either sum or cancel out, depending on the phasing” (<a
          href={PIONEER_COMMUNITY_LEVELS}
          rel="external">Pioneer DJ Community</a
        >). Plan for all 6&nbsp;dB.
      </p>
      <p>
        A track that peaks on the first orange light leaves headroom for the two lights a blend adds. Two such tracks
        read up to 6 on the MASTER meters, and the top orange, 9, stays dark.
      </p>
      <div class="wide lab"><BlendLab client:visible /></div>

      <h3 id="check">{h('check')}</h3>
      <MeterCheck client:visible />

      <h3 id="myths">{h('myths')}</h3>
      <Myths myths={MYTHS} />
    </Part>

    <Part
      id="rig"
      number={3}
      title="The rig and the recording"
      objective="The sound can clip in the mixer or at the Howler’s input. The DJ fixes the first. The crew fix the second."
    >
      <h3 id="signal">{h('signal')}</h3>
      <p>
        The mix leaves the <span class="nobr">XDJ-RX2</span> three ways: MASTER 1 to the <Term
          of="driveRack"
          then=",">DriveRack PA2</Term
        > the amps and the speakers; MASTER 2 to the Howler; and BOOTH to the booth monitors.
      </p>
      <div class="wide lab"><SignalPath client:visible /></div>
      <p>
        MASTER LEVEL stays as soundcheck left it. It sets MASTER 1 and MASTER 2 together: if you turn it, the room’s volume and
        the recording level both change.
      </p>

      <h3 id="two-ceilings">{h('two-ceilings')}</h3>
      <p>
        The sound can be cut flat in two places on its way to the file: inside the mixer, and at the Howler’s input.
        Each is a <Term of="ceiling" then=".">ceiling</Term> Each has a control before it, and a light that watches it
        and nothing else.
      </p>
      <p>The lab follows the sound through both. It plays sound.</p>
      <div class="wide lab"><TwoCeilings client:visible /></div>
      <table class="cases" id="record-level">
        <caption>Three recordings, what the Howler’s light showed, and what fixes each</caption>
        <thead>
          <tr>
            <th scope="col">What you hear</th>
            <th scope="col">Where it clipped</th>
            <th scope="col">Howler’s LEVEL light</th>
            <th scope="col">What fixes it</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Crunch in the room and the recording</td>
            <td>In the mixer: a channel or the mix in the red</td>
            <td>Green or red. It cannot show this crunch.</td>
            <td>Only the DJ’s TRIM, EQ and faders</td>
          </tr>
          <tr>
            <td>A clean room, a crunchy recording</td>
            <td>At the Howler’s input</td>
            <td>Red</td>
            <td>
              A lower recording level, set by the crew (<a href={href('/night/#fix-howler-red')}>F1</a>)
            </td>
          </tr>
          <tr>
            <td>Clean in both</td>
            <td>Nowhere</td>
            <td>Green</td>
            <td>Nothing. Turn the file up afterwards.</td>
          </tr>
        </tbody>
      </table>
    </Part>

    <Part id="hood" number={4} title="How it works">
      <h3 id="worse">{h('worse')}</h3>
      <ul class="reasons">
        <li>
          Hearing changes with volume. The louder the sound, the closer bass comes to the mids. At home volume, bass
          fades much faster than everything else. The crunch sits higher up, where hearing stays sharp.
        </li>
        <li>Loud bass hides the sounds just above it, including some of its own distortion. Quiet bass hides much less.</li>
        <li>
          Big speakers at full volume add distortion of their own, far more than a mixer below its red, most of all in the
          sub-bass. We think that helps cover the mixer’s crunch in the room.
        </li>
        <li>Phones and laptops lose the deep bass but keep its crunch.</li>
      </ul>
      <p>
        The first two points come from hearing tests with pure tones. How they add up in a club is our reasoning: we
        found no study that compares clipping heard in a club with the same clipping on a recording.
      </p>

      <h3 id="undo">{h('undo')}</h3>
      <p>
        A repair would need to know how far above the ceiling each peak would have gone. Clipping throws that away. A
        peak that would have gone a little over and one that would have gone three times over are stored as the same flat
        line.
      </p>
      <p>
        Repair tools redraw the missing tops by guessing from the wave on either side. They can make brief clipping sound
        much better. The guess gets worse on long runs of flat tops, dense club mixes, and audio processed after it
        clipped. It is still a guess.
      </p>

      <h3 id="quiet">{h('quiet')}</h3>
      <p>
        Each extra bit in a file doubles the range of values it can hold: 6&nbsp;dB per bit. The Howler’s <Term
          of="bitDepth">24 bits</Term
        > span about 144&nbsp;dB, more than any real electronics can deliver. The hiss in a DJ recording comes from the
        gear and the tracks. Pioneer gives the <span class="nobr">XDJ-RX2</span> a signal-to-noise ratio of 112&nbsp;dB
        playing from USB (<a href={`${XDJ_QUICK_START}#page=20`} rel="external">Quick Start Guide, p.&nbsp;20</a>).
        Howler publishes no noise figure.
      </p>
      <p>
        A recording that peaks around {normalPeak}&nbsp;<Term of="dbfs">dBFS</Term> leaves 2 of its 24 bits unused. If
        it is turned up afterwards, its hiss comes up with it. Unless the Howler is unusually noisy, that hiss stays far
        below the music.
      </p>
      <p>
        To copy, check and normalise the files, follow <a href={href('/recordings/')}>Recordings</a>. A file that touches the very top can clip again when it is made into an MP3.
      </p>

      <h3 id="red-top">{h('red-top')}</h3>
      <p>Where Pioneer or Howler publish nothing, the demos follow what we assume.</p>
      <dl class="facts">
        <div>
          <dt>Red on the meters</dt>
          <dd>
            <span class="who">Pioneer:</span> turn TRIM until the orange light shows at a track’s loudest, and keep red
            dark, “or the sound may be distorted” (<a href={`${XDJ_MANUAL}#page=31`} rel="external">p.&nbsp;31</a>).
          </dd>
          <dd><span class="who">We assume:</span> red is the top.</dd>
        </div>
        <div>
          <dt>CLIP</dt>
          <dd>
            <span class="who">Pioneer:</span> blinking slowly, the sound is “about to be distorted”; blinking fast, it
            “is distorted” (<a href={`${XDJ_MANUAL}#page=27`} rel="external">p.&nbsp;27</a>).
          </dd>
          <dd><span class="who">We assume:</span> any blinking is too late for the recording.</dd>
        </div>
        <div>
          <dt>Channel meters, the EQ and the fader</dt>
          <dd>
            <span class="who">Pioneer:</span> does not say whether a channel meter reads before or after the EQ or the
            fader.
          </dd>
          <dd>
            <span class="who">VirtualDJ:</span> its manual for the unit says they show “the pre-fader signal” (<a
              href={VIRTUALDJ_LAYOUT}
              rel="external">mixer layout</a
            >).
          </dd>
          <dd>
            <span class="who">Pioneer, for the XDJ-RX3:</span> the channel meters show the level “before the sound
            passes through the channel fader” (<a href={`${XDJ_RX3_MANUAL}#page=86`} rel="external"
              >XDJ-RX3 manual, p.&nbsp;86</a
            >). That is the model that followed this one.
          </dd>
          <dd>
            <span class="who">We assume:</span> after the EQ and before the fader. An EQ boost shows on the meter, and
            moving the fader does not. The drawing in {section('signal').number} shows it that way.
          </dd>
          <dd>
            <span class="who">Check it yourself:</span> if a channel meter stays put when you pull its fader down, it
            reads before the fader. If it rises when you turn up LOW, it reads after the EQ.
          </dd>
        </div>
        <div>
          <dt>MASTER meters</dt>
          <dd>
            <span class="who">Pioneer:</span> has you set MASTER LEVEL by them (<a href={`${XDJ_MANUAL}#page=31`} rel="external"
              >p.&nbsp;31</a
            >), and does not say whether they read before or after MASTER ATT.
          </dd>
          <dd>
            <span class="who">We assume:</span> after MASTER LEVEL. Before or after MASTER ATT, nothing: no checklist
            or drill changes MASTER ATT.
          </dd>
        </div>
        <div>
          <dt>Headroom above red</dt>
          <dd><span class="who">Pioneer:</span> no figure published.</dd>
          <dd>
            <span class="who">We assume:</span> none you can use. A blend can add 6&nbsp;dB and an EQ boost another
            6&nbsp;dB. Either can use up any margin in one bar.
          </dd>
        </div>
        <div>
          <dt>A limiter in the mixer</dt>
          <dd>
            <span class="who">Pioneer:</span> none listed. Its settings have attenuators for MASTER and BOOTH, and no
            limiter (<a href={`${XDJ_MANUAL}#page=32`} rel="external">p.&nbsp;32</a>).
          </dd>
          <dd>
            <span class="who">We assume:</span> nothing stops a mix that is too loud before it reaches the recording.
          </dd>
        </div>
        <div>
          <dt>MASTER LEVEL and a channel in the red</dt>
          <dd>
            <span class="who">Pioneer:</span> MASTER LEVEL sets the sound out of MASTER 1 and MASTER 2 (<a
              href={`${XDJ_MANUAL}#page=27`}
              rel="external">p.&nbsp;27</a
            >), after the channels are mixed. For distorted sound, it lists TRIM for a channel and MASTER LEVEL for the
            mix (<a href={`${XDJ_MANUAL}#page=34`} rel="external">p.&nbsp;34</a>). It does not say where inside the
            mixer the sound is cut. For the unit’s own USB recorder, which MASTER LEVEL does not set, AlphaTheta says
            that a channel lit red means “the input level is too high and the sound may be distorted” (<a
              href={XDJ_USB_RECORDING}
              rel="external">help article</a
            >). This rig does not use that recorder.
          </dd>
          <dd>
            <span class="who">We assume:</span> a channel in the red is cut before MASTER LEVEL. Turned down, that
            crunch gets quieter and stays in. The lab in {section('two-ceilings').number} rests on this.
          </dd>
        </div>
        <div>
          <dt>MASTER ATT</dt>
          <dd>
            <span class="who">Pioneer:</span> it “sets the master output attenuator” (<a
              href={`${XDJ_MANUAL}#page=32`}
              rel="external">p.&nbsp;32</a
            >), and does not say whether that includes MASTER 1, which feeds the PA, or MASTER 2, which feeds the Howler.
            The XDJ-RX3’s manual says its own acts on both (<a href={`${XDJ_RX3_MANUAL}#page=115`} rel="external"
              >XDJ-RX3 manual, p.&nbsp;115</a
            >).
          </dd>
          <dd>
            <span class="who">We assume:</span> nothing. The recording comes down at MASTER LEVEL (<a
              href={href('/night/#fix-howler-red')}>F1</a
            >), which Pioneer says sets both.
          </dd>
        </div>
        <div>
          <dt>The Howler’s input</dt>
          <dd>
            <span class="who">Howler:</span> says the mixer distorts first (<a
              href="https://howler-audio.com/pages/faq"
              rel="external">FAQ</a
            >), and publishes no maximum input level. It recommends a REC OUT, which the
            <span class="nobr">XDJ-RX2</span> does not have.
          </dd>
          <dd>
            <span class="who">We assume:</span> it overloads about {howlerMargin} ({howlerLights}) below the mixer’s red
            with the recording level fully up, the worse case. Its LEVEL light is the check.
          </dd>
          <dd>
            <span class="who">On this rig:</span> nobody has seen the LEVEL light blink red with the MASTER meters
            below red.
          </dd>
        </div>
        <div>
          <dt>The Howler’s LEVEL light</dt>
          <dd>
            <span class="who">Howler:</span> it “is correctly recording when the RECORD button is blinking constantly,
            and the LEVEL indicator is blinking green”. Blinking red “means your volume is too high” (<a
              href="https://howler-audio.com/pages/manual-mk1"
              rel="external">manual, 2.2 and 4</a
            >). It gives no level for either colour, and says nothing of sound cut before it arrives.
          </dd>
          <dd>
            <span class="who">We assume:</span> the light goes by the level at its input and nothing else. Crunch made
            in the mixer, then turned down, lights it green. The lab in {section('two-ceilings').number} shows it.
          </dd>
        </div>
      </dl>
      <p id="model">
        In the demos, clean and clipped versions play at the same measured loudness. The louder one nearly always sounds better at
        first. The waveforms are zoomed in to a few hundredths of a second.
      </p>
    </Part>

    <Part id="reference" title="Words and sources">
      <h3 id="glossary">Words</h3>
      <dl class="glossary">
        {Object.entries(GLOSSARY).map(([key, g]) => (
  <div id={`word-${key}`}>
    <dt>{g.term}</dt>
    <dd>{g.gloss}</dd>
  </div>
))}
      </dl>

      <h3 id="sources">Sources</h3>
      <p>Checked in September 2026.</p>
      <div class="source-groups">
        {SOURCES.map((group) => (
  <details class="source-group">
    <summary>{group.title}</summary>
    <ul class="sources">
      {group.sources.map((s) => (
        <li>
          <a href={s.url} rel="external">
            {s.title}
          </a>
          <span class="publisher">{s.publisher}</span>
          {s.note && <span class="note-text">{s.note}</span>}
        </li>
      ))}
    </ul>
  </details>
))}
      </div>
    </Part>
  </div>
</Base>

<style>
  /* The parts set their own distance, the section gap. The index follows the opening on phones;
     on wide screens it moves into the rail, and the first part starts level with it. */
  .guide {
    row-gap: 0;
  }

  @media (min-width: 80rem) {
    .guide > :global(.part:first-of-type) {
      margin-block-start: 0;
    }
  }

  .lab {
    margin-block: 0.5rem;
  }

  /* Reasons, not steps: a plain list. */
  .reasons {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.4rem;
  }

  .cases {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  /* On the narrowest phones, with wider letter spacing, a long word may break rather than push the
     table off the side of the screen. */
  .cases :is(th, td) {
    overflow-wrap: anywhere;
  }

  .cases caption {
    padding-block-end: 0.5rem;
    font-weight: 700;
    text-align: left;
  }

  .cases th {
    padding: 0.45rem 0.6rem;
    border-top: 2px solid var(--strip-edge);
    background: var(--strip);
    color: var(--on-strip);
    font-weight: 700;
    text-align: left;
    vertical-align: bottom;
  }

  .cases td {
    padding: 0.55rem 0.6rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  /* Published beside assumed: each row the thing, what the maker says, what we assume. */
  .facts {
    display: grid;
    margin: 0.25rem 0 0;
    border-top: 2px solid var(--ink);
  }

  .facts > div {
    display: grid;
    gap: 0.3rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    font-weight: 700;
    color: var(--ink-bright);
  }

  .facts dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .who {
    font-weight: 700;
  }

  @media (min-width: 40rem) {
    .facts > div {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      column-gap: 1.25rem;
      align-content: start;
    }

    /* The label runs beside both lines, so a two-line label doesn't push "We assume" down. */
    .facts dt {
      grid-row: span 2;
    }

    .facts dd {
      grid-column: 2;
    }
  }

  .glossary {
    display: grid;
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .glossary > div {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 40rem) {
    .glossary > div {
      grid-template-columns: 11rem 1fr;
      gap: 1rem;
    }
  }

  .glossary dt {
    font-weight: 700;
  }

  .glossary dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* The sources, a group to a fold, closed until you open one. */
  .source-groups {
    border-top: 2px solid var(--ink);
  }

  .source-group {
    border-bottom: 1px solid var(--rule);
  }

  .source-group summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink-bright);
    cursor: pointer;
    list-style: none;
  }

  .source-group summary::-webkit-details-marker {
    display: none;
  }

  /* A chevron that turns when open, as in the labs, so the fold reads as a control. */
  .source-group summary::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: -45deg;
  }

  .source-group[open] summary::before {
    rotate: 45deg;
    translate: 0 -0.15rem;
  }

  .source-group summary:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .sources {
    display: grid;
    gap: 0.7rem;
    list-style: none;
    padding: 0 0 1rem;
    margin: 0;
  }

  .sources li {
    display: grid;
    gap: 0.1rem;
  }

  .publisher,
  .note-text {
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

</style>
