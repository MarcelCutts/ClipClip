---
/**
 * The crew's tool for the night itself, set like a quick reference handbook. It opens on its tabs, in
 * the order the night runs: C1 Doors, C2 Changeover, F Something's wrong, C3 After. Then what the crew
 * know by heart, and the checklists and drills in that order. Every card is linkable from the group
 * chat (/night/#changeover, /night/#fix-howler-red). Why any of it works is in the guide. On wide
 * screens an index rail sits left of the cards, as on the setup page, listing every drill under F.
 */
import Contents, { type ContentsEntry } from '../../components/Contents.astro';
import DrillCard from '../../components/DrillCard.astro';
import KnowByHeart from '../../components/KnowByHeart.astro';
import Tabs, { type Tab } from '../../components/Tabs.astro';
import Term from '../../components/Term.astro';
import Checklist from '../../islands/Checklist.svelte';
import Base from '../../layouts/Base.astro';
import { CHECKLISTS } from '../../lib/checklists';
import { drillAnchor, FIXES } from '../../lib/fixes';
import { CHANGEOVER_LINE } from '../../lib/messages';
import { CREW_RULES } from '../../lib/rules';
import { href } from '../../lib/url';

const { doors, changeover, after } = CHECKLISTS;
// Trouble comes during the sets, so the drills sit between the changeovers and the end of the night.
const tabs: Tab[] = [
  { code: doors.code, label: 'Doors', href: `#${doors.anchor}`, target: doors.anchor },
  { code: changeover.code, label: 'Changeover', href: `#${changeover.anchor}`, target: changeover.anchor },
  { code: 'F', label: 'Something’s wrong', href: '#fixes', target: 'fixes', lamp: true },
  { code: after.code, label: 'After', href: `#${after.anchor}`, target: after.anchor },
];
const groups = [
  { id: 'booth', title: 'In the booth, now', drills: FIXES.filter((f) => f.where === 'booth') },
  { id: 'recording', title: 'In the recording, afterwards', drills: FIXES.filter((f) => f.where === 'recording') },
];
// Wide screens: the index in the rail, as on the setup page. The night in order, and under F every
// drill by its code, which opens while you're in them.
const contents: ContentsEntry[] = [
  { id: doors.anchor, number: doors.code, label: doors.title },
  { id: changeover.anchor, number: changeover.code, label: changeover.title },
  {
    id: 'fixes',
    number: 'F',
    label: 'Something’s wrong',
    lamp: true,
    subs: FIXES.map((f) => ({ id: drillAnchor(f.id), label: `${f.code} ${f.short}` })),
  },
  { id: after.anchor, number: after.code, label: after.title },
];
// The rail runs beside every row of the page's grid: the box, C1, C2 and its line, the drills, C3 and
// the two paragraphs after it.
const ROWS = 8;
---

<Base
  title="On the night"
  description="For crew on the night: the doors, changeover and after-the-night checklists, and the drills for when a light goes red or a recording sounds wrong."
>
  <header class="head flow">
    <h1>On the night</h1>
  </header>

  <!-- Thumb tabs, as on the edge of a printed handbook: they stay at the top of the screen, and the one
       for the part of the night on screen is filled (the script below). Plain links without JavaScript. -->
  <Tabs label="Checklists and drills" tabs={tabs} data-night-tabs />

  <div class="night flow">
    <Contents entries={contents} rows={ROWS} />

    <div class="block"><KnowByHeart title="Know by heart on crew" rules={CREW_RULES} /></div>

    <div class="block stage"><Checklist list="doors" headingLevel={2} client:visible /></div>

    <div class="block stage"><Checklist list="changeover" headingLevel={2} client:visible /></div>
    <p class="say">Say it to the next DJ: <strong>“{CHANGEOVER_LINE}”</strong></p>

    <section class="drills stage" id="fixes">
      <!-- Named "F: Something’s wrong", code first, as the tab is. The code is said in the hidden text, so
           no space creeps in before the colon. -->
      <h2 class="drills-title">
        <span class="mark" aria-hidden="true"><span class="lamp"></span>F</span><span class="visually-hidden"
          >F: </span
        >Something’s wrong
      </h2>
      <p>Find what you see or hear, then work through its drill from step 1.</p>
      <nav class="index" aria-label="Drills">
        {groups.map((g) => (
  <div class="index-group">
    <p class="index-title" id={`index-${g.id}`}>{g.title}</p>
    <ol aria-labelledby={`index-${g.id}`}>
      {g.drills.map((f) => (
      <li>
        <a href={`#${drillAnchor(f.id)}`}><span class="index-code">{f.code}</span> <span class="index-label">{f.title}</span></a>
      </li>
    ))}
    </ol>
  </div>
))}
      </nav>
      {groups.map((g) => (
  <Fragment>
    <h3 class="group-title">{g.title}</h3>
    {g.drills.map((f) => <DrillCard fix={f} level={4} />)}
  </Fragment>
))}
    </section>

    <div class="block stage"><Checklist list="after" headingLevel={2} client:visible /></div>
    <p class="note">
      <strong>Note.</strong> A set that peaked around −12&nbsp;<Term of="dbfs">dBFS</Term> is healthy. <Term
        of="normalise">Normalising</Term
      > it costs nothing you’ll hear.
    </p>

    <p class="more">
      If it’s your first night with this rig, or something has changed, start with <a href={href('/setup/')}
        >Setting up</a
      >. Cards and tape tags for the booth are in the <a href={href('/print/')}>Print kit</a>.
    </p>
  </div>
</Base>

<script>
  // Fills the tab for the part of the night on screen: the last one whose top has passed a line just
  // under the tabs.
  const nav = document.querySelector<HTMLElement>('[data-night-tabs]');
  if (nav) {
    const tabs = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-target]')];
    const targets = tabs.map((tab) => document.getElementById(tab.dataset.target ?? ''));
    let queued = false;

    const update = () => {
      queued = false;
      const line = nav.getBoundingClientRect().bottom + window.innerHeight * 0.15;
      let at = -1;
      targets.forEach((target, i) => {
        if (target && target.getBoundingClientRect().top <= line) at = i;
      });
      tabs.forEach((tab, i) => {
        if (i === at) tab.setAttribute('aria-current', 'location');
        else tab.removeAttribute('aria-current');
      });
    };

    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
    update();
  }
</script>

<style>
  /* A tool page's name: enough to know where you are, and out of the way of the tabs. */
  .head {
    padding-block: clamp(1.25rem, 0.9rem + 1.5vw, 2.25rem) 0.9rem;
  }

  h1 {
    font-size: clamp(1.75rem, 1.45rem + 1.4vw, 2.5rem);
    line-height: 1.1;
  }

  /* On the night a jump is instant: nobody in a hurry should watch the page glide past. Where it
     lands is the page's scroll padding, clear of the tabs. */
  :global(html) {
    scroll-behavior: auto;
  }

  .night {
    row-gap: 1.25rem;
    padding-block-start: 1rem;
  }

  /* A little more air between the night's stages than inside them. */
  .stage {
    margin-block-start: 1.25rem;
  }

  .say {
    font-size: var(--text-rule);
    line-height: 1.4;
  }

  .drills {
    display: grid;
    gap: 1.25rem;
  }

  .drills-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* The F tab's code and lamp, in an ink outline like the tab, so the heading matches the tab that
     brought you here. Red is only the lamp: it means something's wrong, not "click here". */
  .mark {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: 2.25rem;
    height: 2.25rem;
    padding-inline: 0.5rem;
    border: 1.5px solid var(--ink);
    font-size: var(--text-rule);
    line-height: 1;
  }

  .lamp {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--warning);
  }

  .index {
    display: grid;
    gap: 1rem;
  }

  .index-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink-2);
  }

  .index ol {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .index li {
    border-top: 1px solid var(--rule);
  }

  .index a {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: baseline;
    min-height: 2.75rem;
    padding-block: 0.55rem;
    line-height: 1.35;
    color: var(--ink);
    text-decoration: none;
  }

  .index-code {
    font-weight: 700;
  }

  /* Each row is a link to its drill, so its title is underlined like every link on the page. */
  .index-label {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--link) 60%, transparent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .index a:hover .index-label {
    text-decoration-color: currentColor;
    text-decoration-thickness: 0.14em;
  }

  .group-title {
    margin-block-start: 1rem;
    font-size: var(--text-rule);
  }

  .note {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .note strong {
    color: var(--ink);
  }

  .more {
    margin-block-start: 1.5rem;
  }

  /* The index is for wide screens only, in the rail. Narrower, the tabs and the drills' own index
     do its job. */
  .night > :global(.toc) {
    display: none;
  }

  /* Wide screens: the rail starts level with the know-by-heart box, and stays in view under the tabs. */
  @media (min-width: 80rem) {
    .night > :global(.toc) {
      display: grid;
      margin-block-start: 0;
    }
  }

  @media (forced-colors: active) {
    .mark {
      border-color: CanvasText;
    }

    .lamp {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }
</style>
