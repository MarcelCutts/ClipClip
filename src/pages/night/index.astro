---
/**
 * One event workflow: C1 Before doors, C2 Changeover, shared faults, C3 End.
 * C4 and F9 live on Recordings; their old fragments forward there. The rack travels prewired.
 *
 * C1 carries its drawings inside the card, each before the line it serves: the table, the booth, the
 * back of the rack, the back of the mixer and the front of the rack. They are drawn on the server and
 * handed to the island as slots (checklists.ts names them).
 */
import Contents, { type ContentsEntry } from '../../components/Contents.astro';
import DrillCard from '../../components/DrillCard.astro';
import BoothFigure from '../../components/figures/BoothFigure.astro';
import MixerRearFigure from '../../components/figures/MixerRearFigure.astro';
import RackFrontFigure from '../../components/figures/RackFrontFigure.astro';
import RackRearFigure from '../../components/figures/RackRearFigure.astro';
import TableFigure from '../../components/figures/TableFigure.astro';
import KnowByHeart from '../../components/KnowByHeart.astro';
import LegacyAnchors from '../../components/LegacyAnchors.astro';
import Tabs, { type Tab } from '../../components/Tabs.astro';
import Checklist from '../../islands/Checklist.svelte';
import Base from '../../layouts/Base.astro';
import { CHECKLISTS } from '../../lib/checklists';
import { drillAnchor, FIXES } from '../../lib/fixes';
import { CREW_RULES } from '../../lib/rules';
import { href } from '../../lib/url';

const { doors, changeover, after } = CHECKLISTS;
const tabs: Tab[] = [
  { code: doors.code, label: 'Before doors', href: `#${doors.anchor}`, target: doors.anchor, title: doors.title },
  { code: changeover.code, label: 'Changeover', href: `#${changeover.anchor}`, target: changeover.anchor },
  { code: 'F', label: 'Faults', title: 'Something’s wrong', href: '#fixes', target: 'fixes', lamp: true },
  { code: after.code, label: 'End', href: `#${after.anchor}`, target: after.anchor, title: after.title },
];
/** The booth's drills. The next day's, found by listening, are with the recordings. */
const booth = FIXES.filter((f) => f.where === 'booth');
/** Old links to a drill that moved to Recordings, or to its steps, and to the hum drill, which was retired. */
const moved = Object.fromEntries([
  ['next-day', '/recordings/#next-day'],
  ...FIXES.filter((f) => f.where === 'recording').flatMap((f) => [
    [drillAnchor(f.id), `/recordings/#${drillAnchor(f.id)}`],
    ...f.steps.map((_, i) => [drillAnchor(f.id, i + 1), `/recordings/#${drillAnchor(f.id, i + 1)}`]),
  ]),
  ['fix-hum', '/night/#fixes'],
]);
const subsOf = (drills: typeof FIXES) => drills.map((f) => ({ id: drillAnchor(f.id), label: `${f.code} ${f.short}` }));
// Wide screens: the index in the rail, as on the setup page. The night in order, each drill by its code
// under the part it's in, which opens while you're in it.
const contents: ContentsEntry[] = [
  { id: doors.anchor, number: doors.code, label: doors.title },
  { id: changeover.anchor, number: changeover.code, label: changeover.title },
  { id: 'fixes', number: 'F', label: 'Something’s wrong', lamp: true, subs: subsOf(booth) },
  { id: after.anchor, number: after.code, label: after.title },
];
// The rail spans the crew box, three checklists, faults and the recordings link.
const ROWS = 6;
---

<Base
  title="Crew on the night"
  description="Build the booth, set the levels by the meters, handle each changeover and find the right fault procedure."
>
  <header class="head flow">
    <h1>Crew on the night</h1>
    <p>Build the booth, set the levels and keep the recording running. For a problem during a set, go straight to <a href="#fixes">Something’s wrong</a>.</p>
    <p class="secondary"><a href={href('/setup/')}>Rig reference</a> · <a href={href('/recordings/')}>Recordings after the night</a><span class="offline-link"> · <a href="#offline-guide">Save offline</a></span></p>
  </header>

  <!-- Thumb tabs, as on the edge of a printed handbook: they stay at the top of the screen, and the one
       for the part of the night on screen is filled (the script below). Plain links without JavaScript. -->
  <Tabs label="Checklists and drills" tabs={tabs} data-night-tabs />

  <div class="night flow">
    <Contents entries={contents} rows={ROWS} />

    <div class="block"><KnowByHeart title="Know by heart" rules={CREW_RULES} /></div>

    <div class="block stage">
      <Checklist list="doors" headingLevel={2} client:visible>
        <TableFigure slot="table" />
        <BoothFigure slot="booth" />
        <RackRearFigure slot="rackRear" />
        <MixerRearFigure slot="mixerRear" />
        <RackFrontFigure slot="rackFront" />
      </Checklist>
    </div>

    <div class="block stage"><Checklist list="changeover" headingLevel={2} client:visible /></div>

    <section class="drills stage" id="fixes">
      <!-- Named "F: Something’s wrong", code first, as the tab is. The code is said in the hidden text, so
           no space creeps in before the colon. -->
      <h2 class="drills-title">
        <span class="mark" aria-hidden="true"><span class="lamp"></span>F</span><span class="visually-hidden"
          >F: </span
        >Something’s wrong
      </h2>
      <p>Find what you see or hear. Then do its drill from step 1.</p>
      <nav class="index" aria-label="Drills">
        <ol>
          {booth.map((f) => (
  <li>
    <a href={`#${drillAnchor(f.id)}`}><span class="index-code">{f.code}</span> <span class="index-label">{f.title}</span></a>
  </li>
))}
        </ol>
      </nav>
      {booth.map((f) => <DrillCard fix={f} level={3} />)}
    </section>

    <div class="block stage"><Checklist list="after" headingLevel={2} client:visible /></div>

    <p class="block">Next: <a href={href('/recordings/')}>copy, check and prepare the recordings</a>.</p>
    <LegacyAnchors map={moved} />
  </div>
</Base>

<script>
  // Fills the tab for the part of the night on screen: the last one whose top has passed a line just
  // under the tabs.
  const nav = document.querySelector<HTMLElement>('[data-night-tabs]');
  if (nav) {
    const tabs = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-target]')];
    const targets = tabs.map((tab) => document.getElementById(tab.dataset.target ?? ''));
    let queued = false;

    const update = () => {
      queued = false;
      const line = nav.getBoundingClientRect().bottom + window.innerHeight * 0.15;
      let at = -1;
      targets.forEach((target, i) => {
        if (target && target.getBoundingClientRect().top <= line) at = i;
      });
      tabs.forEach((tab, i) => {
        if (i === at) tab.setAttribute('aria-current', 'location');
        else tab.removeAttribute('aria-current');
      });
    };

    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
    update();
  }
</script>

<style>
  /* A tool page's name: enough to know where you are, and out of the way of the tabs. */
  .head {
    padding-block: clamp(1.25rem, 0.9rem + 1.5vw, 2.25rem) 0.9rem;
  }

  /* Which cards are current: small, under the title, never in the way of the checklists. */
  .secondary {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  @media print {
    .offline-link { display: none; }
  }

  h1 {
    font-size: clamp(1.75rem, 1.45rem + 1.4vw, 2.5rem);
    line-height: 1.1;
  }

  /* On the night a jump is instant: nobody in a hurry should watch the page glide past. Where it
     lands is the page's scroll padding, clear of the tabs. */
  :global(html) {
    scroll-behavior: auto;
  }

  .night {
    row-gap: 1.25rem;
    padding-block-start: 1rem;
  }

  /* A little more air between the night's stages than inside them. */
  .stage {
    margin-block-start: 1.25rem;
  }

  .drills {
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    display: grid;
    gap: 1.25rem;
  }

  .drills-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* The F tab's code and lamp, in an ink outline like the tab, so the heading matches the tab that
     brought you here. Red is only the lamp: it means something's wrong, not "click here". */
  .mark {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: 2.25rem;
    height: 2.25rem;
    padding-inline: 0.5rem;
    border: 1.5px solid var(--ink);
    font-size: var(--text-rule);
    line-height: 1;
  }

  .lamp {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--warning);
  }

  .index {
    display: grid;
    gap: 1rem;
  }

  .index ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .index li {
    border-top: 1px solid var(--rule);
  }

  .index a {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: baseline;
    min-height: 2.75rem;
    padding-block: 0.55rem;
    line-height: 1.35;
    color: var(--ink);
    text-decoration: none;
  }

  .index-code {
    font-weight: 700;
  }

  /* Each row is a link to its drill, so its title is underlined like every link on the page. */
  .index-label {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--link) 60%, transparent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .index a:hover .index-label {
    text-decoration-color: currentColor;
    text-decoration-thickness: 0.14em;
  }

  /* The index is for wide screens only, in the rail. Narrower, the tabs and the drills' own index
     do its job. */
  .night > :global(.toc) {
    display: none;
  }

  /* Wide screens: the rail starts level with the know-by-heart box, and stays in view under the tabs. */
  @media (min-width: 80rem) {
    .night > :global(.toc) {
      display: grid;
      margin-block-start: 0;
    }
  }

  @media (forced-colors: active) {
    .mark {
      border-color: CanvasText;
    }

    .lamp {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }
</style>
