---
import PageHeader from '../components/PageHeader.astro';
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---

<Base title="Page not found" description="There is nothing at this address.">
  <PageHeader title="Nothing here" lede="That page does not exist, or it has moved.">
    <ul class="ways">
      <li><a href={href('/')}>Playing a set: the meters and the rules</a></li>
      <li><a href={href('/night/')}>Crew on the night: the checklists and drills</a></li>
      <li><a href={href('/learn/')}>Learn why and practise</a></li>
      <li><a href={href('/setup/')}>Rig reference: wiring and settings</a></li>
    </ul>
  </PageHeader>
</Base>

<style>
  .ways {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.2rem;
    font-weight: 650;
  }
</style>
