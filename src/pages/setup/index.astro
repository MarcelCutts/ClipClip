---
/**
 * The one-off setup, for whoever sets up the rig, as a quick reference handbook's cards. S1 is the
 * whole job in order (the setup checklist). S2 to S6 go through each part: the wiring, the record
 * level, the DriveRack and amps, generator power and the USB backup. T1 to T6 are the tests that
 * answer what the manuals don't say. Done once, and again whenever the rig changes. Why it works is
 * in the guide.
 *
 * S2 is the rig as a table, built from the guide's signal drawing (lib/rig.ts): what feeds each
 * part, how it's set and which tape goes on it. The drawing itself stays in the guide (3.1). S3 is
 * the record level's steps (lib/record/flow.ts), with a practice rig under them.
 *
 * The anchors stay put: the old /crew/ page forwards to #wiring, #record-level, #backup, #power and
 * #tests, the guide links to #record-level and #test-att, and #setup is the checklist's own.
 */
import Contents, { type ContentsEntry } from '../../components/Contents.astro';
import PageHeader from '../../components/PageHeader.astro';
import Procedure from '../../components/Procedure.astro';
import Term from '../../components/Term.astro';
import Checklist from '../../islands/Checklist.svelte';
import RecordLevel from '../../islands/RecordLevel.svelte';
import Base from '../../layouts/Base.astro';
import { CHECKLISTS, LEVEL_FALLBACK } from '../../lib/checklists';
import { ROOM_NOTE, STEPS } from '../../lib/record/flow';
import { edgesFor, NODES, type NodeId } from '../../lib/rig';
import { section } from '../../lib/sections';
import { SOURCES } from '../../lib/sources';
import { MONITOR_TAG, REC_TAG, RIG_TAG, type ShortTag } from '../../lib/tags';
import { href } from '../../lib/url';

/** A source document's address, from the one list, so the page and the sources section agree. */
const doc = (title: string): string => {
  const found = SOURCES.flatMap((g) => g.sources).find((s) => s.title === title);
  if (!found) throw new Error(`No source titled "${title}"`);
  return found.url;
};
const MANUAL = doc('XDJ-RX2 Operating Instructions');
const QUICK_START = doc('XDJ-RX2 Quick Start Guide and specifications');
const REC_FAQ = doc('XDJ-RX2 FAQ: recording with MASTER REC');
const DBX = doc('DriveRack PA2 Owner’s Manual');
const DBX_TUNINGS = doc('DriveRack PA2 speaker and amplifier tunings');
const QSC = doc('GX3, GX5 and GX7 user manual');
const HOWLER = doc('Recorder+Streamer MK1 manual');
const RANE = doc('Sound System Interconnection (RaneNote 110)');

/** A no-break space, between a number and its unit. */
const nb = '\u00a0';

// ---- S2: the rig as a table -----------------------------------------------------------------

interface Cite {
  label: string;
  url: string;
}

interface RigRow {
  /** The part, as the guide's drawing names it. */
  node: NodeId;
  /** Show the drawing's second line after the name ("QSC GX7"). */
  withSub?: boolean;
  /** How the lead is made, after the socket's name: "XLR, L and R". */
  lead?: string;
  /** A second line under the feed: what the lead should be. */
  leadNote?: string;
  /** What it's set to: the response, in the action colour. Empty for nothing to set. */
  set: string;
  /** A second line under the setting. */
  setNote?: string;
  /** The card that sets the rest: "See S4." */
  see?: { code: string; id: string; for?: string };
  /** A second line under the tape: what's written on it. */
  tapeNote?: string;
  sources: Cite[];
}

const OI = (page: number): Cite => ({ label: `XDJ manual p.${nb}${page}`, url: `${MANUAL}#page=${page}` });
const QSG = (page: number): Cite => ({ label: `XDJ quick start p.${nb}${page}`, url: `${QUICK_START}#page=${page}` });

/** The tape each taped part carries (rig.ts marks which are taped; tags.ts has what's printed on them). */
const TAPE: Partial<Record<NodeId, ShortTag>> = { masterLevel: REC_TAG, booth: MONITOR_TAG, amps: RIG_TAG };

/** Each part in signal order: the PA's branch, the recorder's, then the booth monitors'. */
const RIG_ROWS: RigRow[] = [
  {
    node: 'masterLevel',
    set: 'fully up',
    setNote: 'It sets MASTER 1 and MASTER 2 together, so it sets the room and the recording at once.',
    tapeNote: 'Write MASTER ATT and BOOTH ATT on it.',
    sources: [OI(27)],
  },
  {
    node: 'driverack',
    lead: `XLR, L and R`,
    set: `input switch on +4${nb}dBu`,
    see: { code: 'S4', id: 'driverack', for: 'the setup wizard' },
    sources: [QSG(20), { label: `dbx manual p.${nb}5`, url: `${DBX}#page=5` }],
  },
  {
    node: 'amps',
    withSub: true,
    set: 'FULL RANGE, gain for the room',
    see: { code: 'S4', id: 'driverack' },
    sources: [{ label: 'QSC GX manual', url: QSC }],
  },
  {
    node: 'howler',
    lead: 'RCA, L and R',
    leadNote: `One stereo RCA lead, under 3${nb}m, with no adapters.`,
    set: 'WAV',
    see: { code: 'S3', id: 'record-level', for: 'its record level' },
    sources: [QSG(20), { label: 'RaneNote 110', url: RANE }, { label: 'Howler manual', url: HOWLER }],
  },
  {
    node: 'booth',
    set: 'left to the DJ',
    setNote: 'It sets only the booth monitors.',
    sources: [OI(27)],
  },
  {
    node: 'monitor',
    lead: '¼″ jacks, L and R',
    leadNote: 'Balanced leads.',
    set: '',
    sources: [OI(10), QSG(20)],
  },
];

/**
 * What feeds a part, as the drawing wires it (the DJ view, where the limiter is part of the
 * DriveRack): a socket by its printed name, anything else as "the DriveRack PA2", "the mix".
 */
function feed(id: NodeId): string {
  const from = edgesFor('dj').find((e) => e.to === id)?.from;
  if (!from) throw new Error(`Nothing feeds ${id}`);
  const node = NODES[from];
  if (node.printed) return node.label;
  return node.kind === 'bus' ? `the ${node.label.toLowerCase()}` : `the ${node.label}`;
}

const rigRows = RIG_ROWS.map((r, i) => {
  const node = NODES[r.node];
  const tape = node.taped ? TAPE[r.node] : undefined;
  return {
    ...r,
    ref: String(i + 1),
    unit: node.label,
    sub: r.withSub ? node.sub : undefined,
    from: feed(r.node),
    tape,
  };
});

const signal = section('signal');

// ---- S3: the record level -------------------------------------------------------------------

const recordSteps = STEPS.map((s) => ({ challenge: s.label, response: s.target, note: s.instruction }));

// ---- T1 to T6 -------------------------------------------------------------------------------

interface Test {
  id: string;
  number: string;
  title: string;
  /** The index rail's name for it: about 20 characters. */
  short: string;
  steps: { challenge: string; response: string; note?: string }[];
  note?: string;
  /** What a good result looks like, and what to do if you don't get it. */
  expected: string;
  /** A card to go to next, named after the expected result: "(S3)". */
  see?: { code: string; id: string };
}

/** A test that moves MASTER LEVEL or MASTER ATT ends by putting them back. */
const PUT_BACK = { challenge: 'MASTER LEVEL and MASTER ATT', response: 'back as on the tape' };

// Pioneer and Howler leave these unpublished, so the only way to know is to try them on our kit.
const tests: Test[] = [
  {
    // Howler doesn't publish where its light turns red (MK1 manual, FAQ).
    id: 'test-howler',
    number: 'T1',
    title: 'Where the Howler turns red',
    short: 'Howler turns red',
    steps: [
      { challenge: 'MASTER LEVEL', response: 'fully up' },
      { challenge: 'MASTER ATT', response: `0${nb}dB` },
      { challenge: 'Loud track', response: 'playing' },
      { challenge: 'Its TRIM', response: 'up, slowly' },
      { challenge: 'Middle meters', response: 'read when the LEVEL light first blinks red' },
      PUT_BACK,
    ],
    expected:
      'A reading on the middle meters. Write it on the REC tape. If the middle meters reach red first, the Howler has room to spare.',
  },
  {
    // Pioneer's fix for distortion is MASTER ATT (manual p.34; UTILITY table p.32), but the manual only says it
    // "sets the master output attenuator". The table prints +12 dB; the Quick Start Guide (p.17) has −12 dB.
    id: 'test-att',
    number: 'T2',
    title: `Whether MASTER${nb}ATT reaches MASTER${nb}2`,
    short: 'MASTER ATT',
    steps: [
      { challenge: 'Loud track', response: 'recording on the Howler' },
      { challenge: 'MASTER ATT', response: 'down, halfway through' },
      PUT_BACK,
    ],
    note: `Pioneer doesn’t say whether it does. MASTER ATT’s settings are 0, −6 and −12${nb}dB. The Operating Instructions misprint the last as +12${nb}dB, and the Quick Start Guide has it right.`,
    // If MASTER ATT doesn't reach MASTER 2, MASTER LEVEL is the only record level: the one fallback rule, in the
    // words S1, S3 and F1 use (checklists.ts).
    expected: `The second half comes out quieter. If it doesn’t, MASTER ATT can’t turn the recording down. Play the loudest blend, and if the LEVEL light blinks red, turn ${LEVEL_FALLBACK.challenge} down ${LEVEL_FALLBACK.how}, and re-mark the REC tape.`,
  },
  {
    // VirtualDJ's layout notes and Pioneer's own TRIM procedure put the channel meters before the fader. Nobody
    // says whether they read after the EQ; the guide's drawing assumes they do.
    id: 'test-channel-meters',
    number: 'T3',
    title: 'What the channel meters show',
    short: 'Channel meters',
    steps: [
      { challenge: 'LOW', response: 'up, on a playing track' },
      { challenge: 'Its channel meter', response: 'watch it' },
      { challenge: 'Its channel fader', response: 'down, then up' },
    ],
    expected:
      'The channel meter doesn’t move with the fader. Pioneer doesn’t say whether it moves with LOW. If it does, it reads after the EQ, as the guide’s drawing assumes.',
  },
  {
    // Pioneer manual p.31: red means the sound "may be distorted". MASTER REC records before MASTER LEVEL (FAQ),
    // so a clipped channel arrives in the file turned down, below full scale.
    id: 'test-red',
    number: 'T4',
    title: 'Whether red really clips',
    short: 'Whether red clips',
    steps: [
      { challenge: 'MASTER LEVEL', response: 'down' },
      { challenge: 'One channel', response: 'into the red' },
      { challenge: 'MASTER REC', response: 'recording onto a USB stick' },
      { challenge: 'The file', response: 'zoomed in' },
      PUT_BACK,
    ],
    expected:
      'If red clips, the loudest peaks have flat tops. They can sit below the top of the file, so look at any height.',
  },
  {
    id: 'test-leads',
    number: 'T5',
    title: 'The leads',
    short: 'The leads',
    steps: [{ challenge: 'Test recording', response: 'on headphones' }],
    expected: 'Both sides play, and there’s no hum.',
  },
  {
    id: 'test-level',
    number: 'T6',
    title: 'The taped record level',
    short: 'Taped record level',
    steps: [
      { challenge: 'Loudest blend', response: 'a minute, recorded at the taped setting' },
      { challenge: 'The file', response: 'open in Audacity' },
    ],
    expected: `It peaks around −6 to −9${nb}dBFS. If it peaks higher, turn the record level down and re-mark the REC tape`,
    see: { code: 'S3', id: 'record-level' },
  },
];

// The index names each card by its code, as the cards do. Short enough for the rail.
const contents: ContentsEntry[] = [
  { id: CHECKLISTS.setup.anchor, number: CHECKLISTS.setup.code, label: CHECKLISTS.setup.title },
  { id: 'wiring', number: 'S2', label: 'Wiring' },
  { id: 'record-level', number: 'S3', label: 'Record level' },
  { id: 'driverack', number: 'S4', label: 'DriveRack and amps' },
  { id: 'power', number: 'S5', label: 'Generator power' },
  { id: 'backup', number: 'S6', label: 'USB backup' },
  {
    id: 'tests',
    number: 'T',
    label: 'One-off tests',
    subs: tests.map((t) => ({ id: t.id, label: `${t.number} ${t.short}` })),
  },
  { id: 'print', label: 'Print kit' },
];
---

<Base
  title="Setting up"
  description="For whoever sets up the rig: the setup checklist, then cards for the wiring, the record level, the DriveRack PA2 and amps, generator power, the USB backup and the one-off tests."
>
  <PageHeader
    title="Setting up"
    lede="Once, before the first night, and again whenever the rig changes. S1 is the whole job in order, to work through with the kit in front of you. S2 to S6 go through each part, and T1 to T6 test what the manuals leave out."
  />

  <div class="page flow">
    <Contents entries={contents} rows={contents.length} />

    <div class="job">
      <Checklist list="setup" headingLevel={2} client:visible />
    </div>

    <!-- The table needs the page's wide column; its card has no steps, only the table. -->
    <div class="job subflow">
      <div class="wide wiring">
        <Procedure id="wiring" number="S2" title="Wiring" kind="Once" level={2} steps={[]}>
          <!-- Wide: a table, one row per part. Narrow: the same rows as a list, each field labelled. -->
          <table class="rig-table">
            <caption class="visually-hidden">What feeds each part of the rig, how it’s set and its tape</caption>
            <thead>
              <tr>
                <th scope="col" class="ref">Ref</th>
                <th scope="col">Unit</th>
                <th scope="col">Fed from</th>
                <th scope="col">Set to</th>
                <th scope="col">Tape tag</th>
                <th scope="col">Source</th>
              </tr>
            </thead>
            <tbody>
              {
                rigRows.map((r) => (
                  <tr>
                    <td class="ref">{r.ref}</td>
                    <th scope="row" class="unit">
                      {r.unit}
                      {r.sub && <span class="sub">{r.sub}</span>}
                    </th>
                    <td>
                      {r.from}
                      {r.lead && <span class="nobr">({r.lead})</span>}
                      {r.leadNote && <span class="sub">{r.leadNote}</span>}
                    </td>
                    <td>
                      {r.set ? <span class="set">{r.set}</span> : <span class="none">none</span>}
                      {r.setNote && <span class="sub">{r.setNote}</span>}
                      {r.see && (
                        <span class="sub">
                          See <a href={`#${r.see.id}`}>{r.see.code}</a>{r.see.for ? ` for ${r.see.for}.` : '.'}
                        </span>
                      )}
                    </td>
                    <td>
                      {r.tape ? <span class="tag">{r.tape.name}</span> : <span class="none">none</span>}
                      {r.tapeNote && <span class="sub">{r.tapeNote}</span>}
                    </td>
                    <td>
                      <span class="cites">
                        {r.sources.map((c) => (
                          <a href={c.url} rel="external">
                            {c.label}
                          </a>
                        ))}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <ol class="rig-list">
            {
              rigRows.map((r) => (
                <li>
                  <p class="unit">
                    <span class="ref">{r.ref}</span>
                    <span>
                      {r.unit}
                      {r.sub && <span class="sub-inline">{r.sub}</span>}
                    </span>
                  </p>
                  <dl>
                    <div>
                      <dt>Fed from</dt>
                      <dd>
                        {r.from}
                        {r.lead && <span class="nobr">({r.lead})</span>}
                        {r.leadNote && <span class="sub">{r.leadNote}</span>}
                      </dd>
                    </div>
                    {r.set && (
                      <div>
                        <dt>Set to</dt>
                        <dd>
                          <span class="set">{r.set}</span>
                          {r.setNote && <span class="sub">{r.setNote}</span>}
                          {r.see && (
                            <span class="sub">
                              See <a href={`#${r.see.id}`}>{r.see.code}</a>{r.see.for ? ` for ${r.see.for}.` : '.'}
                            </span>
                          )}
                        </dd>
                      </div>
                    )}
                    {r.tape && (
                      <div>
                        <dt>Tape tag</dt>
                        <dd>
                          <span class="tag">{r.tape.name}</span>
                          {r.tapeNote && <span class="sub">{r.tapeNote}</span>}
                        </dd>
                      </div>
                    )}
                    <div>
                      <dt>Source</dt>
                      <dd>
                        <span class="cites">
                          {r.sources.map((c) => (
                            <a href={c.url} rel="external">
                              {c.label}
                            </a>
                          ))}
                        </span>
                      </dd>
                    </div>
                  </dl>
                </li>
              ))
            }
          </ol>
          <p class="note">
            <strong>Note.</strong> The room’s volume comes from the <Term of="amps">amps</Term>, never from
            <Term of="masterLevel">MASTER LEVEL</Term>. To see what each part feeds, pick it in the drawing in
            <a href={href(`/#${signal.id}`)}>{signal.number} {signal.title}</a>.
          </p>
        </Procedure>
      </div>
    </div>

    <div class="job subflow">
      <Procedure
        id="record-level"
        number="S3"
        title="Record level"
        kind="Once"
        level={2}
        caution="The Howler has no input knob, only its LEVEL light, which blinks green when the level is fine and red when it’s too high. So MASTER LEVEL and MASTER ATT set the record level. Pioneer doesn’t say whether MASTER ATT reaches MASTER 2, so run T2 first."
        steps={recordSteps}
        note={ROOM_NOTE}
      >
        <p class="source">
          Pioneer’s Operating Instructions (<a href={`${MANUAL}#page=27`} rel="external">page 27</a> for MASTER LEVEL,
          <a href={`${MANUAL}#page=31`} rel="external">page 31</a> for UTILITY and
          <a href={`${MANUAL}#page=32`} rel="external">page 32</a> for MASTER ATT), and Howler’s
          <a href={HOWLER} rel="external">MK1 manual</a> for the LEVEL light.
        </p>
      </Procedure>
      <div class="wide practice"><RecordLevel client:visible /></div>
    </div>

    <div class="job">
      <Procedure
        id="driverack"
        number="S4"
        title="DriveRack and amps"
        kind="Once"
        level={2}
        caution="Mute the DriveRack’s outputs before you flip its input switch."
        steps={[
          {
            challenge: 'Input switch, on the back',
            response: `+4${nb}dBu`,
            note: `MASTER 1 runs at about +6${nb}dBu, Pioneer’s standard level, so the DriveRack wants its professional setting.`,
          },
          { challenge: 'Setup wizard, tops', response: 'Yamaha S/C115V' },
          {
            challenge: 'Setup wizard, amps',
            response: 'QSC GX7',
            note: 'With these two picked, the wizard sets the limiters for them.',
          },
          {
            challenge: 'Setup wizard, subs',
            response: '“not listed”',
            note: 'The EV EKX-18S subs aren’t in its list.',
          },
          {
            challenge: 'Both GX7 amps, on the back',
            response: 'FULL RANGE',
            note: 'The DriveRack already splits the subs from the tops.',
          },
          { challenge: 'DriveRack input CLIP lights', response: 'dark on the loudest blend' },
          {
            challenge: 'Amp gain knobs',
            response: 'up to what the room needs',
            note: 'Then tape them and mark them RIG.',
          },
        ]}
      >
        <p class="source">
          dbx’s <a href={`${DBX}#page=5`} rel="external">DriveRack PA2 manual</a> and its
          <a href={DBX_TUNINGS} rel="external">list of tunings</a>, which names the Yamaha tops and the QSC amps but no
          EV subs. QSC’s <a href={QSC} rel="external">GX manual</a> for FULL RANGE and the gain knobs.
        </p>
      </Procedure>
    </div>

    <div class="job">
      <Procedure
        id="power"
        number="S5"
        title="Generator power"
        kind="Once"
        level={2}
        caution="Never cure hum by disconnecting an earth, with a ground-lift adapter or a taped or cut earth pin. The earth is what stops a faulty case giving someone a shock."
        steps={[
          {
            challenge: 'Generator',
            response: 'sized for the peaks',
            note: `QSC puts each GX7 at about 3.8${nb}A on a normal night and 6.7${nb}A on a heavy one, so the pair can pull about 3${nb}kW.`,
          },
          {
            challenge: 'Howler battery',
            response: 'charged, and charging while it records',
            note: `It runs for about 30${nb}hours on its battery, and saves the file before the battery runs flat.`,
          },
          { challenge: 'Sound gear', response: 'all on one supply' },
          {
            challenge: 'Howler’s lead',
            response: 'through an isolation transformer',
            note: 'It breaks an earth loop in the audio lead, and every earth stays connected.',
          },
          {
            challenge: 'Amps',
            response: 'on last, off first',
            note: `Switch the GX7s on after everything else and off before it, about 10${nb}seconds apart.`,
          },
        ]}
        note="If the generator cuts out, the room goes quiet but the Howler keeps recording on its battery. The XDJ-RX2 has no battery. Pioneer warns that cutting the power while it writes to USB can leave the file unreadable, so a cut can cost you the MASTER REC backup. Trust the Howler’s file."
      >
        <p class="next">
          If the power cuts out on the night, follow the
          <a href={href('/night/#fix-power-cut')}>power-cut drill on the night page</a>.
        </p>
        <p class="source">
          Howler’s <a href={HOWLER} rel="external">MK1 manual</a> for the battery, Pioneer’s Operating Instructions
          (<a href={`${MANUAL}#page=30`} rel="external">page 30</a>) for switching off mid-write, dbx’s manual
          (<a href={`${DBX}#page=10`} rel="external">page 10</a>) for the order, and QSC’s
          <a href={QSC} rel="external">GX manual</a> for current draw and earthing.
        </p>
      </Procedure>
    </div>

    <div class="job">
      <Procedure
        id="backup"
        number="S6"
        title="USB backup"
        kind="Once"
        level={2}
        caution="Don’t pull the stick or switch off while its USB light is lit or flashing. The file can end up unreadable."
        steps={[
          {
            challenge: 'USB stick',
            response: 'in the USB2 slot',
            note: `About 90${nb}minutes of recording per gigabyte. Files split every three hours.`,
          },
          {
            challenge: 'MASTER REC',
            response: 'press to start',
            note: 'It flashes while it records. It records before MASTER LEVEL, though a clipped mix still records clipped.',
          },
          {
            challenge: 'Howler',
            response: 'recording too',
            note: 'If the USB file is clean and the Howler’s isn’t, the crunch came in on the way to the Howler.',
          },
          { challenge: 'MASTER REC', response: 'press to stop', note: 'Wait until it stops flashing.' },
          { challenge: 'USB STOP', response: `hold for over 2${nb}seconds` },
          { challenge: 'USB stick', response: 'out once its light is off' },
        ]}
        note="Pioneer doesn’t publish its bit depth, and some owners report glitches, so treat it as the spare and try it at home first."
      >
        <p class="source">
          Pioneer’s Operating Instructions (<a href={`${MANUAL}#page=12`} rel="external">page 12</a> for recording,
          <a href={`${MANUAL}#page=30`} rel="external">page 30</a> for USB STOP) and its
          <a href={REC_FAQ} rel="external">MASTER REC answers</a>.
        </p>
      </Procedure>
    </div>

    <section class="job tests subflow" id="tests">
      <h2 class="bar" id="tests-title">One-off tests</h2>
      <p class="intro">
        Pioneer and Howler leave a few things unpublished. One quiet afternoon with the kit answers them for good.
        Write the answers on the tape.
      </p>
      {
        tests.map((t) => (
          <Procedure
            id={t.id}
            number={t.number}
            title={t.title}
            kind="Test"
            level={3}
            steps={t.steps}
            {...(t.note ? { note: t.note } : {})}
          >
            <p class="expected">
              <strong>Expected.</strong> {t.expected}
              {t.see ? (
                <>
                  {' '}
                  (<a href={`#${t.see.id}`}>{t.see.code}</a>).
                </>
              ) : null}
            </p>
            {t.id === 'test-leads' && (
              <p class="next">
                If it hums or sounds one-sided, the night page has drills for
                <a href={href('/night/#fix-hum')}>hum</a> and for a
                <a href={href('/night/#fix-hollow')}>hollow or one-sided recording</a>.
              </p>
            )}
          </Procedure>
        ))
      }
    </section>

