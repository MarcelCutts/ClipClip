---
/**
 * The one-off setup, for whoever sets up the rig, as a quick reference handbook's cards. S1 is the
 * whole job in order (the setup checklist). S2 to S6 go through each part: the wiring, the record
 * level, the DriveRack and amps, generator power and the USB backup. T1 to T6 are the tests that
 * answer what the manuals don't say. Done once, and again whenever the rig changes. Why it works is
 * in the guide.
 *
 * The anchors stay put: the old /crew/ page forwards to #wiring, #record-level, #backup, #power and
 * #tests, the guide links to #record-level, and #setup is the checklist's own.
 */
import Contents, { type ContentsEntry } from '../../components/Contents.astro';
import PageHeader from '../../components/PageHeader.astro';
import Procedure from '../../components/Procedure.astro';
import Term from '../../components/Term.astro';
import Checklist from '../../islands/Checklist.svelte';
import RecordLevel from '../../islands/RecordLevel.svelte';
import SignalPath from '../../islands/SignalPath.svelte';
import Base from '../../layouts/Base.astro';
import { CHECKLISTS } from '../../lib/checklists';
import { SOURCES } from '../../lib/sources';
import { href } from '../../lib/url';

/** A source document's address, from the one list, so the page and the sources section agree. */
const doc = (title: string): string => {
  const found = SOURCES.flatMap((g) => g.sources).find((s) => s.title === title);
  if (!found) throw new Error(`No source titled "${title}"`);
  return found.url;
};
const MANUAL = doc('XDJ-RX2 Operating Instructions');
const QUICK_START = doc('XDJ-RX2 Quick Start Guide and specifications');
const REC_FAQ = doc('XDJ-RX2 FAQ: recording with MASTER REC');
const DBX = doc('DriveRack PA2 Owner’s Manual');
const DBX_TUNINGS = doc('DriveRack PA2 speaker and amplifier tunings');
const QSC = doc('GX3, GX5 and GX7 user manual');
const HOWLER = doc('Recorder+Streamer MK1 manual');
const RANE = doc('Sound System Interconnection (RaneNote 110)');

/** A no-break space, between a number and its unit. */
const nb = ' ';

interface Test {
  id: string;
  number: string;
  title: string;
  /** The index rail's name for it: about 20 characters. */
  short: string;
  steps: { challenge: string; response: string; note?: string }[];
  note?: string;
  /** What a good result looks like, and what to do if you don't get it. */
  expected: string;
}

// Pioneer and Howler leave these unpublished, so the only way to know is to try them on our kit.
const tests: Test[] = [
  {
    // Howler doesn't publish where its light turns red (MK1 manual, FAQ).
    id: 'test-howler',
    number: 'T1',
    title: 'Where the Howler turns red',
    short: 'Howler turns red',
    steps: [
      { challenge: 'MASTER LEVEL', response: 'fully up' },
      { challenge: 'MASTER ATT', response: `0${nb}dB` },
      { challenge: 'Loud track', response: 'playing' },
      { challenge: 'Its TRIM', response: 'up, slowly' },
      { challenge: 'Middle meters', response: 'read when the Howler first blinks red' },
    ],
    expected:
      'A reading on the middle meters. Write it on the REC tape. If the middle meters reach red first, the Howler has room to spare.',
  },
  {
    // Pioneer's fix for distortion is MASTER ATT (manual p.34; UTILITY table p.32), but the manual only says it
    // "sets the master output attenuator". The table prints +12 dB; the Quick Start Guide (p.17) has −12 dB.
    id: 'test-att',
    number: 'T2',
    title: `Whether MASTER${nb}ATT reaches MASTER${nb}2`,
    short: 'MASTER ATT',
    steps: [
      { challenge: 'Loud track', response: 'recording on the Howler' },
      { challenge: 'MASTER ATT', response: 'down, halfway through' },
    ],
    note: `Pioneer doesn’t say whether it does. MASTER ATT’s settings are 0, −6 and −12${nb}dB. The Operating Instructions misprint the last as +12${nb}dB, and the Quick Start Guide has it right.`,
    expected:
      'The second half comes out quieter. If it doesn’t, trim the recording with MASTER LEVEL instead, a notch at a time, and re-mark the REC tape.',
  },
  {
    // VirtualDJ's layout notes and Pioneer's own TRIM procedure put the channel meters before the fader. Nobody
    // says whether they read after the EQ; the wiring drawing assumes they do.
    id: 'test-side-meters',
    number: 'T3',
    title: 'What the side meters show',
    short: 'Side meters',
    steps: [
      { challenge: 'LOW', response: 'up, on a playing track' },
      { challenge: 'Its channel meter', response: 'watch it' },
      { challenge: 'Its channel fader', response: 'down, then up' },
    ],
    expected:
      'The channel meter doesn’t move with the fader. Pioneer doesn’t say whether it moves with LOW. If it does, it reads after the EQ, as the wiring drawing in S2 assumes.',
  },
  {
    // Pioneer manual p.31: red means the sound "may be distorted". MASTER REC records before MASTER LEVEL (FAQ),
    // so a clipped channel arrives in the file turned down, below full scale.
    id: 'test-red',
    number: 'T4',
    title: 'Whether red really clips',
    short: 'Whether red clips',
    steps: [
      { challenge: 'MASTER LEVEL', response: 'down' },
      { challenge: 'One channel', response: 'into the red' },
      { challenge: 'MASTER REC', response: 'recording onto a USB stick' },
      { challenge: 'The file', response: 'zoomed in' },
    ],
    expected:
      'If red clips, the loudest peaks have flat tops. They can sit below the top of the file, so look at any height.',
  },
  {
    id: 'test-leads',
    number: 'T5',
    title: 'The leads',
    short: 'The leads',
    steps: [{ challenge: 'Test recording', response: 'on headphones' }],
    expected: 'Both sides play, and there’s no hum.',
  },
  {
    id: 'test-level',
    number: 'T6',
    title: 'The taped record level',
    short: 'Taped record level',
    steps: [
      { challenge: 'Loudest blend', response: 'a minute, recorded at the taped setting' },
      { challenge: 'The file', response: 'open in Audacity' },
    ],
    expected: `It peaks around −6 to −9${nb}dBFS.`,
  },
];

// The index names each card by its code, as the cards do. Short enough for the rail.
const contents: ContentsEntry[] = [
  { id: CHECKLISTS.setup.anchor, number: CHECKLISTS.setup.code, label: CHECKLISTS.setup.title },
  { id: 'wiring', number: 'S2', label: 'Wiring' },
  { id: 'record-level', number: 'S3', label: 'Record level' },
  { id: 'driverack', number: 'S4', label: 'DriveRack and amps' },
  { id: 'power', number: 'S5', label: 'Generator power' },
  { id: 'backup', number: 'S6', label: 'USB backup' },
  {
    id: 'tests',
    number: 'T',
    label: 'One-off tests',
    subs: tests.map((t) => ({ id: t.id, label: `${t.number} ${t.short}` })),
  },
  { id: 'print', label: 'Print kit' },
];
---

<Base
  title="Setting up"
  description="For whoever sets up the rig: the setup checklist, then cards for the wiring, the record level, the DriveRack PA2 and amps, generator power, the USB backup and the one-off tests."
>
  <PageHeader
    title="Setting up"
    lede="Once, before the first night, and again whenever the rig changes. S1 is the whole job in order, to work through with the kit in front of you. S2 to S6 go through each part, and T1 to T6 test what the manuals leave out."
  />

  <div class="page flow">
    <Contents entries={contents} rows={contents.length} />

    <div class="job">
      <Checklist list="setup" headingLevel={2} client:visible />
    </div>

    <div class="job subflow">
      <Procedure
        id="wiring"
        number="S2"
        title="Wiring"
        kind="Once"
        level={2}
        steps={[
          {
            challenge: 'MASTER 1 (XLR, L and R)',
            response: 'DriveRack PA2 inputs',
            note: 'From there to the amps and the speakers.',
          },
          {
            challenge: 'MASTER 2 (RCA, L and R)',
            response: 'Howler input',
            note: `One stereo RCA lead, under 3${nb}m, with no adapters.`,
          },
          {
            challenge: 'BOOTH (¼″ jacks, L and R)',
            response: 'booth monitors',
            note: 'Balanced leads. BOOTH MONITOR sets only these speakers, and it’s the DJ’s knob.',
          },
          {
            challenge: 'MASTER LEVEL',
            response: 'fully up, taped REC',
            note: 'It sets MASTER 1 and MASTER 2 together, so it sets the room and the recording at once.',
          },
        ]}
        note="The room’s volume comes from the amps and the DriveRack, never from MASTER LEVEL. Pick any part in the drawing below to light up what it feeds."
      >
        <p class="source">
          Pioneer’s <span class="nobr">XDJ-RX2</span> Operating Instructions
          (<a href={`${MANUAL}#page=27`} rel="external">page 27</a>) and Quick Start Guide
          (<a href={`${QUICK_START}#page=20`} rel="external">page 20</a>), and
          <a href={RANE} rel="external">RaneNote 110</a> on unbalanced leads.
        </p>
      </Procedure>
      <div class="wide figure"><SignalPath client:visible /></div>
    </div>

    <section class="job subflow" id="record-level" aria-labelledby="record-level-title">
      <h2 class="strip" id="record-level-title">
        <span><span class="no">S3</span>Record level</span>
        <span class="kind">Once</span>
      </h2>
      <p class="intro">
        The <Term of="howler">Howler</Term> has no input knob, only its LEVEL light. It blinks green when the level is
        fine and red when it’s too hot. So the record level is set by what feeds it: MASTER LEVEL, and
        <Term of="att">MASTER ATT</Term> if you need it. Set it once, on a blend hotter than any DJ should send, then
        leave it.
      </p>
      <div class="wide"><RecordLevel client:visible /></div>
    </section>

    <div class="job">
      <Procedure
        id="driverack"
        number="S4"
        title="DriveRack and amps"
        kind="Once"
        level={2}
        caution="Mute the DriveRack’s outputs before you flip its input switch."
        steps={[
          {
            challenge: 'Input switch, on the back',
            response: `+4${nb}dBu`,
            note: `MASTER 1 runs at about +6${nb}dBu, Pioneer’s standard level, so the DriveRack wants its professional setting.`,
          },
          { challenge: 'Setup wizard, tops', response: 'Yamaha S/C115V' },
          {
            challenge: 'Setup wizard, amps',
            response: 'QSC GX7',
            note: 'With these two picked, the wizard sets the limiters for them.',
          },
          {
            challenge: 'Setup wizard, subs',
            response: '“not listed”',
            note: 'The EV EKX-18S subs aren’t in its list.',
          },
          {
            challenge: 'Both GX7 amps, on the back',
            response: 'FULL RANGE',
            note: 'The DriveRack already splits the subs from the tops.',
          },
          { challenge: 'DriveRack input CLIP lights', response: 'dark on the loudest blend' },
          {
            challenge: 'Amp gain knobs',
            response: 'up to what the room needs',
            note: 'Then tape them and mark them RIG.',
          },
        ]}
      >
        <p class="source">
          dbx’s <a href={`${DBX}#page=5`} rel="external">DriveRack PA2 manual</a> and its
          <a href={DBX_TUNINGS} rel="external">list of tunings</a>, which names the Yamaha tops and the QSC amps but no
          EV subs. QSC’s <a href={QSC} rel="external">GX manual</a> for FULL RANGE and the gain knobs.
        </p>
      </Procedure>
    </div>

    <div class="job">
      <Procedure
        id="power"
        number="S5"
        title="Generator power"
        kind="Once"
        level={2}
        caution="Never cure hum by lifting a mains earth. The earth is what stops a faulty case giving someone a shock."
        steps={[
          {
            challenge: 'Generator',
            response: 'sized for the peaks',
            note: `QSC puts each GX7 at about 3.8${nb}A on a normal night and 6.7${nb}A on a heavy one, so the pair can pull about 3${nb}kW.`,
          },
          {
            challenge: 'Howler battery',
            response: 'charged, and charging while it records',
            note: `It runs for about 30${nb}hours on its battery, and saves the file before the battery runs flat.`,
          },
          { challenge: 'Sound gear', response: 'all on one supply' },
          {
            challenge: 'Howler’s lead',
            response: 'through an isolation transformer',
            note: 'It breaks a hum loop in the audio lead, and every earth stays connected.',
          },
          {
            challenge: 'Amps',
            response: 'on last, off first',
            note: `Switch the GX7s on after everything else and off before it, about 10${nb}seconds apart.`,
          },
        ]}
        note="If the generator cuts out, the room goes quiet but the Howler keeps recording on its battery. The XDJ-RX2 has no battery. Pioneer warns that cutting the power while it writes to USB can leave the file unreadable, so a cut can cost you the MASTER REC backup. Trust the Howler’s file."
      >
        <p class="next">
          If the power cuts out on the night, follow the
          <a href={href('/night/#fix-power-cut')}>power-cut drill on the night page</a>.
        </p>
        <p class="source">
          Howler’s <a href={HOWLER} rel="external">MK1 manual</a> for the battery, Pioneer’s Operating Instructions
          (<a href={`${MANUAL}#page=30`} rel="external">page 30</a>) for switching off mid-write, dbx’s manual
          (<a href={`${DBX}#page=10`} rel="external">page 10</a>) for the order, and QSC’s
          <a href={QSC} rel="external">GX manual</a> for current draw and earthing.
        </p>
      </Procedure>
    </div>

    <div class="job">
      <Procedure
        id="backup"
        number="S6"
        title="USB backup"
        kind="Once"
        level={2}
        caution="Don’t pull the stick or switch off while its USB light is lit or flashing. The file can end up unreadable."
        steps={[
          {
            challenge: 'USB stick',
            response: 'in the USB2 slot',
            note: `About 90${nb}minutes of recording per gigabyte. Files split every three hours.`,
          },
          {
            challenge: 'MASTER REC',
            response: 'press to start',
            note: 'It flashes while it records. It records before MASTER LEVEL, though a clipped mix still records clipped.',
          },
          {
            challenge: 'Howler',
            response: 'recording too',
            note: 'If the USB file is clean and the Howler’s isn’t, the damage happened after the split.',
          },
          { challenge: 'MASTER REC', response: 'press to stop', note: 'Wait until it stops flashing.' },
          { challenge: 'USB STOP', response: `hold for over 2${nb}seconds` },
          { challenge: 'USB stick', response: 'out once its light is off' },
        ]}
        note="A couple of owners have reported glitches, and it’s probably 16-bit, so treat it as the spare and try it at home first."
      >
        <p class="source">
          Pioneer’s Operating Instructions (<a href={`${MANUAL}#page=12`} rel="external">page 12</a> for recording,
          <a href={`${MANUAL}#page=30`} rel="external">page 30</a> for USB STOP) and its
          <a href={REC_FAQ} rel="external">MASTER REC answers</a>.
        </p>
      </Procedure>
    </div>

    <section class="job tests subflow" id="tests">
      <h2 class="bar" id="tests-title">One-off tests</h2>
      <p class="intro">
        Pioneer and Howler leave a few things unpublished. One quiet afternoon with the kit answers them for good.
        Write the answers on the tape.
      </p>
      {
        tests.map((t) => (
          <Procedure
            id={t.id}
            number={t.number}
            title={t.title}
            kind="Test"
            level={3}
            steps={t.steps}
            {...(t.note ? { note: t.note } : {})}
          >
            <p class="expected">
              <strong>Expected.</strong> {t.expected}
            </p>
            {t.id === 'test-leads' && (
              <p class="next">
                If it hums or sounds one-sided, the night page has drills for
                <a href={href('/night/#fix-hum')}>hum</a> and for a
                <a href={href('/night/#fix-hollow')}>hollow or one-sided recording</a>.
              </p>
            )}
          </Procedure>
        ))
      }
    </section>

    <section class="job subflow" id="print">
      <h2 id="print-title">Print kit</h2>
      <p>
        The <a href={href('/print/')}>print page</a> has the booth card for the DJs, tape tags for REC, MONITOR and RIG,
        the checklists as laminated cards (C1 to C3 for the night, and S1), and messages to paste into the group chat.
      </p>
    </section>
  </div>
</Base>

<style>
  .page {
    --job-gap: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
    row-gap: 0;
  }

  .page > :global(.toc) {
    margin-block-start: 2.25rem;
  }

  /* Wide screens: the rail starts level with the first card. */
  @media (min-width: 80rem) {
    .page > :global(.toc) {
      margin-block-start: calc(var(--job-gap) + 0.1rem);
    }
  }

  /* One job to a row of the page's grid, so the rail runs beside all of them. A job with a lab keeps
     the page's columns, so the lab can take the wide one. */
  .job {
    margin-block-start: var(--job-gap);
  }

  .subflow {
    grid-column: full;
    row-gap: 1rem;
    align-content: start;
  }

  @media (min-width: 80rem) {
    .subflow {
      grid-column: rail-end / full-end;
    }
  }

  .figure {
    margin-block-start: 0.5rem;
  }

  /* S3's title, set like a procedure card's strip: its labs sit under it rather than in a frame. */
  .strip {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0.8rem;
    background: var(--strip);
    color: var(--on-strip);
    font-size: var(--text-rule);
    line-height: 1.3;
    scroll-margin-top: 1rem;
  }

  .no {
    margin-inline-end: 0.6em;
  }

  .kind {
    flex: none;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-sm);
  }

  /* The tests' heading: a bar like a part of the guide, over cards of their own. */
  .bar {
    padding: 0.5rem 0.8rem;
    background: var(--strip);
    color: var(--on-strip);
    font-size: var(--text-h2);
    line-height: 1.2;
  }

  .tests > :global(.proc) {
    margin-block-start: 0.5rem;
  }

  .expected {
    line-height: 1.5;
  }

  .next {
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  #record-level,
  #tests,
  #print {
    scroll-margin-top: 1rem;
  }

  @media (forced-colors: active) {
    .strip,
    .bar {
      forced-color-adjust: none;
      background: CanvasText;
      color: Canvas;
    }
  }

  @media print {
    .strip,
    .bar {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
