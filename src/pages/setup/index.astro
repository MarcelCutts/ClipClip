---
/**
 * Setting up, at every event, for whoever builds the rig, working alone with the kit in front of
 * them. S1 is the whole job in order (checklists.ts). The cards after it follow S1's order: S2 the
 * wiring, as a table built from the guide's signal drawing (lib/rig.ts); T2, the one-off test of
 * whether MASTER ATT reaches MASTER 2; S3 the recording level (lib/record/flow.ts); S4 the DriveRack
 * and amps; S5 the DriveRack's setup wizard, once. Each card says when it's done: every event, or
 * once. Why it works is in the guide.
 *
 * The anchors other pages use stay put: #setup is the checklist's, the guide links to #record-level
 * and #test-att, and the old /crew/ page forwards to #wiring and #record-level.
 */
import Contents, { type ContentsEntry } from '../../components/Contents.astro';
import PageHeader from '../../components/PageHeader.astro';
import Procedure from '../../components/Procedure.astro';
import Term from '../../components/Term.astro';
import Checklist from '../../islands/Checklist.svelte';
import Base from '../../layouts/Base.astro';
import { CHECKLISTS, OPEN_UTILITY } from '../../lib/checklists';
import { FIXES } from '../../lib/fixes';
import { ATT_SETTINGS, CONSEQUENCE, SAVE_NOTE, STEPS } from '../../lib/record/flow';
import { edgesFor, NODES, type NodeId } from '../../lib/rig';
import { section } from '../../lib/sections';
import { SOURCES } from '../../lib/sources';
import { MONITOR_TAG, REC_TAG, RIG_TAG, type ShortTag } from '../../lib/tags';
import { href } from '../../lib/url';

/** A source document's address, from the one list, so the page and the sources section agree. */
const doc = (title: string): string => {
  const found = SOURCES.flatMap((g) => g.sources).find((s) => s.title === title);
  if (!found) throw new Error(`No source titled "${title}"`);
  return found.url;
};
const MANUAL = doc('XDJ-RX2 Operating Instructions');
const QUICK_START = doc('XDJ-RX2 Quick Start Guide and specifications');
const DBX = doc('DriveRack PA2 Owner’s Manual');
const DBX_TUNINGS = doc('DriveRack PA2 speaker and amplifier tunings');
const QSC = doc('GX3, GX5 and GX7 user manual');
const HOWLER = doc('Recorder+Streamer MK1 manual');
const RANE = doc('Sound System Interconnection (RaneNote 110)');

/** A no-break space, between a number and its unit. */
const nb = ' ';
const MINUS = '−';

/** When a card is done, on the right of its title strip. */
const EVERY_EVENT = 'Every event';
const ONCE = 'Once';

/** The earth warning, in the words of the hum drill (F10), so the setup page and the night page agree. */
const EARTH_WARNING = FIXES.find((f) => f.id === 'hum')?.warning;
if (!EARTH_WARNING) throw new Error('The hum drill (F10) has no earth warning for S2 to repeat');

// ---- S2: the rig as a table -----------------------------------------------------------------

interface Cite {
  label: string;
  url: string;
}

interface RigRow {
  /** The part, as the guide's drawing names it. */
  node: NodeId;
  /** Show the drawing's second line after the name ("QSC GX7"). */
  withSub?: boolean;
  /** How the lead is made, after the socket's name: "XLR, L and R". */
  lead?: string;
  /** A second line under the feed: what the lead should be. */
  leadNote?: string;
  /** What it's set to: the response, in the action colour. Empty for nothing to set. */
  set: string;
  /** A second line under the setting. */
  setNote?: string;
  /** The card that sets the rest: "See S4." */
  see?: { code: string; id: string; for?: string };
  sources: Cite[];
}

const OI = (page: number): Cite => ({ label: `XDJ manual p.${nb}${page}`, url: `${MANUAL}#page=${page}` });
const QSG = (page: number): Cite => ({ label: `XDJ quick start p.${nb}${page}`, url: `${QUICK_START}#page=${page}` });

/** The tape each taped part carries (rig.ts marks which are taped; tags.ts has what's printed on them). */
const TAPE: Partial<Record<NodeId, ShortTag>> = { masterLevel: REC_TAG, booth: MONITOR_TAG, amps: RIG_TAG };

/** Each part in signal order: the PA's branch, the recorder's, then the booth monitors'. */
const RIG_ROWS: RigRow[] = [
  {
    node: 'masterLevel',
    set: 'fully up',
    setNote: 'It sets MASTER 1 and MASTER 2 together.',
    sources: [OI(27)],
  },
  {
    node: 'driverack',
    lead: `XLR, L and R`,
    set: `input switch on +4${nb}dBu`,
    see: { code: 'S4', id: 'driverack' },
    sources: [QSG(20), { label: `dbx manual p.${nb}5`, url: `${DBX}#page=5` }],
  },
  {
    node: 'amps',
    withSub: true,
    set: 'FULL RANGE, gain for the room',
    see: { code: 'S4', id: 'driverack' },
    sources: [{ label: 'QSC GX manual', url: QSC }],
  },
  {
    node: 'howler',
    lead: 'RCA, L and R',
    leadNote: `One stereo RCA lead, under 3${nb}m, with no adapters.`,
    set: 'WAV',
    see: { code: 'S3', id: 'record-level', for: 'its recording level' },
    sources: [QSG(20), { label: 'RaneNote 110', url: RANE }, { label: 'Howler manual', url: HOWLER }],
  },
  {
    node: 'booth',
    set: 'left to the DJ',
    setNote: 'It sets only the booth monitors.',
    sources: [OI(27)],
  },
  {
    node: 'monitor',
    lead: '¼″ jacks, L and R',
    leadNote: 'Balanced leads.',
    set: '',
    sources: [OI(10), QSG(20)],
  },
];

/**
 * What feeds a part, by lead: a socket by its printed name, anything else as "the DriveRack PA2".
 * The limiter is inside the DriveRack, so the amps' lead comes from the DriveRack itself.
 */
function feed(id: NodeId): string {
  const edges = edgesFor();
  let from = edges.find((e) => e.to === id)?.from;
  if (from === 'limiter') from = edges.find((e) => e.to === 'limiter')?.from;
  if (!from) throw new Error(`Nothing feeds ${id}`);
  const node = NODES[from];
  if (node.printed) return node.label;
  return node.kind === 'bus' ? `the ${node.label.toLowerCase()}` : `the ${node.label}`;
}

const rigRows = RIG_ROWS.map((r, i) => {
  const node = NODES[r.node];
  const tape = node.taped ? TAPE[r.node] : undefined;
  return {
    ...r,
    ref: String(i + 1),
    unit: node.label,
    sub: r.withSub ? node.sub : undefined,
    from: feed(r.node),
    tape,
  };
});

const signal = section('signal');

// ---- T2: whether MASTER ATT reaches MASTER 2 -------------------------------------------------

// Pioneer's fix for distortion is MASTER ATT (manual p.34; UTILITY table p.32), but the manual only says it
// "sets the master output attenuator". The table prints +12 dB; the Quick Start Guide (p.17) has −12 dB.
const attDb = (v: number) => (v === 0 ? `0${nb}dB` : `${MINUS}${Math.abs(v)}${nb}dB`);
const [attFull, , attLowest] = ATT_SETTINGS;
const T2_STEPS = [
  { challenge: 'Loud track', response: 'recording on the Howler' },
  {
    challenge: 'MASTER ATT, halfway through',
    response: attDb(attLowest),
    note: `It is in UTILITY. ${OPEN_UTILITY} Its settings are ${ATT_SETTINGS.map(attDb).join(', ').replace(/, ([^,]+)$/, ' and $1')}. The Operating Instructions misprint the last as +12${nb}dB, and the Quick Start Guide has it right.`,
  },
  { challenge: 'MASTER ATT', response: `back to ${attDb(attFull)}` },
];

// ---- S4 and S5: the DriveRack and the amps ----------------------------------------------------

const S4_STEPS = [
  {
    challenge: 'Input switch, on the back of the DriveRack',
    response: `+4${nb}dBu`,
    note: `MASTER 1 runs at about +6${nb}dBu, Pioneer’s standard level. On ${MINUS}10${nb}dBV the DriveRack’s input clips about 10${nb}dB early. dbx advises flipping the switch only with the amps off or its outputs muted.`,
  },
  {
    challenge: 'Both GX7 amps, on the back',
    response: 'FULL RANGE',
    note: 'The DriveRack already splits the subs from the top speakers.',
  },
  { challenge: 'DriveRack setup wizard', response: 'done once (S5)' },
  {
    challenge: 'Both GX7 amps',
    response: 'switched on last',
    note: `dbx says to switch the amps on after everything else, and off first, about 10${nb}seconds apart.`,
  },
  { challenge: 'DriveRack input CLIP lights', response: 'dark on the loudest blend' },
  { challenge: 'Amp gain knobs, on the loudest blend', response: 'as loud as the room needs, CLIP lights dark' },
];

const S5_STEPS = [
  { challenge: 'Top speakers', response: 'Yamaha S/C115V' },
  {
    challenge: 'Amps',
    response: 'QSC GX7',
    note: 'With these two picked, the wizard sets the limiters for the GX7s.',
  },
  { challenge: 'Subs', response: '“not listed”', note: 'The EV EKX-18S subs are not in its list.' },
];

// The index names each card by its code, as the cards do, in the order S1 uses them.
const contents: ContentsEntry[] = [
  { id: CHECKLISTS.setup.anchor, number: CHECKLISTS.setup.code, label: CHECKLISTS.setup.title },
  { id: 'wiring', number: 'S2', label: 'Wiring' },
  { id: 'test-att', number: 'T2', label: 'MASTER ATT test' },
  { id: 'record-level', number: 'S3', label: 'Recording level' },
  { id: 'driverack', number: 'S4', label: 'DriveRack and amps' },
  { id: 'wizard', number: 'S5', label: 'Setup wizard' },
];
---

<Base
  title="Setting up"
  description="For whoever sets up the rig at every event: the setup checklist, the wiring table, and cards for the recording level, the DriveRack PA2 and the amps."
>
  <PageHeader title="Setting up">
    <Fragment slot="lede">
      At every event, before the doors open. Work through S1 with the kit in front of you. The tape tags are in the
      <a href={href('/print/')}>Print kit</a>.
    </Fragment>
  </PageHeader>

  <div class="page flow">
    <Contents entries={contents} rows={contents.length + 1} />

    <div class="job">
      <Checklist list="setup" headingLevel={2} client:visible />
      <p class="source after">
        QSC’s <a href={QSC} rel="external">GX manual</a> for what the amps draw, and Howler’s
        <a href={HOWLER} rel="external">MK1 manual</a> for the battery.
      </p>
    </div>

    <!-- The table needs the page's wide column; its card has no steps, only the warning and the table. -->
    <div class="job subflow">
      <div class="wide wiring">
        <Procedure id="wiring" number="S2" title="Wiring" kind={EVERY_EVENT} level={2} steps={[]}>
          <p class="warning"><strong>Warning.</strong> {EARTH_WARNING}</p>
          <!-- Wide: a table, one row per part. Narrow: the same rows as a list, each field labelled. -->
          <table class="rig-table">
            <caption class="visually-hidden">What feeds each part of the rig, how it’s set and its tape</caption>
            <thead>
              <tr>
                <th scope="col" class="ref">Ref</th>
                <th scope="col">Unit</th>
                <th scope="col">Fed from</th>
                <th scope="col">Set to</th>
                <th scope="col">Tape tag</th>
                <th scope="col">Source</th>
              </tr>
            </thead>
            <tbody>
              {
                rigRows.map((r) => (
                  <tr>
                    <td class="ref">{r.ref}</td>
                    <th scope="row" class="unit">
                      {r.unit}
                      {r.sub && <span class="sub">{r.sub}</span>}
                    </th>
                    <td>
                      {r.from}
                      {r.lead && <span class="nobr">({r.lead})</span>}
                      {r.leadNote && <span class="sub">{r.leadNote}</span>}
                    </td>
                    <td>
                      {r.set ? <span class="set">{r.set}</span> : <span class="none">none</span>}
                      {r.setNote && <span class="sub">{r.setNote}</span>}
                      {r.see && (
                        <span class="sub">
                          See <a href={`#${r.see.id}`}>{r.see.code}</a>{r.see.for ? ` for ${r.see.for}.` : '.'}
                        </span>
                      )}
                    </td>
                    <td>{r.tape ? <span class="tag">{r.tape.name}</span> : <span class="none">none</span>}</td>
                    <td>
                      <span class="cites">
                        {r.sources.map((c) => (
                          <a href={c.url} rel="external">
                            {c.label}
                          </a>
                        ))}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <ol class="rig-list">
            {
              rigRows.map((r) => (
                <li>
                  <p class="unit">
                    <span class="ref">{r.ref}</span>
                    <span>
                      {r.unit}
                      {r.sub && <span class="sub-inline">{r.sub}</span>}
                    </span>
                  </p>
                  <dl>
                    <div>
                      <dt>Fed from</dt>
                      <dd>
                        {r.from}
                        {r.lead && <span class="nobr">({r.lead})</span>}
                        {r.leadNote && <span class="sub">{r.leadNote}</span>}
                      </dd>
                    </div>
                    {r.set && (
                      <div>
                        <dt>Set to</dt>
                        <dd>
                          <span class="set">{r.set}</span>
                          {r.setNote && <span class="sub">{r.setNote}</span>}
                          {r.see && (
                            <span class="sub">
                              See <a href={`#${r.see.id}`}>{r.see.code}</a>{r.see.for ? ` for ${r.see.for}.` : '.'}
                            </span>
                          )}
                        </dd>
                      </div>
                    )}
                    {r.tape && (
                      <div>
                        <dt>Tape tag</dt>
                        <dd>
                          <span class="tag">{r.tape.name}</span>
                        </dd>
                      </div>
                    )}
                    <div>
                      <dt>Source</dt>
                      <dd>
                        <span class="cites">
                          {r.sources.map((c) => (
                            <a href={c.url} rel="external">
                              {c.label}
                            </a>
                          ))}
                        </span>
                      </dd>
                    </div>
                  </dl>
                </li>
              ))
            }
          </ol>
          <p class="next">
            The drawing in <a href={href(`/#${signal.id}`)}>{signal.number} {signal.title}</a> shows what each part feeds.
          </p>
        </Procedure>
      </div>
    </div>

    <div class="job">
      <Procedure
        id="test-att"
        number="T2"
        title={`Whether MASTER${nb}ATT reaches MASTER${nb}2`}
        kind={ONCE}
        level={2}
        caution="Pioneer’s manual says only that MASTER ATT “sets the master output attenuator”. It does not say whether that includes MASTER 2, the Howler’s socket."
        steps={T2_STEPS}
      >
        <p class="expected">
          <strong>Expected.</strong> The second half of the file is quieter. If it is not, MASTER ATT does not reach
          {`MASTER${nb}2`}. In S3, leave it at {attDb(attFull)} and skip its two steps.
        </p>
        <p class="source">
          Pioneer’s Operating Instructions (<a href={`${MANUAL}#page=32`} rel="external">p.{nb}32</a>) and Quick Start
          Guide (<a href={`${QUICK_START}#page=17`} rel="external">p.{nb}17</a>).
        </p>
      </Procedure>
    </div>

    <div class="job">
      <Procedure
        id="record-level"
        number="S3"
        title="Recording level"
        kind={EVERY_EVENT}
        level={2}
        caution={CONSEQUENCE}
        steps={[...STEPS]}
        note={SAVE_NOTE}
      >
        <p class="source">
          Pioneer’s Operating Instructions (<a href={`${MANUAL}#page=27`} rel="external">p.{nb}27</a> for MASTER LEVEL,
          <a href={`${MANUAL}#page=31`} rel="external">p.{nb}31</a> for UTILITY and
          <a href={`${MANUAL}#page=32`} rel="external">p.{nb}32</a> for MASTER ATT), and Howler’s
          <a href={HOWLER} rel="external">MK1 manual</a> for the LEVEL light.
        </p>
      </Procedure>
    </div>

    <div class="job">
      <Procedure id="driverack" number="S4" title="DriveRack and amps" kind={EVERY_EVENT} level={2} steps={S4_STEPS}>
        <p class="source">
          dbx’s DriveRack PA2 manual (<a href={`${DBX}#page=5`} rel="external">p.{nb}5</a> for the input switch,
          <a href={`${DBX}#page=10`} rel="external">p.{nb}10</a> for the order) and QSC’s
          <a href={QSC} rel="external">GX manual</a> for FULL RANGE, the gain knobs and the CLIP lights.
        </p>
      </Procedure>
    </div>

    <div class="job">
      <Procedure id="wizard" number="S5" title="DriveRack setup wizard" kind={ONCE} level={2} steps={S5_STEPS}>
        <p class="source">
          dbx’s <a href={DBX_TUNINGS} rel="external">list of tunings</a>, which names the Yamaha top speakers and the QSC
          amps but no EV subs.
        </p>
      </Procedure>
    </div>

    <p class="job check">
      <strong>Check it yourself.</strong> If a channel meter rises when you turn up LOW, it reads after the EQ, as the
      guide’s drawing assumes. If a channel pushed into the red records with flat tops at any height while MASTER LEVEL
      is down, red <Term of="clipping" then=".">clips</Term>
    </p>
  </div>
</Base>

<style>
  .page {
    --job-gap: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
    row-gap: 0;
  }

  .page > :global(.toc) {
    margin-block-start: 2.25rem;
  }

  /* Wide screens: the rail starts level with the first card. */
  @media (min-width: 80rem) {
    .page > :global(.toc) {
      margin-block-start: calc(var(--job-gap) + 0.1rem);
    }
  }

  /* One job to a row of the page's grid, so the rail runs beside all of them. A job with a table
     keeps the page's columns, so the table can take the wide one. */
  .job {
    margin-block-start: var(--job-gap);
  }

  .subflow {
    grid-column: full;
    row-gap: 1rem;
    align-content: start;
  }

  @media (min-width: 80rem) {
    .subflow {
      grid-column: rail-end / full-end;
    }
  }

  /* Under S1: where its notes' numbers come from, as the cards' own source lines are. */
  .source.after {
    margin-block-start: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* The earth warning, set as the drills set it: the signal word bold, in the warning colour. */
  .warning {
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .warning strong {
    color: var(--warning);
  }

  /* ---- S2: the rig table ---------------------------------------------------------------------- */

  /* The card has no steps: the warning and the table are its body. */
  .wiring {
    container-type: inline-size;
  }

  .rig-table {
    display: none;
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .rig-table th,
  .rig-table td {
    padding: 0.55rem 0.9rem 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  .rig-table thead th {
    padding-block: 0 0.45rem;
    border-bottom: 2px solid var(--ink);
    font-weight: 700;
    color: var(--ink-2);
  }

  .rig-table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .rig-table .ref {
    width: 2.25rem;
    font-weight: 700;
  }

  .rig-table .unit {
    font-weight: 700;
    white-space: nowrap;
  }

  .sub {
    display: block;
    margin-top: 0.15rem;
    font-weight: 400;
    color: var(--ink-2);
  }

  .sub-inline {
    margin-inline-start: 0.4em;
    font-weight: 400;
    color: var(--ink-2);
  }

  /* The setting is what to do, so it's in the action colour, as a checklist's response is. */
  .set {
    font-weight: 700;
    color: var(--action);
  }

  .none {
    color: var(--ink-3);
  }

  /* The tape's word as it's written on the tape: stencil capitals on gaffer tape. */
  .tag {
    display: inline-block;
    padding: 0.2em 0.55em 0.15em;
    background: var(--tape);
    color: var(--tape-ink);
    font-family: var(--font-stencil);
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1;
    letter-spacing: 0.04em;
    clip-path: polygon(0 8%, 6% 0, 100% 0, 96% 30%, 100% 62%, 95% 100%, 4% 100%, 0 70%, 3% 40%);
  }

  /* Sources: one to a line in the table; in the list they run on, one after another. */
  .cites {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
  }

  .rig-table .cites {
    flex-direction: column;
    align-items: start;
  }

  .cites a {
    white-space: nowrap;
  }

  .rig-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rig-list > li {
    display: grid;
    gap: 0.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .rig-list > li:first-child {
    padding-top: 0.1rem;
  }

  .rig-list .unit {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    font-weight: 700;
  }

  .rig-list dl {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 0 1.6rem;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .rig-list dl > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: 0.75rem;
  }

  .rig-list dt {
    color: var(--ink-2);
  }

  .rig-list dd {
    margin: 0;
  }

  /* Wide enough for six columns: the table, and the list goes. */
  @container (min-width: 44rem) {
    .rig-table {
      display: table;
    }

    .rig-list {
      display: none;
    }
  }

  .expected {
    line-height: 1.5;
  }

  .next,
  .check {
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  @media (forced-colors: active) {
    .tag {
      border: 1px solid CanvasText;
    }
  }

  @media print {
    .tag {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
