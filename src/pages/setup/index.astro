---
/**
 * Rig reference: what feeds what, and how each unit is set, for when a lead or a setting looks wrong.
 * An event's work is Crew's C1. The page carries no tests and no commissioning cards: this is a guide
 * for the field, and those needed a laptop (the owner, 28 September 2026). Old links to them forward
 * to the card that does their job now.
 * Printed dbx page N is PDF page N+2. Other manual page references keep their published numbering.
 */
import Contents, { type ContentsEntry } from '../../components/Contents.astro';
import LegacyAnchors from '../../components/LegacyAnchors.astro';
import PageHeader from '../../components/PageHeader.astro';
import Procedure from '../../components/Procedure.astro';
import Base from '../../layouts/Base.astro';
import { SPEAKER_PORTS } from '../../lib/rack';
import { edgesFor, NODES, type NodeId } from '../../lib/rig';
import { section } from '../../lib/sections';
import { SOURCES } from '../../lib/sources';
import { href } from '../../lib/url';

/** A source document's address, from the one list, so the page and the sources section agree. */
const doc = (title: string): string => {
  const found = SOURCES.flatMap((g) => g.sources).find((s) => s.title === title);
  if (!found) throw new Error(`No source titled "${title}"`);
  return found.url;
};
const MANUAL = doc('XDJ-RX2 Operating Instructions');
const QUICK_START = doc('XDJ-RX2 Quick Start Guide and specifications');
const DBX = doc('DriveRack PA2 Owner’s Manual');
const QSC = doc('GX3, GX5 and GX7 user manual');
const HOWLER = doc('Recorder+Streamer MK1 manual');
const RANE = doc('Sound System Interconnection (RaneNote 110)');
const ACHAT = doc('Achat 104 A user manual');

/** A no-break space, between a number and its unit. */
const nb = ' ';
const MINUS = '−';

/** What kind of card each is, on the right of its title strip. */
const REFERENCE = 'Reference';

/** A card's step, as the Procedure component sets it: the control, the state, a note under it. */
interface Step {
  challenge: string;
  response: string;
  note?: string;
}

// ---- Links to printed pages --------------------------------------------------------------------

interface Cite {
  label: string;
  url: string;
}

/** A page of Pioneer's Operating Instructions or Quick Start Guide: the PDF numbers them as printed. */
const oiPage = (page: number) => `${MANUAL}#page=${page}`;
const qsgPage = (page: number) => `${QUICK_START}#page=${page}`;
/** A page of dbx's manual. Its PDF has two unnumbered pages first: printed page n is PDF page n + 2. */
const dbxPage = (page: number) => `${DBX}#page=${page + 2}`;
/** A page of QSC's GX manual: the PDF numbers them as printed. */
const qscPage = (page: number) => `${QSC}#page=${page}`;

const OI = (page: number): Cite => ({ label: `XDJ manual p.${nb}${page}`, url: oiPage(page) });
const QSG = (page: number): Cite => ({ label: `XDJ quick start p.${nb}${page}`, url: qsgPage(page) });
const DBXP = (page: number): Cite => ({ label: `dbx manual p.${nb}${page}`, url: dbxPage(page) });
const QSCP = (page: number): Cite => ({ label: `QSC GX manual p.${nb}${page}`, url: qscPage(page) });

// ---- S2: the rig as a table ---------------------------------------------------------------------

interface RigRow {
  /** The part, as the guide's drawing names it. */
  node: NodeId;
  /** Show the drawing's second line after the name ("QSC GX7"). */
  withSub?: boolean;
  /** How the lead is made, after the socket's name: "XLR, L and R". */
  lead?: string;
  /** A second line under the feed: what the lead should be. */
  leadNote?: string;
  /** What it's set to: the response, in the action colour. Empty for nothing to set. */
  set: string;
  /** A second line under the setting. */
  setNote?: string;
  /** The card that sets the rest: "See S4." A path with no code is a card on another page. */
  see?: { code: string; path: string; for?: string };
  sources: Cite[];
}

/** Each part in signal order: the PA's branch, the recorder's, then the booth monitors'. */
const RIG_ROWS: RigRow[] = [
  {
    node: 'masterLevel',
    set: 'MASTER meters on the first orange (0), at soundcheck',
    setNote: 'It sets MASTER 1 and MASTER 2 together. It stays for the night, unless F1 turns it down.',
    see: { code: 'C1', path: href('/night/#doors') },
    sources: [OI(27), OI(31)],
  },
  {
    node: 'driverack',
    lead: `XLR, L and R`,
    set: `input switch on +4${nb}dBu`,
    see: { code: 'S4', path: '#driverack' },
    sources: [QSG(20), DBXP(7)],
  },
  {
    // dbx p. 53, a 2-way system: the lows go out of the LOW outputs to the subs, the highs out of the
    // HIGH outputs to the full-range mains, and the MID outputs are off.
    node: 'amps',
    withSub: true,
    lead: 'LOW and HIGH, L and R',
    leadNote: 'LOW to the bottom amp, for the subs. HIGH to the top amp, for the tops. These leads stay in the rack.',
    set: 'FULL RANGE',
    setNote: 'Gain knobs up to the room’s volume, CLIP lights dark.',
    see: { code: 'S4', path: '#driverack' },
    sources: [DBXP(53), QSCP(6)],
  },
  {
    node: 'howler',
    lead: 'RCA, L and R',
    leadNote: `One stereo RCA lead, under 3${nb}m, with nothing else in it.`,
    set: 'WAV',
    setNote: 'A FAT32 microSD card. For the MK1, Howler says A2 cards and SanDisk’s Ultra and Pro cards do not work.',
    sources: [QSG(20), { label: 'RaneNote 110', url: RANE }, { label: 'Howler manual', url: HOWLER }],
  },
  {
    node: 'booth',
    set: 'left to the DJ',
    setNote: 'It sets only the booth monitors.',
    sources: [OI(27)],
  },
  {
    node: 'monitor',
    lead: '¼″ jacks, L and R',
    leadNote: 'Balanced leads, each into a monitor’s INPUT.',
    set: '',
    sources: [OI(10), QSG(20), { label: 'Achat 104 A manual', url: ACHAT }],
  },
];

/**
 * What feeds a part, by lead: a socket by its printed name, anything else as "the DriveRack PA2".
 * The limiter is inside the DriveRack, so the amps' lead comes from the DriveRack itself.
 */
function feed(id: NodeId): string {
  const edges = edgesFor();
  let from = edges.find((e) => e.to === id)?.from;
  if (from === 'limiter') from = edges.find((e) => e.to === 'limiter')?.from;
  if (!from) throw new Error(`Nothing feeds ${id}`);
  const node = NODES[from];
  if (node.printed) return node.label;
  return node.kind === 'bus' ? `the ${node.label.toLowerCase()}` : `the ${node.label}`;
}

const rigRows = RIG_ROWS.map((r, i) => {
  const node = NODES[r.node];
  return {
    ...r,
    ref: String(i + 1),
    unit: node.label,
    sub: r.withSub ? node.sub : undefined,
    from: feed(r.node),
  };
});

const signal = section('signal');

// ---- S4: the DriveRack and the amps -------------------------------------------------------------

// dbx's manual: the input switch, out for +4 dBu (p. 7); on −10 dBV the input clips about 10 dB early
// (p. 5, the INPUT meter table). PIN 1 LIFT, printed so on the back, is best left out (p. 7). The STORE light shows an unstored change (p. 25). QSC:
// an amp's CLIP light is its limit (p. 5), and FULL RANGE leaves the DriveRack to split the bands
// (p. 6). These switches sit at the back of the rack, behind the leads.
const S4_STEPS: Step[] = [
  {
    challenge: 'DriveRack input switch',
    response: `+4${nb}dBu, out`,
    note: `On ${MINUS}10${nb}dBV the input clips about 10${nb}dB earlier (dbx p.${nb}5).`,
  },
  { challenge: 'PIN 1 LIFT', response: 'out' },
  {
    challenge: 'Both GX7 amps',
    response: 'FULL RANGE',
    note: 'The DriveRack already splits the subs from the tops.',
  },
  {
    challenge: 'DriveRack',
    response: 'STORE light off',
    note: `A lit STORE light means a setting has changed (dbx p.${nb}25). If it is lit, ask the rig owner before use.`,
  },
  {
    challenge: 'Four amp gain knobs',
    response: 'set by ear at soundcheck, CLIP lights dark',
    note: `An amp’s CLIP light is its limit (QSC p.${nb}5).`,
  },
];

// The index names each card by its code, as the cards do.
const contents: ContentsEntry[] = [
  { id: 'wiring', number: 'S2', label: 'Wiring' },
  { id: 'driverack', number: 'S4', label: 'DriveRack and amps' },
];

/** Where a link to a card that has gone lands now. C1 sets the levels that S3, T2 and T3 tested. */
const moved = {
  setup: '/night/#doors',
  'record-level': '/night/#doors',
  'test-att': '/night/#doors',
  'test-master-level': '/night/#doors',
  wizard: '/setup/#driverack',
  'amp-gains': '/setup/#driverack',
};
---

<Base
  title="Rig reference"
  description="What feeds what on the rig, and how each unit is set. Event preparation is in Crew’s Before doors checklist."
>
  <PageHeader title="Rig reference" lede="What feeds what, and how each unit is set.">
    <p>To prepare for an event, use <a href={href('/night/#doors')}>Before doors (C1)</a>. Come here if a lead or a setting looks wrong.</p>
  </PageHeader>

  <div class="flow page-body">
    <Contents entries={contents} rows={contents.length + 1} />
    <LegacyAnchors map={moved} />

    <!-- The table needs the page's wide column; its card has no steps, only the table. -->
    <div class="subflow">
      <div class="wide wiring">
        <Procedure id="wiring" number="S2" title="Wiring" kind={REFERENCE} level={2} steps={[]}>
          <p>The rack holds the top amp, the DriveRack PA2 and the bottom amp. The leads between the three stay in.</p>
          <ul class="ports">{SPEAKER_PORTS.map((port) => <li>{port.amp}, {port.channels}: {port.destination}.</li>)}</ul>
          <!-- Wide: a table, one row per part. Narrow: the same rows as a list, each field labelled. -->
          <table class="rig-table">
            <caption class="visually-hidden">What feeds each part of the rig, and how it’s set</caption>
            <thead>
              <tr>
                <th scope="col" class="ref">Ref</th>
                <th scope="col">Unit</th>
                <th scope="col">Fed from</th>
                <th scope="col">Set to</th>
                <th scope="col">Source</th>
              </tr>
            </thead>
            <tbody>
              {
                rigRows.map((r) => (
                  <tr>
                    <td class="ref">{r.ref}</td>
                    <th scope="row" class="unit">
                      {r.unit}
                      {r.sub && <span class="sub">{r.sub}</span>}
                    </th>
                    <td>
                      {r.from}
                      {r.lead && <span>({r.lead})</span>}
                      {r.leadNote && <span class="sub">{r.leadNote}</span>}
                    </td>
                    <td>
                      {r.set && <span class="set">{r.set}</span>}
                      {r.setNote && <span class="sub">{r.setNote}</span>}
                      {r.see && (
                        <span class="sub">
                          See <a href={r.see.path}>{r.see.code}</a>{r.see.for ? ` for ${r.see.for}.` : '.'}
                        </span>
                      )}
                    </td>
                    <td>
                      <span class="cites">
                        {r.sources.map((c) => (
                          <a href={c.url} rel="external">
                            {c.label}
                          </a>
                        ))}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <ol class="rig-list">
            {
              rigRows.map((r) => (
                <li>
                  <p class="unit">
                    <span class="ref">{r.ref}</span>
                    <span>
                      {r.unit}
                      {r.sub && <span class="sub-inline">{r.sub}</span>}
                    </span>
                  </p>
                  <dl>
                    <div>
                      <dt>Fed from</dt>
                      <dd>
                        {r.from}
                        {r.lead && <span>({r.lead})</span>}
                        {r.leadNote && <span class="sub">{r.leadNote}</span>}
                      </dd>
                    </div>
                    {r.set && (
                      <div>
                        <dt>Set to</dt>
                        <dd>
                          <span class="set">{r.set}</span>
                          {r.setNote && <span class="sub">{r.setNote}</span>}
                          {r.see && (
                            <span class="sub">
                              See <a href={r.see.path}>{r.see.code}</a>{r.see.for ? ` for ${r.see.for}.` : '.'}
                            </span>
                          )}
                        </dd>
                      </div>
                    )}
                    <div>
                      <dt>Source</dt>
                      <dd>
                        <span class="cites">
                          {r.sources.map((c) => (
                            <a href={c.url} rel="external">
                              {c.label}
                            </a>
                          ))}
                        </span>
                      </dd>
                    </div>
                  </dl>
                </li>
              ))
            }
          </ol>
          <p class="next">
            The drawing in <a href={href(`/learn/#${signal.id}`)}>{signal.number} {signal.title}</a> shows what each part feeds.
          </p>
        </Procedure>
      </div>
    </div>

    <div class="section-start">
      <Procedure id="driverack" number="S4" title="DriveRack and amp settings" kind={REFERENCE} level={2} steps={S4_STEPS}>
        <p>The three switches are at the back of the rack, which faces the DJ. The STORE light, the gain knobs and the CLIP lights are at the front, which faces the crowd. If the DriveRack’s input CLIP lights come on, use <a href={href('/night/#fix-driverack-clip')}>F6</a>.</p>
        <p class="source">
          dbx’s DriveRack PA2 manual (<a href={dbxPage(5)} rel="external">p.{nb}5</a> for the INPUT meters and CLIP
          lights, <a href={dbxPage(7)} rel="external">p.{nb}7</a> for the input switch and PIN 1 LIFT,
          <a href={dbxPage(25)} rel="external">p.{nb}25</a> for the STORE light), and QSC’s GX manual (<a href={qscPage(5)} rel="external">p.{nb}5</a> for the gain
          knobs and CLIP lights, <a href={qscPage(6)} rel="external">p.{nb}6</a> for FULL RANGE).
        </p>
      </Procedure>
    </div>
  </div>
</Base>

<style>
  /* One card to a row of the page's grid, so the rail runs beside all of them. The card with the
     table keeps the page's columns, so the table can take the wide one. */
  .subflow {
    grid-column: full;
    row-gap: var(--gap-text);
    align-content: start;
  }

  @media (min-width: 80rem) {
    .subflow {
      grid-column: rail-end / full-end;
    }
  }

  /* ---- S2: the rig table ---------------------------------------------------------------------- */

  /* The card has no steps: the table is its body. */
  .wiring {
    container-type: inline-size;
  }

  .rig-table {
    display: none;
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .rig-table th,
  .rig-table td {
    padding: 0.55rem 0.9rem 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  .rig-table thead th {
    padding-block: 0 0.45rem;
    border-bottom: 2px solid var(--ink);
    font-weight: 700;
    color: var(--ink-2);
  }

  .rig-table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .rig-table .ref {
    width: 2.25rem;
    font-weight: 700;
  }

  .rig-table .unit {
    font-weight: 700;
    white-space: nowrap;
  }

  .sub {
    display: block;
    margin-top: 0.15rem;
    font-weight: 400;
    color: var(--ink-2);
  }

  .sub-inline {
    margin-inline-start: 0.4em;
    font-weight: 400;
    color: var(--ink-2);
  }

  /* The setting is what to do, so it's in the action colour, as a checklist's response is. */
  .set {
    font-weight: 700;
    color: var(--action);
  }


  /* Sources: one to a line in the table; in the list they run on, one after another. */
  .cites {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
  }

  .rig-table .cites {
    flex-direction: column;
    align-items: start;
  }

  .cites a {
    white-space: normal;
  }

  .rig-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rig-list > li {
    display: grid;
    gap: 0.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .rig-list > li:first-child {
    padding-top: 0.1rem;
  }

  .rig-list .unit {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    font-weight: 700;
  }

  .rig-list dl {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 0 1.6rem;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .rig-list dl > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: 0.75rem;
  }

  .rig-list dt {
    color: var(--ink-2);
  }

  .rig-list dd {
    margin: 0;
  }

  @container (max-width: 26rem) {
    .rig-list dl {
      margin-inline-start: 0;
    }

    .rig-list dl > div {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.15rem;
    }
  }

  /* Wide enough for six columns: the table, and the list goes. */
  @container (min-width: 44rem) {
    .rig-table {
      display: table;
    }

    .rig-list {
      display: none;
    }
  }

  .next {
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  @media print {
    /* Block flow fragments reliably across paper pages; a tall grid can overlap its following note. */
    .rig-list { display: block; }
    .rig-list > li { break-inside: avoid-page; }
    /* Keep the linked manual/page labels; repeated long URLs overwhelm this compact reference. */
    .rig-list .cites a::after { content: none; }
  }

  .ports { margin: 0; padding-left: 1.2rem; font-size: var(--text-sm); }
</style>
