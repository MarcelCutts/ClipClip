---
import { REVISION } from '../lib/revision';
import { href } from '../lib/url';
import OfflineGuide from './OfflineGuide.astro';

// Only the guide has demos, so only the guide's footer says what they are.
const onGuide = Astro.url.pathname.replace(/\/+$/, '') === href('/learn/').replace(/\/+$/, '');
// Every page, by the name in its own title: the header's three, the crew's other three, then the sources.
const links = [
  { path: '/', label: 'Playing' },
  { path: '/night/', label: 'Crew' },
  { path: '/learn/', label: 'Learn' },
  { path: '/setup/', label: 'Rig reference' },
  { path: '/recordings/', label: 'Recordings' },
  { path: '/print/', label: 'Print kit' },
  { path: '/learn/#sources', label: 'Sources' },
];
---

<footer class="site-footer flow">
  <div class="inner">
    <OfflineGuide />
    <p>
      Made for the DJs and crew at our nights.{
        onGuide &&
          ' The sounds on this page are synthesised in your browser. The demos use a simplified model of the mixer. It clips the way real gear does, only more neatly.'
      }
    </p>
    <ul class="link-row">
      {links.map((l) => (
  <li><a href={href(l.path)}>{l.label}</a></li>
))}
    </ul>
    <p>Printed cards: {REVISION}. <a href={href('/print/')}>Check or print the current kit</a>.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .inner {
    display: grid;
    gap: 0.75rem;
  }

</style>
