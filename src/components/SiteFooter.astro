---
import { href } from '../lib/url';

const links = [
  { path: '/#sources', label: 'Sources' },
  { path: '/night/', label: 'On the night' },
  { path: '/setup/', label: 'Setting up' },
  { path: '/print/', label: 'Print kit' },
];
---

<footer class="site-footer flow">
  <div class="inner">
    <p>
      Made for the DJs and crew at our nights. The sounds on this site are synthesised in your browser. The demos use a
      simplified model of the mixer, which clips more neatly than real gear does, but in the same way.
    </p>
    <ul class="links">
      {links.map((l) => (
  <li><a href={href(l.path)}>{l.label}</a></li>
))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .inner {
    display: grid;
    gap: 0.75rem;
  }

  /* Spaced apart, with nothing printed between them. */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-block;
    padding-block: 0.25rem;
  }
</style>
