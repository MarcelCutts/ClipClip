---
/**
 * A "Know by heart" box: the few things to know without looking, set like a quick reference
 * handbook's boxed items, numbered from 1 in every box. Each line is a challenge and its response,
 * joined by leader dots (a screen reader hears a comma), with a note on what to do if it isn't so,
 * then a link: the drill for it on the crew page, by its code and title ("F1: Howler LEVEL light:
 * red"), or the section of Playing that explains it, by a short name ("Set TRIM"). A long response
 * drops to its own line, right-aligned, as on a printed checklist.
 * Pale yellow by day, dim yellow edged in yellow on the dark display.
 */
import { drillAnchor, FIXES } from '../lib/fixes';
import type { Rule } from '../lib/rules';
import { section, sectionPath } from '../lib/sections';
import { href } from '../lib/url';

interface Props {
  title: string;
  rules: Rule[];
  /** Link each item to its drill, or to where the guide explains it. */
  refs?: boolean;
}

const { title, rules, refs = true } = Astro.props;
const id = `kbh-${title.toLowerCase().replace(/[^a-z]+/g, '-')}`;

/** Where a line points: its drill if it has one, otherwise its guide section. */
function refFor(rule: Rule): { code: string; title: string; path: string } | undefined {
  if (rule.drill) {
    const fix = FIXES.find((f) => f.id === rule.drill);
    if (!fix) throw new Error(`No drill with the id "${rule.drill}"`);
    // The code comes first, as the drills' own list has it, so the link cannot read as part of the note.
    return { code: fix.code, title: `${fix.code}: ${fix.title}`, path: `/night/#${drillAnchor(fix.id)}` };
  }
  if (rule.why) {
    const { number, title } = section(rule.why);
    return { code: number, title: ({ trim: 'Set TRIM', blends: 'Fix a blend', knobs: 'Whose controls' } as Record<string, string>)[rule.why.replace(/^#/, '')] ?? title, path: sectionPath(rule.why) };
  }
  return undefined;
}
---

<section class="kbh">
  <h2 id={id} class="kbh-title">{title}</h2>
  <ol class="items">
    {rules.map((r) => {
  const ref = refs ? refFor(r) : undefined;
  return (
  <li class="item">
    <p class="line">
      <span class="challenge">{r.challenge}</span><span class="visually-hidden">, </span>
      <span class="dots" aria-hidden="true"></span>
      <span class="response">{r.response}</span>
    </p>
    <p class="note">
      {r.note}
      {ref && (
      <Fragment>
        {' '}<a class="ref" href={href(ref.path)}>{ref.title}</a>
      </Fragment>
    )}
    </p>
  </li>
  );
})}
  </ol>
</section>

<style>
  .kbh {
    display: grid;
    gap: 0.5rem;
    padding: 0.85rem 1rem 0.35rem;
    background: var(--tint);
    border: 2px solid var(--tint-edge);
  }

  .kbh-title {
    font-size: var(--text-rule);
    line-height: 1.25;
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: kbh;
  }

  .item {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    column-gap: 0.25rem;
    padding-block: 0.7rem;
    border-top: 1px solid color-mix(in srgb, var(--tint-edge) 22%, transparent);
    counter-increment: kbh;
  }

  .item::before {
    content: counter(kbh);
    grid-row: 1;
    font-weight: 700;
    font-size: var(--text-rule);
    line-height: 1.35;
  }

  /* Challenge, dots, response. When the response doesn't fit, it wraps to its own line and sits
     at the right, and the dots run to the end of the first line. */
  .line {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.4rem;
    font-size: var(--text-rule);
    line-height: 1.35;
  }

  .challenge {
    font-weight: 700;
  }

  .dots {
    flex: 1 1 2.5rem;
    min-width: 2.5rem;
    border-bottom: 2px dotted var(--ink-4);
    transform: translateY(-0.3em);
  }

  .response {
    margin-inline-start: auto;
    font-weight: 700;
    color: var(--action);
    text-align: right;
  }

  .note {
    grid-column: 2;
    margin-block-start: 0.2rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink);
  }

  .ref {
    white-space: normal;
    font-weight: 700;

  }

  @media (forced-colors: active) {
    .kbh {
      border-color: CanvasText;
    }
  }

  @media print {
    .kbh {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .ref {
      display: none;
    }
  }
  @media screen and (max-width: 40rem) {
    .line { display: grid; gap: 0.15rem; text-align: left; }
    .dots { display: none; }
    .response { margin-inline-start: 0; text-align: left; text-wrap: pretty; }
  }
</style>
