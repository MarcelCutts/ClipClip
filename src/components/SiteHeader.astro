---
import { href } from '../lib/url';

const here = Astro.url.pathname.replace(/\/+$/, '');
const isCurrent = (path: string) => here === href(path).replace(/\/+$/, '');
// The site's name is at the top left of every page, Playing included, and each page's own title
// names the page. Three entrances, by what a reader came to do: play a set, run the night, or learn
// why. The crew's other pages (the rig reference, the recordings, the print kit) are one step from
// Crew, and every page is in the footer. Three fit one line beside the name on a 360-pixel phone.
const links = [
  { path: '/', label: 'Playing' },
  { path: '/night/', label: 'Crew' },
  { path: '/learn/', label: 'Learn' },
];
---

<header class="site-header">
  <a class="mark" href={href('/')}>Out of the red</a>
  <nav aria-label="Site">
    <ul>
      {links.map((l) => (
  <li>
    <a href={href(l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined}>
      {l.label}
    </a>
  </li>
))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    /* The name and the three links share one line from 360 pixels up. */
    gap: 0 clamp(0.75rem, 4vw, 1.75rem);
    border-bottom: 2px solid var(--ink);
    padding: 0.5rem var(--gutter) 0;
    max-width: calc(var(--wide) + 2 * var(--gutter));
    margin-inline: auto;
  }

  .mark {
    display: inline-block;
    padding-block: 0.7rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.0625rem, 0.9rem + 1vw, 1.1875rem);
    line-height: 1;
    color: var(--ink-bright);
    text-decoration: none;
    white-space: nowrap;
  }

  /* The three task entrances stay readable on narrow phones. */
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(0.9rem, 3.5vw, 1.25rem);
    list-style: none;
    padding: 0;
  }

  nav a {
    white-space: nowrap;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    /* At least 44px tall for thumbs. */
    padding-block: 0.75rem;
    font-size: var(--text-sm);
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink-bright);
  }

  /* The page you're on is underlined. Lit colours are kept for signal levels. */
  nav a[aria-current='page'] {
    color: var(--ink-bright);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  /* Where the name and the links share a line, the links stay at the right. */
  @media (min-width: 48rem) {
    nav {
      margin-inline-start: auto;
    }

    ul {
      gap: 0 1.35rem;
    }
  }

  @media (min-width: 80rem) {
    .site-header {
      /* The frame plus the same 1rem margins the page grid keeps, so its edges line up. */
      max-width: calc(var(--frame) + 2rem);
      padding-inline: 1rem;
    }
  }
</style>
