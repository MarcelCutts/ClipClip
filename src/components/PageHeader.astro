---
/**
 * The title block, the same on every page: the page's name, one sentence on what it is for, then
 * anything a reader needs before the page's first block (a way out to another page, a row of links).
 * It sits one title space under the header's rule and ends one block gap above what follows, so no
 * page sets those distances itself.
 * Pass the lede as a string, or in the "lede" slot when it needs markup such as <Term>.
 */
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
const hasLede = Boolean(lede) || Astro.slots.has('lede');
---

<header class="page-header flow">
  <h1>{title}</h1>
  {hasLede && <p class="lede">{lede}<slot name="lede" /></p>}
  <slot />
</header>

<style>
  .page-header {
    padding-block: var(--space-title) var(--gap-block);
    row-gap: var(--gap-text);
  }

  h1 {
    font-size: var(--text-page);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
</style>
