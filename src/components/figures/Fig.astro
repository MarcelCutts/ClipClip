---
/**
 * A figure for the crew: a line drawing on the page, labelled directly, with what it shows said in
 * words above it. Drawn for a phone in the dark: few words, large, and nothing carried by colour alone.
 *
 * One drawing language for every figure (the classes below, shared through :global):
 * - `.is` a thin line: what is there, and stays as it is;
 * - `.do` a heavy line in the action colour: what the crew plug, turn or move;
 * - `.lead` a lead the crew run;
 * - `.t` a label, `.b` a bold one, `.m` a quieter one.
 * The page's tokens colour it, so it turns with the theme, and prints as ink on paper.
 */
interface Props {
  /** Where links land: /night/#rack. Undefined where the drawing is no link's target. */
  id?: string | undefined;
  /** What the drawing shows, as a short name. */
  title: string;
  /** The one thing to take from it, as a sentence or two. */
  note?: string;
}
const { id, title, note } = Astro.props;
---

<figure class="fig" id={id}>
  <figcaption>
    <span class="fig-title">{title}</span>
    {note && <span class="fig-note">{note}</span>}
  </figcaption>
  <slot />
</figure>

<style>
  .fig {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-block: 0.25rem 0.5rem;
  }

  figcaption {
    display: grid;
    gap: 0.15rem;
  }

  .fig-title {
    font-weight: 700;
    color: var(--ink-bright);
  }

  .fig-note {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .fig :global(svg) {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
  }

  .fig :global(text) {
    font-family: var(--font-body);
    font-size: 15px;
    fill: var(--ink);
  }

  .fig :global(.b) {
    font-weight: 700;
  }

  .fig :global(.m) {
    fill: var(--ink-2);
  }

  .fig :global(.is) {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* A solid part, such as a wheel or a case: the page's shaded tone, so it reads as a thing. */
  .fig :global(.solid) {
    fill: var(--paper-2);
  }

  .fig :global(.do) {
    fill: var(--paper);
    stroke: var(--action);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* A light to watch: a heavy ink outline, since nobody turns or plugs it. */
  .fig :global(.see) {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .fig :global(.do-fill) {
    fill: var(--action);
    stroke: none;
  }

  .fig :global(.lead) {
    fill: none;
    stroke: var(--action);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fig :global(.ground) {
    fill: none;
    stroke: var(--ink-4);
    stroke-width: 1.5;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }

  .fig :global(.pin) {
    fill: var(--ink);
    stroke: none;
  }

  .fig :global(.arrow) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (forced-colors: active) {
    .fig :global(.is),
    .fig :global(.do),
    .fig :global(.see),
    .fig :global(.lead),
    .fig :global(.arrow) {
      stroke: CanvasText;
    }

    .fig :global(text) {
      fill: CanvasText;
    }
  }

  @media print {
    .fig {
      break-inside: avoid;
    }

    .fig :global(svg) {
      max-width: 110mm;
    }
  }
</style>
