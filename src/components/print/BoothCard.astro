---
/**
 * The booth card: an A6 landscape card (148 × 105 mm), laminated and kept by the mixer. It's the
 * DJs' "Know by heart" box as a quick reference handbook's card: pale yellow, under a black title
 * strip, with the three DJ lines as challenge and response joined by leader dots and what to do if
 * it isn't so, a line drawing of the XDJ-RX2's meters as they should look, and a QR code to the
 * guide (/#trim). The lines come straight from DJ_RULES, so the card says what the guide's box says.
 * The drawing is Playing's (MeterTargets.astro) in small: lit as a blend at its loudest, with a ring
 * round the channels' first orange and round the MASTER pair's top orange, and each named beside it.
 * Under them: that every set here is recorded, a blank for the crew's name, written on the laminate
 * each night, and the date the card's words last changed, to check it against the site.
 * One wiring: MASTER LEVEL is the crew's (it sets the speakers and the recording), BOOTH MONITOR is the DJ's.
 *
 * Print sizes: the three lines 14 pt, every sentence 10 pt or more, every label on the drawing 7 pt
 * or more. Everything inside is sized in em from a base set in container units, so the card scales
 * to fit a phone on screen and prints at exactly A6. It prints black on white on pale yellow: the
 * card and its strip ask the browser to print their backgrounds, and the LEDs and the QR code are SVG
 * shapes, which print whatever the "background graphics" setting. The print page shows it on paper
 * in either theme, so it keeps its yellow on a dark screen too.
 */
import QRCode from 'qrcode';
import { CARD_METER_PLACES } from '../../lib/figures';
import { CARD_PATH } from '../../lib/messages';
import { TARGET_PEAK_DB } from '../../lib/model';
import { DJ_RULES } from '../../lib/rules';
import { href } from '../../lib/url';
import { CEILING_DB, METER_SEGMENTS, scaleLabel } from '../../lib/xdj';

interface Props {
  /** When the card's words last changed: "26 September 2026". */
  revised: string;
}

const { revised } = Astro.props;

// The guide, at setting TRIM: the first thing on Playing that the card does not carry. The QR code
// carries the #trim; the typed address doesn't need it, since the guide's top is a fine place to land too.
const url = new URL(href(CARD_PATH), Astro.site ?? Astro.url);
// The address in words, breakable after each dot and slash so a long one wraps cleanly.
const address = `${url.host}${url.pathname}`.replace(/([./])/g, '$1<wbr>');

// QR code, drawn as one path of dark runs. Two modules of quiet zone, plus the card's white space.
const qr = QRCode.create(url.toString(), { errorCorrectionLevel: 'M' });
const quiet = 2;
const qrSize = qr.modules.size + quiet * 2;
let qrPath = '';
for (let row = 0; row < qr.modules.size; row++) {
  for (let col = 0; col < qr.modules.size; ) {
    if (!qr.modules.get(row, col)) {
      col++;
      continue;
    }
    let run = 1;
    while (col + run < qr.modules.size && qr.modules.get(row, col + run)) run++;
    qrPath += `M${col + quiet} ${row + quiet}h${run}v1h-${run}z`;
    col += run;
  }
}

// The meter bridge, as printed on the unit: CH1, the MASTER pair, CH2, with the scale between.
// A unit prints at about 0.9 mm (the drawing is 15.6em tall), so the font sizes below print at about
// 8 pt (column names), 7.2 pt (scale and CLIP) and 9.5 pt (zones). As on every meter on the site,
// the colours don't work alone: a printed break sits where the colour changes, and 0 is bold.
const pitch = 3.5;
const ledH = 2;
const top = 9.4;
/** The extra space of the break where the colour changes. */
const BREAK = 1.2;
const rows: ((typeof METER_SEGMENTS)[number] & { y: number })[] = [];
for (const seg of [...METER_SEGMENTS].reverse()) {
  const prev = rows.at(-1);
  rows.push({ ...seg, y: prev ? prev.y + pitch + (prev.zone === seg.zone ? 0 : BREAK) : top });
}
const bottom = rows.at(-1)!.y + pitch;
const frame = { w: 30, h: bottom + 4.2 };
/** Baseline for a label of this size, centred on a height: half its cap height below the middle. */
const centreOn = (middle: number, size: number) => middle + size * 0.36;
const TICK = 2.8;
const ZONE = 3.7;
const rowOf = (db: number) => rows.find((r) => r.db === db)!;
// Brackets down the right-hand side, each spanning the LEDs from one level to another, named one
// line per entry. The two meters have different jobs. A channel meter has a target, the first orange
// (0). The MASTER meters have a limit: a blend of two lined-up tracks adds up to two lights (3 and
// 6), and the top orange (9) stays dark. Red is where Pioneer says the sound may distort. The levels
// come from model.ts and xdj.ts, as on every meter on the site.
const zone = (from: number, to: number, name: string[]) => ({
  y1: rowOf(from).y - 0.35,
  y2: rowOf(to).y + ledH + 0.35,
  name,
});
const { aim, blend, top: topOrange } = TARGET_PEAK_DB;
/** The light above the aim: where a blend's extra starts to show. */
const blendFrom = METER_SEGMENTS.find((s) => s.db > aim)!.db;
const zones = [
  zone(CEILING_DB, CEILING_DB, [CARD_METER_PLACES.red]),
  zone(topOrange, topOrange, [CARD_METER_PLACES.master]),
  zone(blend, blendFrom, [CARD_METER_PLACES.blend]),
  zone(aim, aim, [CARD_METER_PLACES.channels]),
];
// The columns of lights: CH1, the MASTER pair, CH2. Each is lit as a blend at its loudest.
const columns = [
  { x: 2.5, w: 3, level: aim },
  { x: 12.4, w: 2.2, level: blend },
  { x: 15.4, w: 2.2, level: blend },
  { x: 24.5, w: 3, level: aim },
];
// A ring round the lights each meter's rule is about, on that meter's columns only.
const RING = 0.65;
const ring = (db: number, x: number, w: number) => ({
  x: x - RING,
  y: rowOf(db).y - RING,
  w: w + 2 * RING,
  h: ledH + 2 * RING,
});
const rings = [ring(aim, 2.5, 3), ring(aim, 24.5, 3), ring(topOrange, 12.4, 5.2)];
const bx = frame.w + 1.8;
const lineGap = 3.8;
/** Room for the widest name ("CH1, CH2: aim") to the right of its bracket. */
const labelsW = 25;
const meterLabel = `The meters on the XDJ-RX2: CH1, MASTER and CH2, lit as a blend at its loudest. Channel meters, CH1 and CH2: aim for the first orange light, ${scaleLabel(aim)}, at a track’s loudest part. It is ringed. MASTER meters: keep the top orange light, ${scaleLabel(topOrange)}, dark. It is ringed. ${scaleLabel(blendFrom)} and ${scaleLabel(blend)} are room for a blend, where two tracks add up. The red light at ${scaleLabel(CEILING_DB)} may distort.`;
---

<div class="card-frame">
<article class="booth-card">
  <p class="strip">Know by heart when you’re playing</p>

  <div class="kbh">
    <ol class="items">
      {DJ_RULES.map((r) => (
  <li class="item">
    <p class="line">
      <span class="challenge">{r.challenge}</span><span class="visually-hidden">:</span>
      <span class="dots" aria-hidden="true"></span>
      <span class="response">{r.response}</span>
    </p>
    {r.note && <p class="note">{r.note}</p>}
  </li>
))}
    </ol>
  </div>

  <div class="more">
    <p>Every set here is recorded.</p>
    <p class="crew">Crew tonight: <span class="blank" aria-hidden="true"></span></p>
    <p class="revised">Revised {revised}</p>
  </div>

  <svg class="meters" viewBox={`-0.4 -0.4 ${bx + labelsW} ${frame.h + 0.8}`} role="img" aria-label={meterLabel}>
    <rect class="bridge" x="0" y="0" width={frame.w} height={frame.h} rx="1.2"></rect>
    <text class="col-name" x="4.2" y="3.9">CH1</text>
    <text class="col-name" x="15" y="3.9">MASTER</text>
    <text class="col-name" x="25.8" y="3.9">CH2</text>
    <text class="clip" x="15" y="7.3">CLIP</text>
    {
      rows.map((r) => (
        <g class={`led ${r.zone}`}>
          {columns.map((c) => (
            <rect class:list={{ on: r.db <= c.level }} x={c.x} y={r.y} width={c.w} height={ledH} rx="0.35" />
          ))}
          <text class:list={['tick', { zero: r.db === 0 }]} x="9" y={centreOn(r.y + ledH / 2, TICK)}>
            {scaleLabel(r.db)}
          </text>
          <text class:list={['tick', { zero: r.db === 0 }]} x="21" y={centreOn(r.y + ledH / 2, TICK)}>
            {scaleLabel(r.db)}
          </text>
        </g>
      ))
    }
    <text class="db" x="9" y={bottom + 2.2}>dB</text>
    <text class="db" x="21" y={bottom + 2.2}>dB</text>
    {rings.map((g) => <rect class="ring" x={g.x} y={g.y} width={g.w} height={g.h} rx="0.8" />)}
    {
      zones.map((z) => (
        <>
          <path class="bracket" d={`M${bx - 0.8} ${z.y1}h0.8V${z.y2}h-0.8`} />
          <text class="zone-name" x={bx + 1.3} y={centreOn((z.y1 + z.y2) / 2, ZONE) - ((z.name.length - 1) * lineGap) / 2}>
            {z.name.map((line, i) => <tspan x={bx + 1.3} dy={i > 0 ? lineGap : undefined}>{line}</tspan>)}
          </text>
        </>
      ))
    }
  </svg>

  <div class="scan">
    <p>Scan for the guide <span class="address" set:html={address} /></p>
    <svg class="qr" viewBox={`0 0 ${qrSize} ${qrSize}`} shape-rendering="crispEdges" role="img" aria-label={`QR code: ${url}`}>
      <path d={qrPath}></path>
    </svg>
  </div>
</article>
</div>

<style>
  .card-frame {
    container-type: inline-size;
    width: 148mm;
    max-width: 100%;
    aspect-ratio: 148 / 105;
  }

  .booth-card {
    /* The card's side margin, in the card's own units so every child can use it. */
    --side: 3.4cqi;
    /* Base size: 2.3% of the card's width, so about 9.7 pt when printed at A6. */
    font-size: 2.3cqi;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    /* The box runs down beside the drawing and the QR code, and the line under both runs the width
       of the card. */
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      'strip strip'
      'kbh meters'
      'kbh scan'
      'more more';
    gap: 0.5em 1.3em;
    height: 100%;
    padding: 0 var(--side) 3cqi;
    /* The whole card is the "Know by heart" box: the pale yellow printed checklists use. */
    background: var(--tint);
    color: inherit;
    font-family: var(--font-body);
    line-height: 1.3;
  }

  /* On screen the card may grow past A6, so wider text spacing (WCAG 1.4.12) can't push the words
     or the QR code over the cut lines. On paper it stays exactly A6. */
  @media screen {
    .booth-card {
      height: auto;
      min-height: 100%;
    }
  }

  p {
    margin: 0;
  }

  /* The title strip runs edge to edge across the top, like a handbook card's, with the strips'
     top edge (on paper it's the strip's own colour). */
  .strip {
    grid-area: strip;
    margin-inline: calc(-1 * var(--side));
    padding: 0.45em var(--side) 0.4em;
    background: var(--strip);
    box-shadow: inset 0 2px 0 var(--strip-edge);
    color: var(--on-strip);
    font-size: 1.45em;
    font-weight: 700;
    line-height: 1.2;
  }

  .kbh {
    grid-area: kbh;
    align-self: start;
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: kbh;
  }

  /* 14 pt on paper: the lines to read at arm's length in a dark booth. */
  .item {
    display: grid;
    grid-template-columns: 1.1em minmax(0, 1fr);
    column-gap: 0.25em;
    padding-block: 0.25em 0.3em;
    border-bottom: 0.06em solid color-mix(in srgb, CanvasText 35%, transparent);
    counter-increment: kbh;
    font-size: 1.46em;
  }

  .item:last-child {
    border-bottom: 0;
  }

  .item::before {
    content: counter(kbh);
    font-weight: 700;
    line-height: 1.15;
  }

  /* The challenge, its dots and its response. A response too long for the line drops to the next
     one and sits at the right, as on a printed checklist. */
  .line {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.3em;
    line-height: 1.15;
  }

  .challenge,
  .response {
    font-weight: 700;
  }

  .dots {
    flex: 1 1 1.5em;
    min-width: 1.5em;
    border-bottom: 0.14em dotted currentColor;
    translate: 0 -0.25em;
  }

  .response {
    margin-inline-start: auto;
    text-align: right;
  }

  /* 10 pt on paper: what to do if it isn't so. */
  .note {
    grid-column: 2;
    margin-top: 0.15em;
    font-size: calc(1.04em / 1.46);
    line-height: 1.2;
  }

  /* One line across the foot of the card, 10 pt: the recording, the crew's name written in by hand,
     and the date the words last changed. */
  .more {
    grid-area: more;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2em 1.4em;
    font-size: 1.04em;
    line-height: 1.2;
  }

  .crew {
    display: flex;
    flex: 1 1 auto;
    align-items: baseline;
    gap: 0.4em;
    font-weight: 700;
  }

  /* A ruled line to write on. */
  .blank {
    flex: 1 1 9em;
    min-width: 9em;
    border-bottom: 0.1em solid currentColor;
  }

  /* About 8 pt: a label, not a sentence. */
  .revised {
    font-size: 0.8em;
  }

  .meters {
    grid-area: meters;
    width: auto;
    height: 15.6em;
    align-self: start;
    overflow: visible;
  }

  .bridge {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.3;
  }

  .meters text {
    fill: currentColor;
    font-family: var(--font-label);
    text-anchor: middle;
  }

  /* Labels on the drawing print at 7 pt or more; the column names at about 8 pt. They're the
     unit's own lettering, so they're set in its narrow capitals. */
  .col-name {
    font-size: 3.1px;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .clip {
    font-size: 2.8px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .tick,
  .db {
    font-size: 2.8px;
    font-weight: 600;
  }

  /* 0 is where the orange starts: bold, as on every meter on the site. */
  .tick.zero {
    font-weight: 800;
  }

  /* A dark light is an outline. A lit one is filled with its colour. The red one keeps a red outline,
     so it reads as red while it's dark. */
  .led rect {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.14;
  }

  .led.green rect.on {
    fill: var(--led-g);
  }

  .led.orange rect.on {
    fill: var(--led-a);
  }

  .led.red rect {
    stroke: var(--led-r);
    stroke-width: 0.3;
  }

  /* The lights a rule is about: the channels' first orange, the MASTER pair's top orange. */
  .ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.4;
  }

  .bracket {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.35;
  }

  /* The words the drawing exists for, about 10 pt on paper. Our words, so in the text face. */
  .meters .zone-name {
    font-family: var(--font-body);
    font-size: 3.7px;
    font-weight: 700;
    text-anchor: start;
  }

  .scan {
    grid-area: scan;
    display: flex;
    align-items: end;
    justify-content: end;
    gap: 0.6em;
  }

  /* As wide as the drawing's column allows, so a long Pages address still fits beside the QR code.
     About 8 pt on paper: a label, not a sentence. */
  .scan p {
    max-width: 8em;
    font-size: 0.84em;
    font-weight: 700;
    line-height: 1.25;
    text-align: right;
    text-wrap: balance;
  }

  .address {
    display: block;
    margin-top: 0.25em;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .qr {
    flex: none;
    width: 6.4em;
    height: 6.4em;
    fill: currentColor;
  }

  @media print {
    .booth-card,
    .strip {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }

  @media (forced-colors: active) {
    .strip {
      forced-color-adjust: none;
      background: CanvasText;
      box-shadow: none;
      color: Canvas;
    }
  }
</style>
