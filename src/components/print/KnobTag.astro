---
/**
 * A knob tag for the gear, sized to sit on a strip of 19 mm console tape: 18 mm tall, and 60 mm
 * long unless it says more. Stencil type, black on white. Sizes are in print millimetres, scaled
 * through container units so the on-screen preview shrinks to fit. A long tag's lines are
 * sentences, so they print at 10 pt or more, in the text face. A tag can carry blanks for settings
 * the crew write in by hand, like the REC tape's two attenuators, or a short rule for a tape that
 * marks a limit, like the RIG tape's "No higher than the marks".
 */
interface Props {
  /** The big word, as it would be written on the tape: REC, MONITOR, RIG. */
  name: string;
  /** Whose knob it is, shown after the name: "crew", "yours". */
  owner?: string;
  /** Extra lines for a long-form tag that says why. */
  lines?: readonly string[];
  /** Settings to write in by hand, each printed as its name and a blank line. */
  blanks?: readonly string[] | undefined;
  /** A short rule printed under the name, in the tape's capitals. */
  rule?: string | undefined;
  /** Length in millimetres at print size. */
  width?: number;
}

const { name, owner, lines = [], blanks = [], rule, width = 60 } = Astro.props;
---

<div class="tag-frame" style={`--w: ${width}`}>
  <p class:list={['tag', { long: lines.length > 0, 'with-row': blanks.length > 0 || Boolean(rule) }]}>
    <span class="name">{name}</span>
    {
      owner && (
        <span class="owner">
          <span class="visually-hidden">, </span>
          {owner}
        </span>
      )
    }
    {
      lines.length > 0 && (
        <span class="lines">
          {lines.map((line) => (
            <span class="line">{line} </span>
          ))}
        </span>
      )
    }
    {
      blanks.length > 0 && (
        <span class="blanks">
          <span class="visually-hidden">. Blanks to write in: </span>
          {blanks.map((b, i) => (
            <span class="blank">
              {i > 0 && <span class="visually-hidden">, </span>}
              {b}
              <span class="rule" aria-hidden="true" />
            </span>
          ))}
        </span>
      )
    }
    {
      rule && (
        <span class="limit">
          <span class="visually-hidden">. </span>
          {rule}
        </span>
      )
    }
  </p>
</div>

<style>
  .tag-frame {
    container-type: inline-size;
    width: calc(var(--w) * 1mm);
    max-width: 100%;
    aspect-ratio: var(--w) / 18;
  }

  .tag {
    /* One print millimetre, whatever size the preview is drawn at. */
    --mm: calc(100cqi / var(--w));
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    align-items: baseline;
    justify-content: center;
    gap: 0 calc(var(--mm) * 2);
    height: 100%;
    margin: 0;
    padding: calc(var(--mm) * 1.5) calc(var(--mm) * 3);
    font-family: var(--font-stencil);
    font-optical-sizing: auto;
    line-height: 1;
    white-space: nowrap;
  }

  .name {
    font-size: calc(var(--mm) * 10);
    font-weight: 850;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .owner {
    font-size: calc(var(--mm) * 4.8);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .tag.long {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: center;
    gap: calc(var(--mm) * 1.2);
    padding: calc(var(--mm) * 1.2) calc(var(--mm) * 4);
  }

  .long .name {
    font-size: calc(var(--mm) * 6.2);
  }

  /* 10.2 pt: the smallest a sentence prints. Sentences are set in the text face: the stencil's
     breaks cost legibility at this size in a dim booth. */
  .lines {
    display: grid;
    gap: calc(var(--mm) * 0.5);
    font-family: var(--font-body);
    font-size: calc(var(--mm) * 3.6);
    font-weight: 700;
    letter-spacing: 0;
  }

  /* With blanks or a rule the big word gives up some height, and they take a row of their own. */
  .with-row {
    row-gap: calc(var(--mm) * 1.6);
  }

  .with-row .name {
    font-size: calc(var(--mm) * 8);
  }

  /* About 8.5 pt: labels to write beside, and a rule to read at a glance, not sentences. The blank
     is a ruled line to write on. */
  .blanks,
  .limit {
    display: flex;
    flex-basis: 100%;
    justify-content: center;
    gap: calc(var(--mm) * 3.5);
    font-size: calc(var(--mm) * 3);
    font-weight: 760;
    letter-spacing: 0.03em;
  }

  /* In the tape's stencil capitals, as a limit is stencilled on a flight case. */
  .limit {
    text-transform: uppercase;
  }

  .blank {
    display: inline-flex;
    align-items: baseline;
    gap: calc(var(--mm) * 1);
  }

  .rule {
    display: inline-block;
    width: calc(var(--mm) * 10);
    border-bottom: calc(var(--mm) * 0.3) solid currentColor;
  }

  /* On screen, let a tag wrap and grow rather than spill when a reader widens the text spacing
     (WCAG 1.4.12). Paper keeps the fixed height the tape is cut to. */
  @media screen {
    .tag {
      white-space: normal;
      height: auto;
      min-height: 100%;
    }

    .blank {
      white-space: nowrap;
    }
  }
</style>
