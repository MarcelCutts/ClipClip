---
/**
 * A crew checklist as a laminated quick reference card, landscape: a black title strip with the
 * card's code (C1 to C3), when to run it, each line as the thing to
 * look at and the state it should be in joined by leader dots (with any consequence said before it),
 * and the date the words last changed.
 * Every card is read-and-do, for one person working alone, so it has no time budget and no call to
 * say. A black thumb tab with the code sticks out of the right-hand edge, a step lower on each card,
 * so a stack of them opens at the one you want. Same data as the <Checklist> island on /night/ and
 * /recordings/.
 *
 * Sizes are print millimetres through container units: the printout is exact, and on a wide screen
 * the preview is too. On a narrow screen a millimetre never drops below 3 px, so the preview reflows
 * at a readable size instead of shrinking. Every sentence prints at 10 pt or more.
 */
import { CHECKLISTS, type ChecklistId, type ChecklistItem, drillText } from '../../lib/checklists';

interface Props {
  list: ChecklistId;
  /** When the card's words last changed, printed at its foot: "26 September 2026". */
  revised: string;
  /** The size of the lines and strip, relative to the other cards.
   * Notes stay at 10 pt whatever it is. */
  scale?: number;
  /** Flow the lines into two columns. */
  columns?: 1 | 2;
  /** C1 is printed across two cards; the maintained checklist stays one sequence. */
  part?: 1 | 2;
}

const { list: id, revised, scale = 1, columns = 1, part } = Astro.props;
const list = CHECKLISTS[id];
/** C1's second card starts where the sound does: at its levels. */
const split = list.items.findIndex((item) => item.group === 'Levels');
const items = part === 1 ? list.items.slice(0, split) : part === 2 ? list.items.slice(split) : list.items;
const start = part === 2 ? split : 0;

/** The cards as they stack, top tab first: the night's three in order; C1 has two consecutive parts. */
const STACK: readonly ChecklistId[] = ['doors', 'changeover', 'after'];

/** Under a line: its note, then the drill for when it isn't so ("If it blinks red, go to F1."), as on /night/. */
const noteOf = (item: ChecklistItem): string =>
  [item.note, item.drill && drillText(item.drill), item.help?.label].filter(Boolean).join(' ');
---

<div class="card-frame" style={`--tab: ${STACK.indexOf(id)}; --scale: ${scale}`}>
  <article class="qrh-card" data-columns={columns}>
    <div class="body">
      <p class="strip">
        <span><span class="code">{list.code}</span>{list.title}{part && ` · ${part}/2`}</span>
      </p>
      <p class="how"><strong>{list.when}</strong></p>
      <ol class="items" style={`counter-reset: line ${start}`}>
        {
          items.map((item) => (
            <li class="item">
              {item.group && <p class="group">{item.group}</p>}
              {item.before && <p class="before">{item.before}</p>}
              <p class="line">
                <span class="check">{item.check}</span>
                <span class="visually-hidden">:</span>
                <span class="dots" aria-hidden="true" />
                <span class="target">{item.target}</span>
              </p>
              {noteOf(item) && <p class="note">{noteOf(item)}</p>}
            </li>
          ))
        }
      </ol>
      {part === 1 && <p class="continue">Continue with C1, part 2.</p>}
      <p class="revised">Revised {revised}</p>
    </div>
    <p class="tab" aria-hidden="true">{list.code}</p>
  </article>
</div>

<style>
  /* 190 mm wide at print size: the card, and its thumb tab sticking out 12 mm. */
  .card-frame {
    container-type: inline-size;
    width: 190mm;
    max-width: 100%;
  }

  .qrh-card {
    /* One print millimetre, whatever size the preview is drawn at, and one point. */
    --mm: calc(100cqi / 190);
    --pt: calc(var(--mm) * 0.3528);
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(var(--mm) * 12);
    align-items: start;
    height: 100%;
    font-family: var(--font-body);
    line-height: 1.3;
  }

  /* A narrow screen: keep the words readable and let the card reflow. */
  @media screen {
    .qrh-card {
      --mm: max(100cqi / 190, 3px);
    }
  }

  p {
    margin: 0;
  }

  /* The card itself, inside its cut line. The spacing is as tight as reads well: C2 and C3 share an A4 sheet; C1 has two parts. */
  .body {
    display: grid;
    align-content: start;
    gap: calc(var(--mm) * 2.2);
    height: 100%;
    padding-bottom: calc(var(--mm) * 3.8);
    border: 0.3mm dashed var(--cut, color-mix(in srgb, CanvasText 50%, Canvas));
    background: Canvas;
    color: CanvasText;
    font-size: calc(var(--pt) * 12.5 * var(--scale));
  }

  .body > :not(.strip) {
    margin-inline: calc(var(--mm) * 6);
  }

  /* About 15 pt, white on black, edge to edge across the top, with the strips' top edge (on paper
     it's the strip's own colour). */
  .strip {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: calc(var(--mm) * 4);
    padding: calc(var(--mm) * 2.4) calc(var(--mm) * 6) calc(var(--mm) * 2.2);
    background: var(--strip);
    box-shadow: inset 0 2px 0 var(--strip-edge);
    color: var(--on-strip);
    font-size: calc(var(--pt) * 15 * var(--scale));
    font-weight: 700;
    line-height: 1.2;
  }

  .code {
    margin-inline-end: 0.6em;
  }

  /* 10.5 pt: when to run it, read before starting. */
  .how {
    font-size: calc(var(--pt) * 10.5);
    line-height: 1.35;
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: calc(var(--mm) * 0.35) solid CanvasText;
    counter-reset: line;
  }

  [data-columns='2'] .items {
    columns: 2;
    column-gap: calc(var(--mm) * 8);
    column-rule: calc(var(--mm) * 0.2) solid CanvasText;
  }

  /* A preview narrower than the printed card reflows, so one column reads better there. Paper is
     always 190 mm wide. */
  @container (width < 36rem) {
    [data-columns='2'] .items {
      columns: auto;
    }
  }

  .item {
    display: grid;
    grid-template-columns: 1.8em minmax(0, 1fr);
    padding-block: calc(var(--mm) * 1.3);
    border-bottom: calc(var(--mm) * 0.2) solid color-mix(in srgb, CanvasText 45%, Canvas);
    counter-increment: line;
    break-inside: avoid;
  }

  .item::before {
    content: counter(line);
    font-weight: 700;
  }

  /* The number stays beside its line, under any consequence said before it. */
  .item:has(> .group)::before,
  .item:has(> .before)::before {
    grid-row: 2;
  }

  .group { grid-column: 1 / -1; font-weight: 700; font-size: calc(var(--pt) * 11); margin-bottom: calc(var(--mm) * 2); }
  .item:has(> .group):has(> .before)::before { grid-row: 3; }

  /* The line to read, about 12.5 pt: what to check, dots, the state it should be in. A state too
     long for the line drops to the next one and sits at the right. */
  .line {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.35em;
  }

  .check {
    font-weight: 700;
  }

  .dots {
    flex: 1 1 1.5em;
    min-width: 1.5em;
    border-bottom: calc(var(--mm) * 0.4) dotted currentColor;
    translate: 0 -0.25em;
  }

  .target {
    margin-inline-start: auto;
    font-weight: 700;
    text-align: right;
  }

  [data-columns='2'] .line { display: grid; gap: 0.1em; }
  [data-columns='2'] .dots { display: none; }
  [data-columns='2'] .target { margin-inline-start: 0; text-align: left; }
  [data-columns='2'] .item { padding-block: calc(var(--mm) * 1); }


  /* What doing the line costs, said before it at full strength: 10 pt bold, never in a note. */
  .before {
    grid-column: 2;
    margin-bottom: calc(var(--mm) * 0.8);
    font-size: calc(var(--pt) * 10);
    font-weight: 700;
    line-height: 1.3;
  }

  /* How or why, under its line: 10 pt, like every sentence on the card. */
  .note {
    grid-column: 2;
    margin-top: calc(var(--mm) * 0.8);
    font-size: calc(var(--pt) * 10);
    line-height: 1.3;
  }

  /* 8 pt at the foot: when the card's words last changed, to check it against the site. A label,
     not a sentence. */
  .continue { font-size: calc(var(--pt) * 10); font-weight: 700; }

  .revised {
    font-size: calc(var(--pt) * 8);
    color: color-mix(in srgb, CanvasText 75%, Canvas);
  }

  /* The thumb tab: black like the strip, sticking out of the right-hand edge, a step lower on each
     card. */
  .tab {
    display: flex;
    align-items: center;
    justify-content: center;
    height: calc(var(--mm) * 20);
    margin-top: calc(var(--mm) * (4 + var(--tab) * 24));
    /* Cut round it too. The dashes also show the tab against a dark page, in the preview. */
    border: 0.3mm dashed var(--cut, color-mix(in srgb, CanvasText 50%, Canvas));
    border-left: 0;
    background: var(--strip);
    box-shadow: inset 0 2px 0 var(--strip-edge);
    color: var(--on-strip);
    font-size: calc(var(--pt) * 14);
    font-weight: 700;
    line-height: 1;
  }

  @media print {
    .strip,
    .tab {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }

  @media (forced-colors: active) {
    .strip,
    .tab {
      forced-color-adjust: none;
      background: CanvasText;
      box-shadow: none;
      color: Canvas;
    }
  }
</style>
