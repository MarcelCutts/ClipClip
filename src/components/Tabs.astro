---
/**
 * Thumb tabs, like the ones cut into the edge of a printed handbook: a strip that hangs from a
 * heavy rule and stays at the top of the screen as you read. Each tab has its code (1, C1, F) in
 * bold over a word or two, and the one for the part you're in is filled. One design wherever it's
 * used: the guide's parts (Contents.astro's script fills the current one, and the index rail takes
 * over on wide screens) and the night page's checklists and drills (its own script fills them).
 *
 * Each tab is named as it reads, code first, in one hidden span so screen readers hear exactly
 * "1: Why it matters" or "F: Something’s wrong"; the printed code and label are hidden from them.
 *
 * The strip's height is --sticky-top, so jumps and focus land below it (global.css) and anything
 * else that pins sits under it.
 */
import type { HTMLAttributes } from 'astro/types';

export interface Tab {
  /** What's printed on the tab: 1, C1, F. */
  code: string;
  /** A word or two under the code: Why, Doors. */
  label: string;
  href: string;
  /** The id of the section it stands for, so a script can fill the tab while you're there. */
  target?: string;
  /** The full name for screen readers, when the label is short for it: "Why it matters". */
  title?: string;
  /** A small warning lamp before the code, as on the drills' tab. */
  lamp?: boolean;
}

/** Anything else, like the data attribute a page's script finds the strip by, goes on the nav. */
interface Props extends HTMLAttributes<'nav'> {
  /** What the strip is, for screen readers: "Parts". */
  label: string;
  tabs: Tab[];
  /** Give way to the index rail on wide screens. */
  rail?: boolean;
}

const { label, tabs, rail = false, ...attrs } = Astro.props;
---

<nav class="tabs flow" aria-label={label} data-tab-strip data-rail={rail ? '' : undefined} {...attrs}>
  <ol style={`--tabs: ${tabs.length}`}>
    {tabs.map((t) => (
  <li>
    <a class="tab" href={t.href} data-target={t.target}>
      <span class="code" aria-hidden="true">{t.lamp && <span class="lamp"></span>}{t.code}</span>
      <span class="label" aria-hidden="true">{t.label}</span>
      <span class="visually-hidden">{`${t.code}: ${t.title ?? t.label}`}</span>
    </a>
  </li>
))}
  </ol>
</nav>
<script is:inline>
  // Keep --sticky-top the strip's real height: its labels wrap on narrow screens and with bigger
  // text, and it's hidden where the index rail takes over. This runs as soon as the strip is
  // parsed, so a link to a section further down (/night/#changeover) already lands clear of it.
  // Without JavaScript the CSS guess stands.
  (() => {
    const strip = document.currentScript.previousElementSibling;
    const measure = () =>
      document.documentElement.style.setProperty('--sticky-top', `${strip.getBoundingClientRect().height}px`);
    measure();
    new ResizeObserver(measure).observe(strip);
  })();
</script>

<style>
  .tabs {
    position: sticky;
    top: 0;
    z-index: 12;
    padding-block-end: 0.375rem;
    background: var(--paper);
  }

  /* The tabs hang from a heavy rule, side by side and all the same width. */
  ol {
    display: grid;
    grid-template-columns: repeat(var(--tabs), minmax(0, 1fr));
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  li {
    display: flex;
  }

  .tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.25rem 0.125rem 0.3rem;
    border: 1.5px solid var(--ink);
    border-top: 0;
    line-height: 1.15;
    text-align: center;
    color: var(--ink);
    text-decoration: none;
  }

  .code {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 700;
  }

  /* The drills' lamp: the warning colour, and nothing else on the strip is red. */
  .lamp {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--warning);
  }

  /* Up to two lines; a word that still doesn't fit (big text, the narrowest phones) breaks rather
     than pushing the strip off the screen. */
  .label {
    max-width: 100%;
    font-size: 0.8125rem;
    color: var(--ink-2);
    hyphens: auto;
    overflow-wrap: anywhere;
  }

  .tab:hover .label {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  /* The part you're in: filled with ink, in both themes. */
  .tab[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }

  .tab[aria-current] .label {
    color: inherit;
  }

  /* Every tab shows the focus ring, the filled one too. */
  .tab:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    border-radius: 0;
  }

  @media (max-width: 24rem) {
    ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tab { flex-direction: row; gap: 0.4rem; padding: 0.4rem; }
    .label { font-size: var(--text-sm); }
  }

  /* Before the script measures it, and without JavaScript: the strip's height with one-line labels. */
  :global(:root:has([data-tab-strip])) {
    --sticky-top: 3.5rem;
  }

  @media (max-width: 24rem) {
    :global(:root:has([data-tab-strip])) { --sticky-top: 6.75rem; }
  }

  @media (min-width: 80rem) {
    .tabs[data-rail] {
      display: none;
    }

    :global(:root:has([data-tab-strip][data-rail])) {
      --sticky-top: 0px;
    }
  }

  @media (forced-colors: active) {
    .tab[aria-current] {
      forced-color-adjust: none;
      background: Highlight;
      border-color: Highlight;
      color: HighlightText;
    }

    .tab[aria-current]:focus-visible {
      outline-color: CanvasText;
    }

    .lamp {
      forced-color-adjust: none;
      background: CanvasText;
    }

    .tab[aria-current] .lamp {
      background: HighlightText;
    }
  }

  @media print {
    .tabs {
      display: none;
    }
  }
</style>
