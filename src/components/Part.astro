---
/**
 * One part of the guide, opened like a section of a quick reference handbook: a black bar with the
 * part's number and title, then one plain sentence on what a reader can do by the end. Reading
 * times are in the index. The guide gets deeper part by part.
 *
 * Left unnamed, so it isn't a landmark: the h2 is how readers jump here, and the index links to it.
 *
 * Its children sit on the guide's own columns (a subgrid): the reading column by default, .wide
 * for a lab whose width shows something, and .margin-note for a note beside the paragraph before
 * it on wide screens.
 */
interface Props {
  id: string;
  /** Its place in the guide, like 2. Leave out for the reference section at the end. */
  number?: number;
  title: string;
  /** What a reader can do by the end of the part, as one plain sentence. */
  objective?: string;
}

const { id, number, title, objective } = Astro.props;
---

<section class="part subflow" id={id}>
  <h2 class="bar" id={`${id}-title`}>
    {number && <span class="no">{number}</span>}
    <span>{title}</span>
  </h2>
  {objective && <p class="standfirst">{objective}</p>}
  <slot />
</section>

<style>
  .part {
    grid-column: full;
    align-content: start;
    row-gap: 1rem;
    margin-block-start: var(--space-section);
  }

  /* The strip's edge shows by night, lifting the bar off the display. */
  .bar {
    display: flex;
    align-items: baseline;
    gap: 0.75em;
    padding: 0.5rem 0.8rem;
    border-top: 2px solid var(--strip-edge);
    background: var(--strip);
    color: var(--on-strip);
    font-size: var(--text-h2);
    line-height: 1.2;
  }

  .standfirst {
    font-size: var(--text-lede);
    line-height: 1.45;
  }

  /* Subsections: a little air above, like the headings in a manual. */
  .part > :global(h3) {
    margin-block-start: 1.5rem;
  }

  @media (min-width: 80rem) {
    .part {
      /* Beside the guide's index rail, never under it. */
      grid-column: rail-end / full-end;
    }
  }

  @media (forced-colors: active) {
    .bar {
      forced-color-adjust: none;
      border-top-color: CanvasText;
      background: CanvasText;
      color: Canvas;
    }
  }

  @media print {
    .bar {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
