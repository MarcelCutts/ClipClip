---
/**
 * Figure: the XDJ-RX2's meters, drawn as a manual draws them. A line drawing of the meter bridge
 * on the page (CH1, the middle pair with CLIP above it, CH2, and the printed scale), lit the way a
 * well-set blend looks at its loudest: each deck on the first orange, both peaking at once, the
 * mix two lights higher, and the top orange, red and CLIP dark. Numbered callouts point at the parts
 * and key into the list beside it, and a bracket marks where to aim.
 *
 * Like every meter on the site it doesn't rely on colour: a printed break where the colour changes,
 * a bold 0, the red light outlined, and the list in words. Server-rendered, at the reading
 * column's width: nothing in it needs more.
 */
import { TARGET_PEAK_DB } from '../lib/model';
import { href } from '../lib/url';
import { litCount, METER_SEGMENTS, scaleLabel } from '../lib/xdj';

// The blend in the picture: both decks on the aim, the mix where lined-up kicks put it (model.ts).
const CH1 = TARGET_PEAK_DB.aim;
const CH2 = TARGET_PEAK_DB.aim;
const MIX = TARGET_PEAK_DB.blend;
const higher = litCount(MIX) - litCount(TARGET_PEAK_DB.aim);
const lightsHigher = `${['no', 'one', 'two', 'three', 'four'][higher] ?? higher} light${higher === 1 ? '' : 's'} higher`;

const XDJ_MANUAL =
  'https://downloads.support.alphatheta.com/manuals/all-in-one-dj-systems/XDJ-RX2/XDJ-RX2_DRI1479A_manual.pdf';

// The drawing's rows, top to bottom: the column names, CLIP, then the lights from +12 down, with
// a short break row wherever the colour changes. Then the panel's lower edge, the leader lines and
// the callout numbers below it.
const lights = [...METER_SEGMENTS].reverse();
const FIRST_LIGHT_ROW = 4; // 1 panel top, 2 names, 3 CLIP
let row = FIRST_LIGHT_ROW - 1;
const rows = lights.map((s, i) => {
  if (i > 0 && lights[i - 1]?.zone !== s.zone) row++;
  row++;
  return { ...s, row };
});
const lastLightRow = row;
const breakRows = Array.from({ length: lastLightRow - FIRST_LIGHT_ROW + 1 }, (_, i) => FIRST_LIGHT_ROW + i).filter(
  (r) => !rows.some((s) => s.row === r),
);
const lightRows = Array.from({ length: lastLightRow - FIRST_LIGHT_ROW + 1 }, (_, i) =>
  breakRows.includes(FIRST_LIGHT_ROW + i) ? 'var(--break)' : 'var(--led-h)',
).join(' ');
const rowOf = (db: number) => rows.find((s) => s.db === db)?.row ?? FIRST_LIGHT_ROW;
const lit = (db: number, level: number) => db <= level;

const aim = `grid-row: ${rowOf(TARGET_PEAK_DB.aim)} / ${rowOf(TARGET_PEAK_DB.aim) + 1}`;
const label = `The XDJ-RX2’s meters at a blend’s loudest moment. CH1 and CH2 each peak at ${scaleLabel(CH1)}, the first orange light. The MASTER meters show the mix at ${scaleLabel(MIX)}, ${lightsHigher}, with the top orange, red and CLIP dark. A bracket marks the aim, ${scaleLabel(TARGET_PEAK_DB.aim)}.`;
---

<figure class="anatomy">
  <figcaption class="takeaway">
    In a well-set blend, each deck peaks on the first orange light. The mix reads up to {lightsHigher}, and the top
    orange stays dark.
  </figcaption>
  <div class="layout">
    <!-- biome-ignore lint/a11y/noNoninteractiveTabindex: Keyboard users must be able to pan the magnified diagram. -->
    <section class="drawing-scroll" aria-label="Meter diagram; scroll sideways if needed" tabindex="0">
    <div
      class="drawing"
      role="img"
      aria-label={label}
      style={`--light-rows: ${lightRows}; --lights-end: ${lastLightRow + 1}`}
    >
      <span class="panel-edge"></span>
      <span class="name" style="grid-column: ch1">CH1</span>
      <span class="name" style="grid-column: t1 / t2-end">MASTER</span>
      <span class="name" style="grid-column: ch2">CH2</span>
      <span class="clip">CLIP</span>
      {rows.map((s) => (
  <Fragment>
    <span class="led" data-zone={s.zone} data-on={lit(s.db, CH1) ? '' : undefined} style={`grid-area: ${s.row} / ch1`}></span>
    <span class="tick" data-zero={s.db === 0 ? '' : undefined} style={`grid-area: ${s.row} / t1`}>{scaleLabel(s.db)}</span>
    <span class="led" data-zone={s.zone} data-on={lit(s.db, MIX) ? '' : undefined} style={`grid-area: ${s.row} / ml`}></span>
    <span class="led" data-zone={s.zone} data-on={lit(s.db, MIX) ? '' : undefined} style={`grid-area: ${s.row} / mr`}></span>
    <span class="tick" data-zero={s.db === 0 ? '' : undefined} style={`grid-area: ${s.row} / t2`}>{scaleLabel(s.db)}</span>
    <span class="led" data-zone={s.zone} data-on={lit(s.db, CH2) ? '' : undefined} style={`grid-area: ${s.row} / ch2`}></span>
  </Fragment>
))}
      <span class="aim" style={aim}><span>Aim</span></span>
      <span class="leader down" style="grid-column: ch1"></span>
      <span class="leader down" style="grid-column: ml / mr-end"></span>
      <span class="leader down" style="grid-column: ch2"></span>
      <span class="leader across"></span>
      <span class="call" style="grid-row: calls; grid-column: ch1">1</span>
      <span class="call" style="grid-row: calls; grid-column: ml / mr-end">2</span>
      <span class="call" style="grid-row: calls; grid-column: ch2">1</span>
      <span class="call beside" style="grid-row: clip; grid-column: call">3</span>
    </div>
    </section>
    <ol class="keys">
      <li>
        <span class="call" aria-hidden="true">1</span>
        <p>
          <strong>Channel meters, CH1 and CH2.</strong> Each shows one deck. Set TRIM by these. VirtualDJ’s manual for
          the unit says they read before the fader: moving the fader does not move the meter (<a href={href('/learn/#red-top')}
            >meter reference</a
          >).
        </p>
      </li>
      <li>
        <span class="call" aria-hidden="true">2</span>
        <p>
          <strong>MASTER meters.</strong> The mix going out to the speakers and the recording. In a blend they read up to
          {lightsHigher} than the channels. Keep the top orange dark.
        </p>
      </li>
      <li>
        <span class="call" aria-hidden="true">3</span>
        <p>
          <strong>CLIP.</strong> Blinks slowly when the sound is “about to be distorted” and fast when it “is distorted”
          (<a href={`${XDJ_MANUAL}#page=27`} rel="external">XDJ-RX2 manual, p.&nbsp;27</a>).
        </p>
      </li>
    </ol>
  </div>
</figure>

<style>
  .anatomy {
    /* The drawing's line weight, shared by the callout numbers in the key. */
    --line: 1.5px;
    container: anatomy / inline-size;
    display: grid;
    gap: 0.9rem;
    margin-block: 0.5rem;
  }

  /* The figure's point, above it, in the words of the rule. */
  .takeaway {
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink-bright);
    text-wrap: balance;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 1.25rem;
    justify-items: start;
  }

  /* Keep magnified labels readable in this two-dimensional drawing. Its written key reflows. */
  .drawing-scroll {
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
  }

  /* The drawing, as one grid: the aim bracket, CH1, the scale, the middle pair, the scale again,
     CH2, then room for the leader to callout 3 past the panel's edge. */
  .drawing {
    --led-h: 0.625rem;
    --break: 0.3rem;
    --col-gap: 5px;
    --row-gap: 4px;
    --pad: 0.7rem;
    display: grid;
    width: max-content;
    grid-template-columns:
      [aim] auto [ch1] 1.75rem [t1] 1.9rem [ml] 0.85rem [mr] 0.85rem [mr-end t2] 1.9rem [t2-end ch2] 1.75rem
      [ch2-end] 1.1rem [call] 1.5rem;
    grid-template-rows: [top] 0.3rem [names] auto [clip] auto var(--light-rows) [bottom] 0.45rem [leads] 1rem [calls] auto;
    column-gap: var(--col-gap);
    row-gap: var(--row-gap);
    font-family: var(--font-label);
    color: var(--ink);
  }

  /* The meter bridge's outline, drawn behind everything on it: round CH1 to CH2, from the names to
     just below the lowest light. */
  .panel-edge {
    grid-column: ch1 / ch2-end;
    grid-row: top / leads;
    margin-inline: calc(-1 * var(--pad));
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-panel);
    background: var(--paper-2);
  }

  .name {
    grid-row: names;
    justify-self: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* CLIP, above the middle pair: a lamp outlined in its red, dark. */
  .clip {
    grid-row: clip;
    grid-column: ml / mr-end;
    justify-self: stretch;
    margin-block-end: 0.2rem;
    padding-block: 0.05rem;
    border: var(--line) solid var(--led-r);
    border-radius: 2px;
    background: var(--paper);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-align: center;
  }

  /* Each light drawn as a small outlined lamp, filled where it's lit. The red one keeps a red
     outline, so it reads as red while it's dark. */
  .led {
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: var(--paper);
  }

  .led[data-zone='red'] {
    border: var(--line) solid var(--led-r);
  }

  .led[data-on][data-zone='green'] {
    background: var(--led-g);
  }

  .led[data-on][data-zone='orange'] {
    background: var(--led-a);
  }

  /* The scale as the panel prints it, with the 0 in bold. */
  .tick {
    align-self: center;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: var(--ink-2);
  }

  .tick[data-zero] {
    font-weight: 800;
    color: var(--ink);
  }

  /* The aim: a bracket beside CH1's first orange light, 0, with our note on it. */
  .aim {
    grid-column: aim;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    margin-block: -2px;
    /* Outside the panel: it's our note, not something printed on the mixer. */
    margin-inline-end: calc(var(--pad) + 0.5rem);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .aim::after {
    content: '';
    align-self: stretch;
    width: 0.4rem;
    border: 2px solid var(--ink);
    border-inline-end: 0;
  }

  /* Leader lines from the parts to their numbers: down from the lowest lights, and across from
     CLIP past the panel's edge. Each runs through the grid's gaps at both ends, so it touches the
     part and its number. */
  .leader {
    background: var(--ink);
  }

  .leader.down {
    grid-row: var(--lights-end) / calls;
    justify-self: center;
    width: var(--line);
    margin-block: calc(-1 * var(--row-gap));
  }

  .leader.across {
    grid-row: clip;
    grid-column: mr-end / call;
    align-self: center;
    height: var(--line);
    margin-inline: calc(-1 * var(--col-gap));
    margin-block-end: 0.2rem;
  }

  .call {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
  }

  .drawing .call {
    justify-self: center;
  }

  .drawing .call.beside {
    align-self: center;
    justify-self: start;
    margin-block-end: 0.2rem;
  }

  /* The key: each number, then what it points at. */
  .keys {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .keys li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    column-gap: 0.6rem;
    align-items: start;
  }

  .keys p {
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .keys strong {
    color: var(--ink-bright);
  }

  /* Wide enough: the key beside the drawing, level with the meters. */
  @container anatomy (min-width: 32rem) {
    .layout {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 2rem;
      align-items: center;
    }
  }

  @media (forced-colors: active) {
    .led,
    .clip {
      forced-color-adjust: none;
      background: Canvas;
      border-color: CanvasText;
    }

    .led[data-on][data-zone] {
      background: CanvasText;
    }

    /* Drawn as fills, which forced colours would clear, so they keep the text colour. */
    .leader {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }
</style>
