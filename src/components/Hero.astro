---
/**
 * The home page's opening: the title, what the site is for, and the XDJ-RX2's own twelve-light
 * meter. On load the lights climb to the first orange, where a well-set track peaks, and stop,
 * with the rest of the orange and the red dark. An "Aim" bracket marks the 0 light, and each
 * colour's zone is named under the printed scale. The meter doesn't rely on colour alone: a wider,
 * printed break sits where the colour changes, the 0 mark is bold, and the zones are named in words.
 */
import { TARGET_PEAK_DB } from '../lib/model';
import { METER_SEGMENTS, scaleLabel, type Zone } from '../lib/xdj';

const peak = TARGET_PEAK_DB.aim;

// The meter's columns: one per light, plus a narrow break column wherever the colour changes
// (between −3 and 0, and between +9 and +12). The lights, the scale, the aim bracket and the zone
// words all sit on these columns, so each lines up with its light.
let column = 0;
const segments = METER_SEGMENTS.map((s, i) => {
  if (i > 0 && METER_SEGMENTS[i - 1]?.zone !== s.zone) column++;
  column++;
  return { ...s, i, column, lit: s.db <= peak };
});
const breaks = new Set(
  Array.from({ length: column }, (_, c) => c + 1).filter((c) => !segments.some((s) => s.column === c)),
);
const columns = Array.from({ length: column }, (_, c) => (breaks.has(c + 1) ? 'var(--break)' : 'minmax(0, 1fr)')).join(
  ' ',
);
const columnOf = (db: number) => segments.find((s) => s.db === db)?.column ?? 1;
const span = (from: number, to: number) => `grid-column: ${columnOf(from)} / ${columnOf(to) + 1}`;

const aim = span(TARGET_PEAK_DB.aim, TARGET_PEAK_DB.aim);

// Each zone's mark runs under all its lights. Its words start at the zone's first light, except
// red's: one light is too narrow on a phone, so they end at the red light and take the room over
// the upper orange lights. The orange words keep to the first two.
const zoneLights = (zone: Zone) => segments.filter((s) => s.zone === zone);
const ends = (zone: Zone) => {
  const lights = zoneLights(zone);
  return { first: lights[0]?.db ?? 0, last: lights.at(-1)?.db ?? 0 };
};
const green = ends('green');
const orange = ends('orange');
const red = ends('red');
const [, secondOrange, thirdOrange] = zoneLights('orange');
const zones = [
  { zone: 'green', name: 'Green', meaning: 'headroom', mark: span(green.first, green.last), words: span(green.first, green.last) },
  {
    zone: 'orange',
    name: 'Orange',
    meaning: 'loudest parts',
    mark: span(orange.first, orange.last),
    words: span(orange.first, secondOrange?.db ?? orange.first),
  },
  {
    zone: 'red',
    name: 'Red',
    meaning: 'may distort',
    mark: span(red.first, red.last),
    words: span(thirdOrange?.db ?? red.first, red.last),
  },
];

const litCount = segments.filter((s) => s.lit).length;
const caption = `The mixer’s meter, lit up to the first orange light, ${litCount} lights out of ${segments.length}. Aim for the first orange light, ${scaleLabel(TARGET_PEAK_DB.aim)}, at a track’s loudest part. Green is headroom, orange is for the loudest parts, and red may distort.`;
---

<header class="hero flow">
  <div class="stage wide">
    <h1 class="title">Out of the red</h1>
    <figure class="meter" style={`--columns: ${columns}`}>
      <div class="row aim" aria-hidden="true"><span class="aim-mark" style={aim}>Aim</span></div>
      <div class="row leds" aria-hidden="true">
        {segments.map((s) => (
  <span
    class="led"
    data-zone={s.zone}
    data-lit={s.lit ? '' : undefined}
    style={`grid-column: ${s.column}; --i: ${s.i}`}
  ></span>
))}
      </div>
      <div class="row scale" aria-hidden="true">
        {segments.map((s) => (
  <span data-zero={s.db === 0 ? '' : undefined} style={`grid-column: ${s.column}`}>{scaleLabel(s.db)}</span>
))}
      </div>
      <div class="row zones" aria-hidden="true">
        {zones.map((z) => <span class="zone-mark" style={z.mark}></span>)}
        {zones.map((z) => (
  <p class="zone-words" data-zone={z.zone} style={z.words}>
    <span class="zone-name">{z.name}</span> <span class="zone-meaning">{z.meaning}</span>
  </p>
))}
      </div>
      <figcaption class="visually-hidden">{caption}</figcaption>
    </figure>
    <div class="aside"><slot /></div>
  </div>
</header>

<style>
  .hero {
    padding-block: clamp(1.75rem, 1rem + 3vw, 3.75rem) 1rem;
  }

  /* Wide screens have no tab strip under the hero: the guide's own margin is enough. */
  @media (min-width: 80rem) {
    .hero {
      padding-block-end: 0;
    }
  }

  /* The title, what the site is for, then the meter: the card's heading and its one picture.
     The meter runs the frame's full width on wide screens, like the meter bridge across a mixer. */
  .stage {
    display: grid;
    grid-template-areas: 'title' 'aside' 'meter';
    row-gap: 1rem;
  }

  .title {
    grid-area: title;
    margin: 0;
    font-size: var(--text-h1);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  .meter {
    --bezel: clamp(4px, 0.15rem + 0.35vw, 8px);
    --gap: clamp(3px, 0.2rem + 0.3vw, 6px);
    /* The printed break where the colour changes: about three gaps wide in all. */
    --break: var(--gap);
    grid-area: meter;
    display: grid;
    row-gap: 0.4rem;
    margin: 0.25rem 0 0;
  }

  .aside {
    grid-area: aside;
    max-width: var(--measure);
  }

  /* Every row shares the lights' columns, inset by the bezel, so marks and words line up. */
  .row {
    display: grid;
    grid-template-columns: var(--columns);
    column-gap: var(--gap);
    padding-inline: calc(var(--bezel) + 1px);
  }

  /* Where to aim: a bracket over the 0 light, named like a note on the page. The word is wider than
     one light on a phone, so it stays on one line and spills evenly over its neighbours. */
  .aim-mark {
    display: grid;
    justify-items: center;
    row-gap: 0.15rem;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--ink);
  }

  .aim-mark::after {
    content: '';
    justify-self: stretch;
    height: 0.45rem;
    border: 2px solid var(--ink);
    border-bottom: 0;
  }

  /* The lights sit in the mixer's own black bezel, by day as well as by night. */
  .leds {
    padding: var(--bezel);
    border-radius: var(--radius-control);
    background: var(--hw-sunk);
    border: 1px solid var(--panel-edge);
  }

  .led {
    --lit: var(--led-g);
    --unlit: var(--led-g-off);
    grid-row: 1;
    height: clamp(1.6rem, 1.2rem + 1.4vw, 2.25rem);
    border-radius: 3px;
    background: var(--unlit);
  }

  .led[data-zone='orange'] {
    --lit: var(--led-a);
    --unlit: var(--led-a-off);
  }

  .led[data-zone='red'] {
    --unlit: var(--led-r-off);
    box-shadow: inset 0 0 0 1.5px var(--led-r-rim);
  }

  .led[data-lit] {
    background: var(--lit);
    box-shadow:
      0 0 12px color-mix(in srgb, var(--lit) 38%, transparent),
      inset 0 -2px 0 rgb(0 0 0 / 0.14);
  }

  /* The scale as the panel prints it, with the 0 in bold. */
  .scale {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: clamp(0.75rem, 0.68rem + 0.25vw, 0.875rem);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: var(--ink-2);
  }

  .scale span {
    grid-row: 1;
  }

  .scale [data-zero] {
    font-weight: 800;
    color: var(--ink);
  }

  /* Each colour's zone: a mark under its lights, then its name and what it means. */
  .zones {
    row-gap: 0.3rem;
    align-items: start;
  }

  .zone-mark {
    grid-row: 1;
    height: 0.4rem;
    border: 1.5px solid var(--ink-3);
    border-top: 0;
  }

  .zone-words {
    grid-row: 2;
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.3;
  }

  .zone-words[data-zone='red'] {
    text-align: end;
  }

  .zone-name {
    display: block;
    font-weight: 700;
    color: var(--ink);
  }

  .zone-meaning {
    display: block;
    color: var(--ink-2);
  }

  @media (min-width: 48rem) {
    .zone-words {
      font-size: var(--text-sm);
    }
  }

  /* The one orchestrated moment: the lights climb, one after another, and stop short of the red. */
  @media (prefers-reduced-motion: no-preference) {
    .led[data-lit] {
      animation: light-up 0.16s ease-out calc(0.35s + var(--i) * 0.07s) backwards;
    }
  }

  @keyframes light-up {
    from {
      background: var(--unlit);
      box-shadow: none;
    }
  }

  @media (forced-colors: active) {
    .led {
      forced-color-adjust: none;
      background: Canvas;
      box-shadow: inset 0 0 0 1px CanvasText;
    }

    .led[data-lit] {
      background: CanvasText;
    }
  }
</style>
