---
/**
 * Things DJs say about the red, set out as a reference table: what people say, and what's true.
 * The belief is quoted in italic; what's true follows at the same weight, then one paragraph with
 * the part of the claim that's fair, what actually happens and what to do instead, and the maker's
 * page where one backs it. Everything is visible: a sceptic scans the left column for their own
 * belief. On phones each row stacks.
 */
import type { Myth } from '../lib/myths';

interface Props {
  myths: Myth[];
}

const { myths } = Astro.props;

type Source = NonNullable<Myth['source']>;
const link = (source: Source) => (source.page ? `${source.url}#page=${source.page}` : source.url);
/** The source line's closing stop, unless the title already ends a sentence ("…mastered?"). */
const stop = (source: Source) => (source.page || !/[?!.]$/.test(source.title) ? '.' : '');
---

<div class="myths">
  <p class="head" aria-hidden="true"><span>What people say</span><span>What’s true</span></p>
  <ul>
    {myths.map((m) => (
  <li id={`myth-${m.id}`}>
    <p class="claim"><span class="visually-hidden">What people say: </span>“{m.claim}”</p>
    <div class="true">
      <p class="truth"><span class="visually-hidden">What’s true: </span>{m.truth}</p>
      <p>{m.fair} {m.actually} {m.instead}</p>
      {m.source?.publisher && (
      <p class="source">
        Source: {m.source.publisher}, “<a href={link(m.source)} rel="external">{m.source.title}</a>”{stop(m.source)}
      </p>
    )}
      {m.source && !m.source.publisher && (
      <p class="source">
        Source: <a href={link(m.source)} rel="external">{m.source.title}</a>{m.source.page && `, page\u00a0${m.source.page}`}{stop(m.source)}
      </p>
    )}
    </div>
  </li>
))}
  </ul>
</div>

<style>
  .myths {
    display: grid;
  }

  .head {
    display: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  li {
    display: grid;
    gap: 0.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  /* What people say, in their words: quoted, and set back from what's true. */
  .claim {
    font-style: italic;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .true {
    display: grid;
    gap: 0.4rem;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .truth {
    font-size: var(--text-base);
    line-height: 1.45;
    color: var(--ink-bright);
  }

  .source {
    color: var(--ink-2);
  }

  /* Wide enough: a two-column table with its headings once at the top. */
  @media (min-width: 48rem) {
    .head {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 1.5rem;
      padding-block-end: 0.4rem;
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--ink-3);
    }

    li {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 1.5rem;
    }
  }
</style>
