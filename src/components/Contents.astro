---
/**
 * The guide's index, set like a quick reference handbook's: each part a row with its thumb tab,
 * number, title and reading time. On phones and laptops it's a list near the top; on wide screens
 * it sits in the rail left of the text, stays in view, and opens the part you're in. The thumb tab
 * of the part you're in is filled.
 *
 * Without JavaScript it's a plain list of links. With it, the part and section you're in are
 * marked here and on the phone's tab strip (Tabs.astro).
 */
export interface ContentsEntry {
  id: string;
  label: string;
  /** Its place: a part number like 2, or a card's code like S2. */
  number?: number | string;
  minutes?: number;
  /** A small warning lamp before the number, as on the drills' tab. */
  lamp?: boolean;
  subs?: { id: string; label: string }[];
}

interface Props {
  entries: ContentsEntry[];
  /** How many rows of the guide's grid the rail runs beside. */
  rows: number;
}

const { entries, rows } = Astro.props;
---

<nav class="toc" aria-labelledby="toc-title" data-toc style={`--toc-rows: ${rows}`}>
  <p class="toc-title" id="toc-title">Index</p>
  <ol class="parts">
    {entries.map((e) => (
  <li class="part" data-part={e.id}>
    <a href={`#${e.id}`} data-target={e.id}>
      <span class="marker" aria-hidden="true"></span>
      <span class="no">{e.lamp && <span class="lamp" aria-hidden="true"></span>}{e.number ?? ''}</span>
      <span class="text">
        <span class="label">{e.label}</span>
        {e.minutes && <span class="time">{e.minutes}&nbsp;min</span>}
      </span>
    </a>
    {e.subs && e.subs.length > 0 && (
    <ol class="subs">
      {e.subs.map((s) => (
      <li>
        <a href={`#${s.id}`} data-target={s.id}>
          {s.label}
        </a>
      </li>
    ))}
    </ol>
  )}
  </li>
))}
  </ol>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-toc]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-target]')];
    const targets = links.map((a) => document.getElementById(a.dataset.target ?? ''));
    const parts = [...nav.querySelectorAll<HTMLElement>('li[data-part]')];
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tabs] a[data-target]')];
    let queued = false;

    const update = () => {
      queued = false;
      // The section you're in is the last one whose top has passed a quarter of the way down.
      const line = window.innerHeight * 0.25;
      let at = -1;
      targets.forEach((t, i) => {
        if (t && t.getBoundingClientRect().top <= line) at = i;
      });
      links.forEach((a, i) => {
        if (i === at) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
      const open = at >= 0 ? links[at]?.closest<HTMLElement>('li[data-part]') : null;
      for (const p of parts) p.toggleAttribute('data-open', p === open);
      const part = open?.dataset.part;
      for (const t of tabs) {
        if (t.dataset.target === part) t.setAttribute('aria-current', 'location');
        else t.removeAttribute('aria-current');
      }
    };

    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
    update();
  }
</script>

<style>
  .toc {
    /* The column for a part's number or a card's code: as wide as the widest, F11. */
    --no: 2rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .toc-title {
    font-weight: 700;
  }

  .parts,
  .subs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .part {
    border-top: 1px solid var(--rule);
  }

  .part:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .part > a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding-block: 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }

  /* The title, with its reading time at the end of the line, or under it when there's no room. */
  .text {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.1rem 0.75rem;
  }

  .label {
    flex: 1 1 auto;
    line-height: 1.3;
  }

  /* A thumb tab, drawn as the notch it makes in the edge of a printed handbook: open on the page's
     side, and filled for the part you're in. */
  .marker {
    flex: none;
    width: 0.625rem;
    height: 1.75rem;
    border: 1.5px solid var(--ink);
    border-inline-start: 0;
  }

  .part[data-open] .marker {
    background: var(--ink);
  }

  .no {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-width: var(--no);
    font-weight: 700;
  }

  /* The drills' lamp on the night page, as on their tab: the only red in the index. */
  .lamp {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--warning);
  }

  .part[data-open] .label {
    font-weight: 700;
  }

  .part > a:hover .label {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .time {
    flex: none;
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--ink-3);
  }

  .subs {
    display: none;
  }

  /* Wide screens: the index in a rail beside the text that stays in view, opening the part
     you're in. */
  @media (min-width: 80rem) {
    /* Below anything that sticks above it, like the night page's tabs. */
    .toc {
      grid-column: rail;
      grid-row: 1 / span var(--toc-rows);
      position: sticky;
      top: calc(var(--sticky-top, 0px) + 1.5rem);
      align-self: start;
      max-height: calc(100dvh - var(--sticky-top, 0px) - 3rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block-end: 1rem;
    }

    .part > a {
      min-height: 2.5rem;
      gap: 0.55rem;
      font-size: var(--text-sm);
    }

    .time {
      display: none;
    }

    .part[data-open] > .subs {
      display: grid;
      padding-block-end: 0.4rem;
    }

    .subs a {
      display: block;
      padding-block: 0.3rem;
      /* In line with the titles: tab, gap, number, gap. */
      padding-inline-start: calc(0.625rem + 0.55rem + var(--no) + 0.55rem);
      font-size: var(--text-sm);
      line-height: 1.3;
      color: var(--ink-2);
      text-decoration: none;
    }

    .subs a:hover {
      color: var(--ink-bright);
      text-decoration: underline;
    }

    .subs a[aria-current] {
      color: var(--ink-bright);
      font-weight: 700;
    }
  }

  @media (forced-colors: active) {
    .part[data-open] .marker,
    .lamp {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }

  @media print {
    .toc {
      display: none;
    }
  }
</style>
