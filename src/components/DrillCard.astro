---
/**
 * One drill for when something goes wrong, set like a quick reference handbook's: a black title strip
 * with the light you're looking at drawn lit, the title and the drill's number; a condition only where
 * it adds to the title, and the objective; then numbered steps. A booth drill heads its steps "Now",
 * and puts what can wait in a second block, "At the changeover", numbered on from the first.
 *
 * A step is a control and the state to leave it in, joined by leader dots; an instruction; the words
 * to say to the DJ, in bold; or a line starting "If". A consequence someone must know first is a plain
 * sentence just before its step. "Choose one" lists what you can see, each finding ending the drill
 * (■ ■ ■ ■) or going to a step or another drill. Why it works comes last, as additional information
 * that needn't be read, with where the guide explains it.
 *
 * The drill is linkable as /night/#fix-<id>, and each step as #fix-<id>-step-<n>; a jump lands clear of
 * the page's tabs (global.css) and outlines the step in the action colour. The light sits on a scrap
 * of black faceplate, because lit colour only ever means a signal state and LEDs sit on black.
 */
import {
  type Branch,
  drill,
  drillAnchor,
  type Fix,
  isDoStep,
  isIfStep,
  isSayStep,
  type Next,
  SAY_TO,
  type Step,
} from '../lib/fixes';
import { section } from '../lib/sections';
import { href } from '../lib/url';

interface Props {
  fix: Fix;
  /** Heading level for the title, to fit the page's outline. */
  level?: 2 | 3 | 4;
}

const { fix, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
const anchor = drillAnchor(fix.id);
const titleId = `${anchor}-title`;
const see = fix.see ? section(fix.see) : undefined;

/** The drill's blocks of steps, numbered on from each other: "Now", then what waits. */
const blocks = [
  { label: fix.where === 'booth' ? 'Now' : undefined, steps: fix.steps, start: 1 },
  ...(fix.later ? [{ label: fix.later.when, steps: fix.later.steps, start: fix.steps.length + 1 }] : []),
];

/**
 * Where a jump lands, and its words: "Go to step 3", "Go to F4" or "Go to F1, step 2", with the other
 * drill's title for screen readers.
 */
function jump(next: Next): { to: string; text: string; title?: string } {
  if (typeof next === 'number') return { to: `#${drillAnchor(fix.id, next)}`, text: `Go to step ${next}` };
  if (typeof next === 'string') {
    const target = drill(next);
    return { to: `#${drillAnchor(target.id)}`, text: `Go to ${target.code}`, title: target.title };
  }
  const target = drill(next.drill);
  return {
    to: `#${drillAnchor(target.id, next.step)}`,
    text: `Go to ${target.code}, step ${next.step}`,
    title: target.title,
  };
}

/** The same jump in the middle of a sentence: "If the DJ wants it louder, go to F4." */
const inline = (next: Next) => {
  const j = jump(next);
  return { ...j, text: `g${j.text.slice(1)}` };
};

/** The words before a quote: "Say to the DJ:" unless the step or finding says otherwise. */
const lead = (s: { to?: string }) => s.to ?? SAY_TO;

const beforeOf = (step: Step) => step.before;
const noteOf = (step: Step) => (isIfStep(step) ? undefined : step.note);
const chooseOf = (step: Step): readonly Branch[] | undefined => (isIfStep(step) ? undefined : step.choose);
---

<article class="drill" id={anchor} aria-labelledby={titleId}>
  <div class="strip">
    {fix.light && (
  <span class="light" data-light={fix.light} aria-hidden="true">
    {fix.light === 'meters-red' ? (
      <span class="ladder">
        {Array.from({ length: 6 }, (_, i) => <span data-zone={i === 5 ? 'red' : i >= 3 ? 'orange' : 'green'} />)}
      </span>
    ) : fix.light === 'howler-red' ? (
      <span class="led" />
    ) : (
      <Fragment>
        <span class="clip-leds">
          <span class="led" />
          {fix.light === 'driverack-clip' && <span class="led" />}
        </span>
        <span class="legend">Clip</span>
      </Fragment>
    )}
  </span>
)}
    <Heading class="title" id={titleId}><span class="visually-hidden">{fix.code}: </span>{fix.title}</Heading>
    <span class="code" aria-hidden="true">{fix.code}</span>
  </div>

  <div class="body">
    <div class="lines">
      {fix.condition && <p><em>Condition.</em> {fix.condition}</p>}
      <p><em>Objective.</em> {fix.objective}</p>
    </div>
    {fix.warning && (
  <p class="warning"><strong>Warning.</strong> {fix.warning}</p>
)}

    {blocks.map((block) => (
  <div class="block">
    {block.label && <p class="block-label">{block.label}</p>}
    <ol class="steps" start={block.start}>
      {block.steps.map((step, i) => (
      <li class="step" id={drillAnchor(fix.id, block.start + i)}>
        {beforeOf(step) && <p class="before">{beforeOf(step)}</p>}
        <span class="n">{block.start + i}</span>
        {isIfStep(step) ? (
        <p class="if">
          <strong>If</strong>{step.if.slice(2)}{(step.action || step.next !== undefined) && ','}
          {step.action && <Fragment>{' '}{step.action}</Fragment>}
          {step.say && <Fragment>{' '}<strong class="words">“{step.say}”</strong></Fragment>}
          {step.next !== undefined && (
          <Fragment>
            {' '}<a class="go" href={inline(step.next).to}>{inline(step.next).text}{inline(step.next).title && <span class="visually-hidden">: {inline(step.next).title}</span>}</a>.
          </Fragment>
        )}
          {step.end && (
          <Fragment>
            {' '}<span class="stop"><span class="visually-hidden">End of {fix.code}.</span><span class="marks" aria-hidden="true"><span /><span /><span /><span /></span></span>
          </Fragment>
        )}
        </p>
      ) : (
        <div class="action">
          {isSayStep(step) ? (
          <p class="say">{lead(step)}{' '}<strong class="words">“{step.say}”</strong></p>
        ) : isDoStep(step) ? (
          <p class="do">{step.do}</p>
        ) : (
          <p class="line">
            <span class="challenge">{step.challenge}</span><span class="visually-hidden">,</span>
            <span class="dots" aria-hidden="true"></span>
            <span class="response">{step.response}</span>
          </p>
        )}
          {noteOf(step) && <p class="note">{noteOf(step)}</p>}
          {chooseOf(step) && (
          <div class="choose">
            <p class="choose-one">Choose one:</p>
            <ul class="branches">
              {chooseOf(step)?.map((b) => (
              <li class="branch">
                <span class="diamond" aria-hidden="true"></span>
                <p>
                  <strong>{b.finding}:</strong>
                  {b.action && <Fragment>{' '}{b.action}</Fragment>}
                  {b.say && <Fragment>{' '}{lead(b)}{' '}<strong class="words">“{b.say}”</strong></Fragment>}
                  {b.next !== undefined && (
                  <Fragment>
                    {' '}<a class="go" href={jump(b.next).to}>{jump(b.next).text}{jump(b.next).title && <span class="visually-hidden">: {jump(b.next).title}</span>}</a>
                  </Fragment>
                )}
                  {b.end && (
                  <Fragment>
                    {' '}<span class="stop"><span class="visually-hidden">End of {fix.code}.</span><span class="marks" aria-hidden="true"><span /><span /><span /><span /></span></span>
                  </Fragment>
                )}
                </p>
              </li>
            ))}
            </ul>
          </div>
        )}
        </div>
      )}
      </li>
    ))}
    </ol>
  </div>
))}

    <p class="end"><span class="visually-hidden">End of {fix.code}.</span><span class="marks" aria-hidden="true"><span /><span /><span /><span /></span></p>

    <p class="why">
      <strong>Why.</strong> {fix.why}
      {see && (
      <Fragment>
        {' '}<a class="ref" href={href(`/${fix.seeAt ?? fix.see}`)}>See {see.number} in the guide<span class="visually-hidden">: {see.title}</span></a>
      </Fragment>
    )}
    </p>
  </div>
</article>

<style>
  .drill {
    display: grid;
    border: 2px solid var(--ink);
  }

  /* The title strip: black by day, a raised display header by night. */
  .strip {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.8rem;
    background: var(--strip);
    color: var(--on-strip);
  }

  .title {
    flex: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-rule);
    font-weight: 700;
    line-height: 1.3;
    color: inherit;
    text-wrap: balance;
  }

  .code {
    flex: none;
    font-weight: 700;
    font-size: var(--text-sm);
  }

  /* The light you're looking at, lit, on a scrap of faceplate. */
  .light {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.4rem;
    border-radius: var(--radius-control);
    background: var(--hw-sunk);
  }

  .led {
    display: block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--led-r);
    box-shadow: 0 0 6px color-mix(in srgb, var(--led-r) 60%, transparent);
  }

  .clip-leds {
    display: grid;
    gap: 2px;
  }

  .clip-leds .led {
    width: 0.95rem;
    height: 0.45rem;
    border-radius: 1px;
  }

  /* Printed on the gear above the light, so it's set like the silk-screen. */
  .legend {
    font-family: var(--font-label);
    font-weight: 800;
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hw-label);
  }

  .ladder {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }

  .ladder > span {
    width: 0.95rem;
    height: 3px;
    border-radius: 1px;
    background: var(--led-g);
  }

  .ladder > [data-zone='orange'] {
    background: var(--led-a);
  }

  .ladder > [data-zone='red'] {
    background: var(--led-r);
    box-shadow: 0 0 5px color-mix(in srgb, var(--led-r) 60%, transparent);
  }

  .body {
    display: grid;
    gap: 0.7rem;
    padding: 0.7rem 0.8rem 0.8rem;
  }

  .lines {
    display: grid;
    gap: 0.2rem;
    line-height: 1.5;
  }

  .lines em {
    font-style: italic;
  }

  .warning strong {
    color: var(--warning);
  }

  /* A block of steps: "Now", or what waits. The first sits under a hairline, like a card's steps. */
  .block {
    display: grid;
    gap: 0.35rem;
    padding-block-start: 0.6rem;
    border-top: 1px solid var(--rule);
  }

  .block-label {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink);
  }

  .steps {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-items: baseline;
  }

  /* Landed here from a "Go to step" jump: outlined in the action colour, so the eye finds it in the
     dark too. */
  .step:target {
    outline: 3px solid var(--action);
    outline-offset: 0.4rem;
  }

  /* What someone must know before the step, said in plain words at full strength. The step's number
     stays with the step. */
  .before {
    grid-column: 2;
    margin-block-end: 0.3rem;
    line-height: 1.5;
  }

  .n {
    font-weight: 700;
    line-height: 1.4;
  }

  .action {
    display: grid;
    gap: 0.25rem;
  }

  /* Challenge, dots, response. When the response doesn't fit, it takes its own line at the right,
     and the dots run to the end of the first. */
  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.4rem;
    line-height: 1.4;
  }

  .challenge {
    font-weight: 700;
  }

  .dots {
    flex: 1 1 2.5rem;
    min-width: 2.5rem;
    border-bottom: 2px dotted var(--ink-4);
    translate: 0 -0.3em;
  }

  .response {
    margin-inline-start: auto;
    font-weight: 700;
    color: var(--action);
    text-align: right;
    text-wrap: balance;
  }

  /* An instruction with no state to leave: set like a challenge, the thing to do first. */
  .do {
    font-weight: 700;
    line-height: 1.4;
  }

  .say,
  .if,
  .branch p {
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* The words to say, as said: bold, so they can be read out at a glance. */
  .words {
    font-weight: 700;
  }

  .note {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .choose {
    display: grid;
    gap: 0.3rem;
    margin-block-start: 0.15rem;
  }

  .choose-one {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.4;
  }

  .branches {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .branch {
    display: grid;
    grid-template-columns: 1.15rem minmax(0, 1fr);
    align-items: baseline;
  }

  .diamond {
    width: 0.45rem;
    height: 0.45rem;
    background: var(--ink);
    rotate: 45deg;
    translate: 0.05rem -0.2em;
  }

  /* A jump is something to do, so it takes the action colour. It sits in a line of text but is a
     thumb's height tall (44px), so the line it ends opens up to fit it, and two jumps never overlap. */
  .go {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--action);
    font-weight: 700;
    text-decoration-color: currentColor;
    white-space: nowrap;
  }

  /* ■ ■ ■ ■: the drill ends here. */
  .marks {
    display: inline-flex;
    gap: 0.3em;
  }

  .marks > span {
    width: 0.5em;
    height: 0.5em;
    background: var(--ink);
  }

  .stop {
    display: inline-block;
    white-space: nowrap;
  }

  .stop .marks {
    translate: 0 -0.05em;
  }

  .end {
    display: flex;
    justify-content: center;
    padding-block: 0.1rem;
  }

  .end .marks {
    gap: 0.75rem;
  }

  .end .marks > span {
    width: 0.55rem;
    height: 0.55rem;
  }

  /* Additional information: it never has to be read to do the drill. */
  .why {
    padding-block-start: 0.6rem;
    border-block-start: 1px solid var(--rule);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .why strong {
    color: var(--ink);
  }

  .ref {
    font-weight: 700;
  }

  /* System colours: the strip keeps its fill, and the light becomes a lit mark on a plain bezel.
     Everything in the strip inherits its forced-color-adjust. */
  @media (forced-colors: active) {
    .strip {
      forced-color-adjust: none;
      background: CanvasText;
      color: Canvas;
    }

    .light {
      background: Canvas;
    }

    .led,
    .ladder > span {
      background: CanvasText;
      box-shadow: none;
    }

    .legend {
      color: CanvasText;
    }

    .diamond,
    .marks > span {
      forced-color-adjust: none;
      background: CanvasText;
    }

    .step:target {
      outline-color: Highlight;
    }
  }

  @media print {
    .drill {
      break-inside: avoid;
    }

    .strip,
    .light {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
